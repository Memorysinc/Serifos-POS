<Window x:Class="FirewallControl.App.Views.ProductImageBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscador de Imágenes de Productos (buscar_imagenproductos.scx)"
        Width="1040" Height="680"
        MinWidth="840" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AtelierCardStyle}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="GALERÍA DE PRODUCTOS" Style="{StaticResource EyebrowLabelStyle}"/>
                    <TextBlock Text="Buscador y Asignación de Imágenes de Productos" Style="{StaticResource PageTitleStyle}" FontSize="20"/>
                    <TextBlock x:Name="TxtFolderPath" Text="Carpeta Reportes\Fotos" Style="{StaticResource SubtitleTextStyle}"/>
                </StackPanel>
                <Button Content="✕ Cerrar [ESC]" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SoftPanelStyle}" Padding="12,8" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Filtrar:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtSearch" Width="280" KeyDown="TxtSearch_KeyDown" Margin="0,0,10,0"/>
                <CheckBox x:Name="ChkOnlyWithPhoto" Content="Solo productos con foto" VerticalAlignment="Center" Margin="0,0,12,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
                <CheckBox x:Name="ChkOnlyWithoutPhoto" Content="Solo sin foto" VerticalAlignment="Center" Margin="0,0,12,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
                <Button Content="🔍 Buscar" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" Click="BtnSearch_Click"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="6">
                <DataGrid x:Name="GridProducts" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="0"
                          SelectionChanged="GridProducts_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="105" FontWeight="Bold"/>
                        <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                        <DataGridTextColumn Header="ARCHIVO IMAGEN" Binding="{Binding Imagen}" Width="165"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtSelectedTitle" Text="Seleccione un producto" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtSelectedFile" Text="Sin imagen asignada" Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource SoftPanelStyle}" Padding="10">
                        <Image x:Name="ImgPreview" Stretch="Uniform"/>
                    </Border>

                    <TextBox Grid.Row="2" x:Name="TxtObs" Height="64" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource InputReadOnlyBgBrush}" Margin="0,10,0,10"/>

                    <WrapPanel Grid.Row="3">
                        <Button Content="📁 Asignar / Cambiar Foto..." Style="{StaticResource PrimaryButtonStyle}"
                                Padding="14,8" Margin="0,0,8,0" Click="BtnAssignPhoto_Click"/>
                        <Button Content="🗑 Quitar Foto" Style="{StaticResource SoftDangerButtonStyle}"
                                Padding="12,8" Click="BtnRemovePhoto_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource StatusBarStyle}" Padding="14,8" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Text="Listo." FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
