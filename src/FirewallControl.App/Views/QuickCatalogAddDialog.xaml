<Window x:Class="FirewallControl.App.Views.QuickCatalogAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alta Rápida de Catálogo [+]"
        Width="470" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Border Margin="16" Style="{StaticResource AtelierCardStyle}" Padding="20">
        <StackPanel>
            <TextBlock x:Name="TxtHeader" Text="NUEVO REGISTRO" Style="{StaticResource SectionTitleStyle}" FontSize="17" Margin="0,0,0,12"/>

            <TextBlock x:Name="LblPrimary" Text="Descripción (*)" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="TxtDescripcion" FontSize="14" FontWeight="SemiBold" MaxLength="150" Margin="0,0,0,10"/>

            <!-- Solo Proveedor -->
            <StackPanel x:Name="PanelSupplierExtra" Visibility="Collapsed">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="RUC / Documento" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtRuc"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Teléfono" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtTelefono"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Dirección" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="TxtDireccion" Margin="0,0,0,10"/>
            </StackPanel>

            <!-- Solo Grupo de Productos (abm_grupoproductos.scx) -->
            <StackPanel x:Name="PanelGroupExtra" Visibility="Collapsed">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Descuento (%)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtGrupoDescuento" Text="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Impresora / Sector" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtGrupoImpresora"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Promoción Desde" Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="DpFechaInicio"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Promoción Hasta" Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="DpFechaFinal"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="💾 Guardar [ENTER]" Style="{StaticResource SuccessButtonStyle}"
                        Padding="16,8" Margin="0,0,8,0" Click="BtnSave_Click"/>
                <Button Content="Cancelar [ESC]" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,8" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
