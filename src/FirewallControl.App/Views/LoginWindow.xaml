<Window x:Class="FirewallControl.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso de Usuario"
        Width="440" Height="370"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="22">
        <Border Style="{StaticResource AtelierCardStyle}" Padding="24,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="INICIO DE SESIÓN" Style="{StaticResource EyebrowLabelStyle}"/>
                    <TextBlock Text="Acceso al Sistema" Style="{StaticResource PageTitleStyle}" FontSize="22" Margin="0,2,0,0"/>
                    <TextBlock Text="Seleccione su usuario e ingrese su clave personal."
                               Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Usuario:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <ComboBox x:Name="CmbUsuarios" Grid.Row="0" Grid.Column="1"
                              DisplayMemberPath="Cidusuario"
                              FontSize="14" FontWeight="Bold"
                              Margin="0,0,0,12"
                              SelectionChanged="CmbUsuarios_SelectionChanged"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Nombre:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="LblNombreUsuario" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource PrimaryBrush}"
                               FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Contraseña:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="TxtPassword" Grid.Row="2" Grid.Column="1" FontSize="15" KeyDown="TxtPassword_KeyDown"/>
                </Grid>

                <TextBlock x:Name="LblError" Grid.Row="2" Foreground="{DynamicResource DangerTextBrush}"
                           FontWeight="SemiBold" FontSize="12" Margin="0,10,0,10"/>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="✖ Cancelar" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,9" Margin="0,0,10,0"/>
                    <Button Content="✔ Ingresar [ENTER]" Click="BtnIngresar_Click" Style="{StaticResource PrimaryButtonStyle}"
                            Padding="18,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
