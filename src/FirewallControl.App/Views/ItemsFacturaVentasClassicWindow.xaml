<Window x:Class="FirewallControl.App.Views.ItemsFacturaVentasClassicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding ClassicHeaderTitle}"
        Icon="pack://application:,,,/Sefiros.App;component/Assets/sefiros_pos.ico"
        ShowInTaskbar="False"
        Width="574" Height="368"
        MinWidth="550" MinHeight="350"
        ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        Background="{DynamicResource PosWindowBgBrush}"
        Foreground="{DynamicResource PosTextPrimaryBrush}"
        FontFamily="Tahoma"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Sefiros.App;component/Themes/FoxPosStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="FoxCajaNumBtn" TargetType="Button" BasedOn="{StaticResource FoxClassicButtonStyle}">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource PosPanelBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: barratitulo VFP limpio (sin badges ni botones extra) -->
            <Border Grid.Row="0" Background="{DynamicResource PosTopBannerBrush}" BorderBrush="{DynamicResource PosTopBannerBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
                    <Image Source="pack://application:,,,/Sefiros.App;component/Assets/FoxIcons/fox_banner_arrow.ico"
                           Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CompanyBannerTitle}"
                               FontFamily="Trebuchet MS" FontSize="14.5" FontWeight="Bold"
                               Foreground="{DynamicResource PosTopBannerTitleBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ROW 1: PANEL DE CARGA EXACTO ITEMSFACTURAVENTAS.SCX -->
            <StackPanel Grid.Row="1" Margin="10,4,10,4">
                <!-- Hint F3 + Movimiento Rápido -->
                <Grid Margin="0,0,0,2">
                    <TextBlock Text="[Pulse [F3] para consultar productos]" Foreground="{DynamicResource PosTextPrimaryBrush}"
                               FontSize="10.5" Margin="98,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox IsChecked="{Binding IsMovimientoRapido, Mode=TwoWay}"
                              Content="Movimiento Rápido"
                              Focusable="False"
                              FontFamily="Arial" FontSize="11.5" FontWeight="Bold"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              ToolTip="Atajo F10: activa o desactiva carga inmediata con 1 unidad"/>
                </Grid>

                <!-- 3 Filas exactas de producto / cantidad / precio / kilo / total -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="98"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="98"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- Col 0: Control Panel Icon (RowSpan 2) + Presupuesto Icon (Row 2) -->
                    <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                           Source="pack://application:,,,/Sefiros.App;component/Assets/FoxIcons/fox_control_panel.ico"
                           Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource FoxIconOnlyButtonStyle}"
                            Focusable="False"
                            Command="{Binding OpenPresupuestosCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            ToolTip="Importar Presupuesto [F7]">
                        <Image Source="pack://application:,,,/Sefiros.App;component/Assets/FoxIcons/fox_presupuesto.png" Width="15" Height="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>

                    <!-- Fila 0: Producto | Codigo | Descripcion | Lupa -->
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Producto:" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtCodProducto" Grid.Row="0" Grid.Column="2" Text="{Binding CodProducto, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="TxtCodProducto_KeyDown"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding DesProducto, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FoxReadOnlyBox}" Margin="3,0,0,0"/>
                    <Button x:Name="BtnBuscarProducto" Grid.Row="0" Grid.Column="5" Style="{StaticResource FoxIconOnlyButtonStyle}"
                            Focusable="False"
                            Command="{Binding SearchCatalogCommand}" HorizontalAlignment="Left" Margin="4,0,0,0" ToolTip="Buscar producto [F3]">
                        <Image Source="pack://application:,,,/Sefiros.App;component/Assets/FoxIcons/fox_lupa.png" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>

                    <!-- Fila 1: Cantidad | CantBox | Precio de Venta: | PrecioBox | Icono Comis (P1..P7) -->
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Cantidad:" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtCantidad" Grid.Row="1" Grid.Column="2" Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Right" KeyDown="TxtCantidad_KeyDown"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Precio de Venta:" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtPrecioVenta" Grid.Row="1" Grid.Column="4" Text="{Binding PrecioVenta, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                             Foreground="{DynamicResource PosAccentBlueLabelBrush}" TextAlignment="Right"
                             ToolTip="{Binding CostoUnitario, StringFormat='Costo ref.: {0:N0} Gs.'}"
                             TextChanged="TxtPrecioVenta_TextChanged" KeyDown="TxtPrecioVenta_KeyDown"/>
                    <Button x:Name="BtnComisPriceMenu" Grid.Row="1" Grid.Column="5" Style="{StaticResource FoxIconOnlyButtonStyle}"
                            Focusable="False"
                            Click="BtnComisPriceMenu_Click" HorizontalAlignment="Left" Margin="4,0,0,0"
                            ToolTip="Cambiar Lista de Precios (P1 a P7) y ver Stock">
                        <Image Source="pack://application:,,,/Sefiros.App;component/Assets/FoxIcons/fox_comis.png" Width="14" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding StockDisponible, StringFormat='Stock Actual: {0:N2}'}" IsEnabled="False" FontWeight="Bold"/>
                                <MenuItem Header="{Binding CostoUnitario, StringFormat='Costo Referencia: {0:N0} Gs.'}" IsEnabled="False"/>
                                <Separator/>
                                <MenuItem Header="Lista 1 (P1)" Command="{Binding SelectPriceListFromMenuCommand}" CommandParameter="1"/>
                                <MenuItem Header="Lista 2 (P2)" Command="{Binding SelectPriceListFromMenuCommand}" CommandParameter="2"/>
                                <MenuItem Header="Lista 3 (P3)" Command="{Binding SelectPriceListFromMenuCommand}" CommandParameter="3"/>
                                <MenuItem Header="Lista 4 (P4)" Command="{Binding SelectPriceListFromMenuCommand}" CommandParameter="4"/>
                                <MenuItem Header="Lista 5 (P5)" Command="{Binding SelectPriceListFromMenuCommand}" CommandParameter="5"/>
                                <MenuItem Header="Lista 6 (P6)" Command="{Binding SelectPriceListFromMenuCommand}" CommandParameter="6"/>
                                <MenuItem Header="Lista 7 (P7)" Command="{Binding SelectPriceListFromMenuCommand}" CommandParameter="7"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Fila 2: Precio Kilo | KiloBox | Total: | TotalBox | Discreto menu '...' para Genes/F9/DEL/C -->
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Precio Kilo:" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtKilogramo" Grid.Row="2" Grid.Column="2" Text="{Binding Kilogramo, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                             IsEnabled="{Binding IsFraccionable}" TextAlignment="Right"
                             TextChanged="TxtKilogramo_TextChanged" KeyDown="TxtKilogramo_KeyDown"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Total:" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding LineSubtotal, StringFormat=N2}"
                             Style="{StaticResource FoxReadOnlyBox}" FontWeight="Bold" TextAlignment="Right"/>
                    <Button x:Name="BtnSelectorTools" Grid.Row="2" Grid.Column="5" Style="{StaticResource FoxIconOnlyButtonStyle}"
                            Focusable="False"
                            Content="⋯" Click="BtnSelectorTools_Click" HorizontalAlignment="Left" Margin="4,0,0,0"
                            ToolTip="Genes (A/S/D/F), Carga Rápida IA [F9], Calc [C], Borrar [DEL], Lotes/Compuesto">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="[A] Genes — Verdulería" Command="{Binding OpenGenesGroupCommand}" CommandParameter="1"/>
                                <MenuItem Header="[S] Genes — Carnicería" Command="{Binding OpenGenesGroupCommand}" CommandParameter="2"/>
                                <MenuItem Header="[D] Genes — Panadería" Command="{Binding OpenGenesGroupCommand}" CommandParameter="3"/>
                                <MenuItem Header="[F] Genes — Almacén" Command="{Binding OpenGenesGroupCommand}" CommandParameter="4"/>
                                <Separator/>
                                <MenuItem Header="⚡ Carga Rápida Productos IA [F9]" Command="{Binding OpenCargaRapidaCommand}"/>
                                <MenuItem Header="📋 Importar Presupuesto [F7]" Command="{Binding OpenPresupuestosCommand}"/>
                                <MenuItem Header="🧮 Calculadora [C]" Command="{Binding OpenCalculatorCommand}"/>
                                <MenuItem Header="🖨 Cobrar + Ticket [Z]" Click="BtnCobrarTicket_Click"/>
                                <MenuItem Header="🗑 Quitar Ítem en Grilla [DEL]" Click="BtnModoBorrado_Click"/>
                                <Separator/>
                                <MenuItem Header="🧩 Ver Receta Producto Compuesto" Command="{Binding OpenCompuestoCommand}"
                                          Visibility="{Binding IsCompuestoVisible, Converter={StaticResource BoolToVis}}"/>
                                <MenuItem Header="📅 Ver Lotes / Vencimientos" Command="{Binding OpenLotesCommand}"
                                          Visibility="{Binding IsLotesVisible, Converter={StaticResource BoolToVis}}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Garantía condicional -->
                <Border Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                        Padding="6,3" Margin="0,4,0,0" Visibility="{Binding IsWarrantyVisible, Converter={StaticResource BoolToVis}}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Garantía Inicio:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,4,0"/>
                        <DatePicker SelectedDate="{Binding FechaInicioGarantia}" Width="105" Margin="0,0,6,0"/>
                        <TextBlock Text="Días:" FontSize="10.5" Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding DiasGarantias, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,6,0"/>
                        <TextBlock Text="Fin:" FontSize="10.5" Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FechaFinGarantia, StringFormat=dd/MM/yyyy}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosAccentBlueLabelBrush}" VerticalAlignment="Center"/>
                    </WrapPanel>
                </Border>
            </StackPanel>

            <!-- ROW 2: CAJA GIGANTE DEL TOTAL ACUMULADO (#EFEFEF + Rojo 72px Bold) -->
            <Border Grid.Row="2" Background="{DynamicResource PosBigTotalBgBrush}" BorderBrush="{DynamicResource PosBigTotalBorderBrush}"
                    BorderThickness="1" Margin="10,4,10,8">
                <TextBlock Text="{Binding TotalVentaEspejo, StringFormat=N0}"
                           Foreground="{DynamicResource PosBigTotalFgBrush}"
                           FontFamily="Tahoma" FontSize="72" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- ROW 3: BOTONES CAJA 1..5 SUBRAYADOS + BOTÓN CONFIRMAR CELESTE + SALIR -->
            <Grid Grid.Row="3" Margin="10,0,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="60,0,0,0">
                    <Button Command="{Binding SwitchCajaCommand}" CommandParameter="1" Focusable="False">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FoxCajaNumBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedCaja}" Value="1"><Setter Property="Background" Value="{DynamicResource PosButtonActiveBgBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosButtonActiveBorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource PosButtonActiveFgBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="1" TextDecorations="Underline"/>
                    </Button>
                    <Button Command="{Binding SwitchCajaCommand}" CommandParameter="2" Focusable="False">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FoxCajaNumBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedCaja}" Value="2"><Setter Property="Background" Value="{DynamicResource PosButtonActiveBgBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosButtonActiveBorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource PosButtonActiveFgBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="2" TextDecorations="Underline"/>
                    </Button>
                    <Button Command="{Binding SwitchCajaCommand}" CommandParameter="3" Focusable="False">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FoxCajaNumBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedCaja}" Value="3"><Setter Property="Background" Value="{DynamicResource PosButtonActiveBgBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosButtonActiveBorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource PosButtonActiveFgBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="3" TextDecorations="Underline"/>
                    </Button>
                    <Button Command="{Binding SwitchCajaCommand}" CommandParameter="4" Focusable="False">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FoxCajaNumBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedCaja}" Value="4"><Setter Property="Background" Value="{DynamicResource PosButtonActiveBgBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosButtonActiveBorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource PosButtonActiveFgBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="4" TextDecorations="Underline"/>
                    </Button>
                    <Button Command="{Binding SwitchCajaCommand}" CommandParameter="5" Margin="0" Focusable="False">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FoxCajaNumBtn}"><Style.Triggers><DataTrigger Binding="{Binding SelectedCaja}" Value="5"><Setter Property="Background" Value="{DynamicResource PosButtonActiveBgBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosButtonActiveBorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource PosButtonActiveFgBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="5" TextDecorations="Underline"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnGrabar" Command="{Binding GrabarItemCommand}"
                            Style="{StaticResource FoxClassicButtonStyle}"
                            Background="{DynamicResource PosClassicGrabarBgBrush}"
                            BorderBrush="{DynamicResource PosClassicGrabarBorderBrush}"
                            Width="74" Height="50" Margin="0,0,4,0"
                            ToolTip="Confirmar / Agregar Ítem a Venta [Enter]"/>

                    <Button Command="{Binding LimpiarCommand}" Style="{StaticResource FoxClassicButtonStyle}"
                            Focusable="False"
                            Width="58" Height="50" ToolTip="Limpiar / Salir [ESC]">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Sefiros.App;component/Assets/FoxIcons/fox_salir_arrow.ico" Width="26" Height="26" Margin="0,0,0,1" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Salir" FontSize="10.5"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ROW 4: Mensaje de validación/error (visible SOLO cuando IsError == true para mantener altura exacta en reposo) -->
            <Border Grid.Row="4" Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="0,1,0,0" Padding="8,3" Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource DangerTextBrush}" FontSize="11" FontWeight="Bold"/>
            </Border>
        </Grid>
    </Border>
</Window>
