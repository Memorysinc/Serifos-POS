<Window x:Class="FirewallControl.App.Views.CommercialTeamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipo Comercial, Metas y Adelantos"
        Width="1160" Height="720"
        MinWidth="940" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <StackPanel>
                <TextBlock Text="EQUIPO COMERCIAL Y COMISIONES" Style="{StaticResource EyebrowLabelStyle}"/>
                <TextBlock Text="Vendedores, Supervisores, Cobradores, Metas y Recibos / Adelantos" Style="{StaticResource PageTitleStyle}" FontSize="21" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="18,12,18,10">
            <!-- TAB 0: VENDEDORES -->
            <TabItem Header="🧑‍💼  Vendedores">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="8">
                        <DataGrid x:Name="GridVendedores" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="GridVendedores_SelectionChanged" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdVendedor}" Width="50"/>
                                <DataGridTextColumn Header="NOMBRES" Binding="{Binding Nombres}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="DOC" Binding="{Binding Documento}" Width="95"/>
                                <DataGridTextColumn Header="COM %" Binding="{Binding Comision, StringFormat=N2}" Width="70"/>
                                <DataGridTextColumn Header="DTO %" Binding="{Binding Descuento, StringFormat=N2}" Width="70"/>
                                <DataGridTextColumn Header="EST" Binding="{Binding Estado}" Width="45"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Ficha de Vendedor" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <TextBlock Text="Nombres *" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtVenNombres" Margin="0,3,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Documento / C.I." Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtVenDoc" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RUC" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtVenRuc" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Teléfono" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtVenTel" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Celular" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtVenCel" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Dirección" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtVenDir" Margin="0,3,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Comisión %" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtVenComision" Text="0" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Desc. Máx %" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtVenDescuento" Text="0" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Tipo" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtVenTipo" Text="0" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="ChkVenActivo" Content="Vendedor Activo" IsChecked="True" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="Nuevo" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoVen_Click" Margin="0,0,8,0"/>
                                <Button Content="Guardar" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarVen_Click" Margin="0,0,8,0"/>
                                <Button Content="Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnEliminarVen_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 1: SUPERVISORES -->
            <TabItem Header="🛡  Supervisores">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="8">
                        <DataGrid x:Name="GridSupervisores" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="GridSupervisores_SelectionChanged" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdSupervisor}" Width="60"/>
                                <DataGridTextColumn Header="SUPERVISOR" Binding="{Binding Nombres}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Ficha de Supervisor" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <TextBlock Text="Nombre Completo *" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSupNombre" Margin="0,3,0,8"/>
                            <TextBlock Text="Documento" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSupDoc" Margin="0,3,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Teléfono" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtSupTel" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Celular" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtSupCel" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Dirección" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSupDir" Margin="0,3,0,8"/>
                            <TextBlock Text="Comisión %" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSupComision" Text="0" Margin="0,3,0,8"/>
                            <CheckBox x:Name="ChkSupActivo" Content="Activo" IsChecked="True" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="Nuevo" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoSup_Click" Margin="0,0,8,0"/>
                                <Button Content="Guardar" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarSup_Click" Margin="0,0,8,0"/>
                                <Button Content="Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnEliminarSup_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: COBRADORES -->
            <TabItem Header="💼  Cobradores">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="8">
                        <DataGrid x:Name="GridCobradores" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="GridCobradores_SelectionChanged" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdCobrador}" Width="55"/>
                                <DataGridTextColumn Header="COBRADOR" Binding="{Binding Nombres}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="DOCUMENTO" Binding="{Binding Documento}" Width="95"/>
                                <DataGridTextColumn Header="CELULAR" Binding="{Binding Celular}" Width="105"/>
                                <DataGridTextColumn Header="COM %" Binding="{Binding Comision, StringFormat=N2}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Ficha de Cobrador" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <TextBlock Text="Nombres *" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCobNombres" Margin="0,3,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Documento" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtCobDoc" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Celular" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtCobCel" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Dirección" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCobDir" Margin="0,3,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Comisión %" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtCobComision" Text="0" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Comisión Fija" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtCobFija" Text="0" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="ChkCobActivo" Content="Activo" IsChecked="True" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="Nuevo" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoCob_Click" Margin="0,0,8,0"/>
                                <Button Content="Guardar" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarCob_Click" Margin="0,0,8,0"/>
                                <Button Content="Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnEliminarCob_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: METAS Y TABLA DE METAS -->
            <TabItem Header="🎯  Metas y Tabla de Comisiones">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Metas de Ventas (abm_metas)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="GridMetas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      SelectionChanged="GridMetas_SelectionChanged" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding IdMeta}" Width="50"/>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="95"/>
                                    <DataGridTextColumn Header="DESDE" Binding="{Binding Desde, StringFormat=N0}" Width="*"/>
                                    <DataGridTextColumn Header="HASTA" Binding="{Binding Hasta, StringFormat=N0}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Fecha" Style="{StaticResource FieldLabelStyle}"/>
                                        <DatePicker x:Name="DpMetaFecha" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Desde Gs." Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtMetaDesde" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Hasta Gs." Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtMetaHasta" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="Nueva" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoMeta_Click" Margin="0,0,6,0"/>
                                    <Button Content="Guardar" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarMeta_Click" Margin="0,0,6,0"/>
                                    <Button Content="Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnEliminarMeta_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Tabla Escalonada de Metas (abm_tablametas)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="GridTablaMetas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      SelectionChanged="GridTablaMetas_SelectionChanged" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ORD" Binding="{Binding Orden}" Width="45"/>
                                    <DataGridTextColumn Header="DESDE" Binding="{Binding Desde, StringFormat=N0}" Width="95"/>
                                    <DataGridTextColumn Header="OP" Binding="{Binding Operacion}" Width="45"/>
                                    <DataGridTextColumn Header="HASTA" Binding="{Binding Hasta, StringFormat=N0}" Width="95"/>
                                    <DataGridTextColumn Header="PORC %" Binding="{Binding Porcentaje, StringFormat=N2}" Width="75"/>
                                    <DataGridTextColumn Header="MONTO FIJO" Binding="{Binding Monto, StringFormat=N0}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="0.7*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Desde" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtTmDesde" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Op" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtTmOp" Text="&gt;=" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Hasta" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtTmHasta" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="%" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtTmPorc" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="Monto" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtTmMonto" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="Nueva Fila" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoTm_Click" Margin="0,0,6,0"/>
                                    <Button Content="Guardar Tramo" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarTm_Click" Margin="0,0,6,0"/>
                                    <Button Content="Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnEliminarTm_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: ADELANTOS / RECIBOS Y COMISIONES POR PROVEEDOR -->
            <TabItem Header="💵  Adelantos/Recibos y Comisiones x Proveedor">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ADELANTOS / RECIBOS -->
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Adelantos / Recibos (crear_recibo / recibos)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="GridRecibos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="88"/>
                                    <DataGridTextColumn Header="RECIBO" Binding="{Binding Recibo}" Width="85"/>
                                    <DataGridTextColumn Header="DESTINATARIO" Binding="{Binding Destinatario}" Width="*"/>
                                    <DataGridTextColumn Header="IMPORTE" Binding="{Binding Importe, StringFormat=N0}" Width="105" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="CONCEPTO" Binding="{Binding Concepto}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.7*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nro. Recibo" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtRecNro" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Destinatario *" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtRecDest" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Importe Gs. *" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtRecImporte" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Caja" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CmbRecCaja" DisplayMemberPath="Descripcion" SelectedValuePath="IdCaja" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtRecConcepto" Grid.Column="0" ToolTip="Concepto"/>
                                    <Button Grid.Column="2" Content="+ Registrar Recibo / Adelanto" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarRecibo_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- COMISION POR PROVEEDOR -->
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Comisión por Proveedor" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="GridComProv" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      SelectionChanged="GridComProv_SelectionChanged" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding DesProveedor}" Width="*"/>
                                    <DataGridTextColumn Header="VENDEDOR" Binding="{Binding DesVendedor}" Width="125"/>
                                    <DataGridTextColumn Header="COM %" Binding="{Binding Comision, StringFormat=N2}" Width="65"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Proveedor" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbCpProveedor" DisplayMemberPath="Descripcion" SelectedValuePath="IdProveedor" Margin="0,3,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Vendedor" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CmbCpVendedor" DisplayMemberPath="Nombres" SelectedValuePath="IdVendedor" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Comisión %" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtCpComision" Text="5" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="Guardar" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarCp_Click" Margin="0,0,8,0"/>
                                    <Button Content="Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnEliminarCp_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource StatusBarStyle}">
            <TextBlock x:Name="LblStatus" Text="Listo." Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
