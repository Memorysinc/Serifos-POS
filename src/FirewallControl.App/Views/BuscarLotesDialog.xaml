<Window x:Class="FirewallControl.App.Views.BuscarLotesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Lote y Vencimiento"
        Width="700" Height="390"
        MinWidth="600" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AtelierCardStyle}" Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SUFER POS · TRAZABILIDAD DE LOTES" Style="{StaticResource EyebrowLabelStyle}"/>
                <TextBlock Text="Lotes y Vencimientos del Producto" Style="{StaticResource SectionTitleStyle}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="6" Margin="0,0,0,10">
            <DataGrid x:Name="GridLotes" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      BorderThickness="0" MouseDoubleClick="GridLotes_MouseDoubleClick" PreviewKeyDown="GridLotes_PreviewKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="105" FontWeight="Bold"/>
                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                    <DataGridTextColumn Header="LOTE" Binding="{Binding Lote}" Width="115" FontWeight="Bold"/>
                    <DataGridTextColumn Header="VENCIMIENTO" Binding="{Binding Vencimiento, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad, StringFormat=N2}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock x:Name="LblInfo" Text="Enter o doble clic sobre el lote para seleccionarlo." Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="✔ Seleccionar" Style="{StaticResource SuccessButtonStyle}" Click="BtnSelect_Click" Margin="0,0,8,0"/>
                <Button Content="Salir [ESC]" IsCancel="True" Style="{StaticResource GhostButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
