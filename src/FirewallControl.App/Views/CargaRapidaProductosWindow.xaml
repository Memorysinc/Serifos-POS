<Window x:Class="FirewallControl.App.Views.CargaRapidaProductosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carga Rápida de Productos · Files API IA"
        Icon="pack://application:,,,/Sefiros.App;component/Assets/sefiros_pos.ico"
        Width="820" Height="648"
        MinWidth="760" MinHeight="590"
        WindowStartupLocation="CenterScreen"
        Background="#F6F4EF"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="CrCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DAD4CA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="CrFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#605B54"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CrInput" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="#D6D0C6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER SUPERIOR BLANCO -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E4DFD7" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CATÁLOGO RÁPIDO · FILES API IA" Foreground="#736E66" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="Carga Rápida de Productos" Foreground="#18181B" FontSize="20" FontWeight="Bold" Margin="0,1,0,2"/>
                    <TextBlock Text="Escanea, sube facturas hasta 50 MB con Files API u oculta en 2do plano" Foreground="#6C6862" FontSize="11.5"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOcultar" Content="Ocultar [F2]" Click="BtnOcultar_Click"
                            Background="#E8F1FD" Foreground="#184E92" BorderBrush="#ACC8EE" BorderThickness="1"
                            Height="34" Padding="14,0" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"
                            ToolTip="Ocultar para vender mientras Gemini o la cola siguen en segundo plano [F2]"/>
                    <Button x:Name="BtnCerrar" Content="[ESC] Cerrar" Click="BtnCerrar_Click"
                            Background="#F4F1EB" Foreground="#2D2C29" BorderBrush="#D6D0C6" BorderThickness="1"
                            Height="34" Padding="14,0" FontWeight="SemiBold" Cursor="Hand"
                            ToolTip="Cerrar y cancelar todo el proceso actual [ESC]"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO CENTRAL -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <!-- TARJETA 1: AUTOMATIZACIÓN IA & CONFIG API -->
                <Border Style="{StaticResource CrCard}" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnAnalizarIa" Grid.Column="0" Content="Analizar Factura [F3]" Click="BtnAnalizarIa_Click"
                                    Background="#184E92" Foreground="#FFFFFF" BorderBrush="#184E92" BorderThickness="1"
                                    Height="34" Padding="14,0" FontWeight="Bold" FontSize="12" Margin="0,0,10,0" Cursor="Hand"/>

                            <Border x:Name="ShpCola" Grid.Column="1" Background="#F4F1EB" BorderBrush="#D6D0C6" BorderThickness="1"
                                    CornerRadius="15" Padding="12,5" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="LblCola" Text="COLA IA · Sin productos en espera" Foreground="#524E48" FontSize="11.5" FontWeight="Bold"/>
                            </Border>

                            <Button x:Name="BtnSaltarCola" Grid.Column="2" Content="Saltar [F4]" Click="BtnSaltarCola_Click" IsEnabled="False"
                                    Background="#FCF6E8" Foreground="#8C580C" BorderBrush="#E0C68C" BorderThickness="1"
                                    Height="34" Padding="12,0" FontWeight="Bold" FontSize="11.5" Margin="0,0,8,0" Cursor="Hand"/>

                            <Button x:Name="BtnVaciarCola" Grid.Column="3" Content="Vaciar Cola" Click="BtnVaciarCola_Click" IsEnabled="False"
                                    Background="#FDECEE" Foreground="#A82A38" BorderBrush="#EEBEC4" BorderThickness="1"
                                    Height="34" Padding="12,0" FontWeight="Bold" FontSize="11.5" Cursor="Hand"/>
                        </Grid>

                        <Separator Background="#ECE8E0" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="API KEY" Foreground="#605B54" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtApiKey" Grid.Column="1" FontFamily="Consolas" FontSize="11.5" Height="32" Padding="8,4" Margin="0,0,10,0"
                                     KeyDown="TxtApiKey_KeyDown"/>

                            <TextBlock Grid.Column="2" Text="MODELO" Foreground="#605B54" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CboApiModel" Grid.Column="3" IsEditable="True" Height="32" FontSize="12" Padding="8,4" Margin="0,0,8,0"
                                      DropDownOpened="CboApiModel_DropDownOpened" KeyDown="CboApiModel_KeyDown"/>

                            <Button x:Name="BtnActModelos" Grid.Column="4" Content="Act. Modelos" Click="BtnActModelos_Click"
                                    Background="#ECF3FC" Foreground="#184E92" BorderBrush="#B4CDEE" BorderThickness="1"
                                    Height="32" Padding="11,0" FontWeight="Bold" FontSize="11.5" Margin="0,0,6,0" Cursor="Hand"/>
                            <Button x:Name="BtnGuardarApi" Grid.Column="5" Content="Guardar API" Click="BtnGuardarApi_Click"
                                    Background="#F4F1EB" Foreground="#2D2C29" BorderBrush="#D6D0C6" BorderThickness="1"
                                    Height="32" Padding="11,0" FontWeight="Bold" FontSize="11.5" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- TARJETA 2: FICHA DE PRODUCTO -->
                <Border Style="{StaticResource CrCard}">
                    <StackPanel>
                        <!-- Cabecera modo + margen en vivo -->
                        <Border Background="#F7F5F1" BorderBrush="#E4DFD7" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="14,10">
                            <Grid>
                                <Border x:Name="ShpModo" Background="#EDEAE3" BorderBrush="#D6D0C6" BorderThickness="1" CornerRadius="14" Padding="12,4" HorizontalAlignment="Left">
                                    <TextBlock x:Name="LblModo" Text="LISTO · Esperando código de producto" Foreground="#48443F" FontSize="11.5" FontWeight="Bold"/>
                                </Border>
                                <TextBlock x:Name="LblMargen" Text="Margen: —" Foreground="#605B54" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Campos principales -->
                        <StackPanel Margin="16,14">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CÓDIGO" Style="{StaticResource CrFieldLabel}"/>
                                    <TextBox x:Name="TxtFastCod" Style="{StaticResource CrInput}" FontWeight="Bold" MaxLength="25"
                                             LostFocus="TxtFastCod_LostFocus" KeyDown="TxtFastCod_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DESCRIPCIÓN DEL PRODUCTO" Style="{StaticResource CrFieldLabel}"/>
                                    <TextBox x:Name="TxtFastDesc" Style="{StaticResource CrInput}" MaxLength="250"
                                             CharacterCasing="Upper" KeyDown="TxtFastDesc_KeyDown"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="COSTO ANTERIOR (BD)" Style="{StaticResource CrFieldLabel}"/>
                                    <TextBox x:Name="TxtFastCostoAnt" Style="{StaticResource CrInput}" Background="#F5F3EE" Foreground="#5C5852"
                                             FontWeight="Bold" TextAlignment="Right" IsReadOnly="True" IsTabStop="False" Text="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="COSTO NUEVO / ACTUAL" Style="{StaticResource CrFieldLabel}"/>
                                    <TextBox x:Name="TxtFastCosto" Style="{StaticResource CrInput}" TextAlignment="Right" Text="0"
                                             TextChanged="OnCostOrPriceChanged" LostFocus="OnCostOrPriceLostFocus" KeyDown="TxtFastCosto_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="PRECIO DE VENTA" Style="{StaticResource CrFieldLabel}"/>
                                    <TextBox x:Name="TxtFastVenta" Style="{StaticResource CrInput}" FontWeight="Bold" TextAlignment="Right" Text="0"
                                             TextChanged="OnCostOrPriceChanged" LostFocus="OnCostOrPriceLostFocus" KeyDown="TxtFastVenta_KeyDown"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.45*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FAF9F6" BorderBrush="#DED9D0" BorderThickness="1" CornerRadius="8" Height="36" Padding="12,0">
                                    <CheckBox x:Name="ChkFastFraccionable" Content="Fraccionable (por peso)" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#18181B"/>
                                </Border>
                                <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Height="36" Padding="12,0">
                                    <CheckBox x:Name="ChkFastNoControlaStock" IsChecked="True"
                                              Content="Sin controlar stock (desmarcar para controlar stock)"
                                              VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                </Border>
                            </Grid>

                            <!-- Banner comparativo costo anterior vs nuevo -->
                            <Border x:Name="ShpCompCosto" Background="#F7F5F1" BorderBrush="#DED9D0" BorderThickness="1" CornerRadius="8" Padding="12,7">
                                <TextBlock x:Name="LblCompCosto" Text="Costo anterior: — · Escanea un código o analiza factura para comparar variación"
                                           Foreground="#5C5852" FontSize="11.5" FontWeight="Bold" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>

                        <!-- Pie de tarjeta con atajos y Guardar/Abortar -->
                        <Border Background="#F7F5F1" BorderBrush="#E4DFD7" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="14,10">
                            <Grid>
                                <TextBlock Text="Atajos: [F2] Ocultar · [F3] IA · [F4] Saltar · [Enter/F8/F9] Guardar · [ESC] Salir"
                                           Foreground="#736E66" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Abortar" Click="BtnAbortar_Click"
                                            Background="#FDECEE" Foreground="#A82A38" BorderBrush="#EEBEC4" BorderThickness="1"
                                            Height="34" Padding="16,0" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"/>
                                    <Button Content="✔ Guardar [Enter]" Click="BtnGuardar_Click"
                                            Background="#1C1C1F" Foreground="#FFFFFF" BorderBrush="#1C1C1F" BorderThickness="1"
                                            Height="34" Padding="18,0" FontWeight="Bold" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- BARRA DE ESTADO INFERIOR -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E4DFD7" BorderThickness="0,1,0,0" Padding="16,8">
            <TextBlock x:Name="LblStatus" Text="Listo. Ingresa o escanea un código de producto." Foreground="#48443F" FontSize="12" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
