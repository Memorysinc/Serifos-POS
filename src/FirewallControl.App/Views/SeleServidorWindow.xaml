<Window x:Class="FirewallControl.App.Views.SeleServidorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de Servidor MySQL"
        Width="490" Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="22">
        <Border Style="{StaticResource AtelierCardStyle}" Padding="24,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="CONEXIÓN DE BASE DE DATOS" Style="{StaticResource EyebrowLabelStyle}"/>
                    <TextBlock Text="Servidor MySQL" Style="{StaticResource PageTitleStyle}" FontSize="22" Margin="0,2,0,0"/>
                    <TextBlock Text="Configuración equivalente a FireWall.Ini para terminal local o red LAN."
                               Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Host / IP:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtHost" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" FontWeight="Bold"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Puerto:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtPort" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" FontWeight="Bold"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Base de datos:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtDatabase" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" FontWeight="Bold"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Usuario MySQL:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtUser" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" FontWeight="Bold"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Contraseña:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="TxtPassword" Grid.Row="4" Grid.Column="1"/>
                </Grid>

                <TextBlock x:Name="LblStatus" Grid.Row="2" Foreground="{DynamicResource PrimaryBrush}"
                           FontWeight="SemiBold" FontSize="12" Margin="0,10,0,10"/>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="✖ Cancelar" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8" Margin="0,0,8,0"/>
                    <Button Content="🔌 Probar Conexión" Click="BtnProbar_Click" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8" Margin="0,0,8,0"/>
                    <Button Content="💾 Guardar y Conectar" Click="BtnGuardar_Click" Style="{StaticResource SuccessButtonStyle}"
                            Padding="14,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
