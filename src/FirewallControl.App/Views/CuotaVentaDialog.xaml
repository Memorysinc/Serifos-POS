<Window x:Class="FirewallControl.App.Views.CuotaVentaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generación de Cuotas y Vencimientos (abm_cuotaventa)"
        Width="780" Height="470"
        MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AtelierCardStyle}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="SUFER POS · FINANCIACIÓN Y CUOTAS" Style="{StaticResource EyebrowLabelStyle}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LblClienteTag" Text="Cliente" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="14,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Nro. Venta:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtNroVenta" Grid.Column="1" IsReadOnly="True" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Nro. Factura:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtNroFactura" Grid.Column="1" IsReadOnly="True"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Total Venta:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtTotalVenta" Grid.Column="1" IsReadOnly="True" TextAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="65"/><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Cuotas / Días:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtCuotas" Grid.Column="1" Text="3" TextAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="Días:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBox x:Name="TxtDias" Grid.Column="3" Text="30" TextAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Interés (%):" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtInteres" Grid.Column="1" Text="0" TextAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Entrega Inicial:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtEntrega" Grid.Column="1" Text="0" TextAlignment="Right" FontWeight="Bold" TextChanged="OnRecalcInputChanged"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Saldo Finan.:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtSaldo" Grid.Column="1" IsReadOnly="True" TextAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource DangerTextBrush}"/>
                    </Grid>
                    <Button Content="⚙ Generar Plan de Cuotas" Style="{StaticResource PrimaryButtonStyle}" Click="BtnGenerate_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="GridCuotas" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CUOTA" Binding="{Binding CuotaTexto}" Width="80" FontWeight="Bold"/>
                            <DataGridTextColumn Header="VENCIMIENTO" Binding="{Binding Vencimiento, StringFormat=dd/MM/yyyy}" Width="120"/>
                            <DataGridTextColumn Header="DÍAS" Binding="{Binding Dias}" Width="70"/>
                            <DataGridTextColumn Header="MONTO (Gs.)" Binding="{Binding Monto, StringFormat=N0}" Width="*" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="LblTotalCuotas" Grid.Row="1" Text="Total Cuotas: 0 Gs." FontWeight="Bold" HorizontalAlignment="Right" Margin="0,8,4,0"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="✔ F9 · Grabar Cuotas" Style="{StaticResource SuccessButtonStyle}" Padding="16,7" Margin="0,0,8,0" Click="BtnAccept_Click"/>
                <Button Content="Salir [ESC]" IsCancel="True" Style="{StaticResource GhostButtonStyle}" Padding="14,7"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
