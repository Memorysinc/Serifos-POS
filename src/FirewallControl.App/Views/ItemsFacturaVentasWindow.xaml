<Window x:Class="FirewallControl.App.Views.ItemsFacturaVentasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding HeaderStatusText}"
        Icon="pack://application:,,,/Sefiros.App;component/Assets/sefiros_pos.ico"
        ShowInTaskbar="False"
        Width="890" Height="680"
        MinWidth="680" MinHeight="500"
        WindowStartupLocation="Manual"
        Left="500" Top="30"
        Background="{DynamicResource PosWindowBgBrush}"
        Foreground="{DynamicResource PosTextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="CajaPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PosTextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosPanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource PosButtonActiveBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PosButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PosButtonFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CatBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CatBorder" Property="Background" Value="{DynamicResource PosButtonHoverBgBrush}"/>
                                <Setter TargetName="CatBorder" Property="BorderBrush" Value="{DynamicResource PosButtonActiveBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CatBorder" Property="Background" Value="{DynamicResource PosSurfaceAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource PosPanelBorderBrush}"
            BorderThickness="2"
            Background="{DynamicResource PosHeroGradientBrush}"
            Padding="14">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Selector de Cajas 1 a 5 (saltaracaja / F1..F5) e Indicador de Caja Activa -->
        <Border Grid.Row="0" Style="{StaticResource AtelierCardStyle}" Background="{DynamicResource PosCardBgBrush}" BorderBrush="{DynamicResource PosPanelBorderBrush}" Padding="12,8" Margin="0,0,0,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CAJA ACTIVA" Style="{StaticResource EyebrowLabelStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- F1 · Caja 1 -->
                    <Button Content="F1 · Caja 1" Command="{Binding SwitchCajaCommand}" CommandParameter="1" Focusable="False">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CajaPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCaja}" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource PosButtonActiveBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PosButtonActiveFgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PosButtonActiveBorderBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- F2 · Caja 2 -->
                    <Button Content="F2 · Caja 2" Command="{Binding SwitchCajaCommand}" CommandParameter="2" Focusable="False">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CajaPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCaja}" Value="2">
                                        <Setter Property="Background" Value="{DynamicResource PosButtonActiveBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PosButtonActiveFgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PosButtonActiveBorderBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- F3 · Caja 3 -->
                    <Button Content="F3 · Caja 3" Command="{Binding SwitchCajaCommand}" CommandParameter="3" Focusable="False">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CajaPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCaja}" Value="3">
                                        <Setter Property="Background" Value="{DynamicResource PosButtonActiveBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PosButtonActiveFgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PosButtonActiveBorderBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- F4 · Caja 4 -->
                    <Button Content="F4 · Caja 4" Command="{Binding SwitchCajaCommand}" CommandParameter="4" Focusable="False">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CajaPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCaja}" Value="4">
                                        <Setter Property="Background" Value="{DynamicResource PosButtonActiveBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PosButtonActiveFgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PosButtonActiveBorderBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- F5 · Caja 5 -->
                    <Button Content="F5 · Caja 5" Command="{Binding SwitchCajaCommand}" CommandParameter="5" Margin="0" Focusable="False">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CajaPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCaja}" Value="5">
                                        <Setter Property="Background" Value="{DynamicResource PosButtonActiveBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PosButtonActiveFgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PosButtonActiveBorderBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>

                <Border Grid.Column="1" Background="{DynamicResource PosSurfaceAccentBrush}" BorderBrush="{DynamicResource PosButtonActiveBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource PosAccentBlueLabelBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding SelectedCaja, StringFormat='Vinculado a Caja {0}'}" Foreground="{DynamicResource PosTextPrimaryBrush}" FontWeight="Bold" FontSize="11.5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Row 1: Categorías (Genes A/S/D/F), Catálogo [F6], Borrar [DEL] y Movimiento Rápido [F10] -->
        <Border Grid.Row="1" Style="{StaticResource FlatCardStyle}" Background="{DynamicResource PosCardBgBrush}" BorderBrush="{DynamicResource PosPanelBorderBrush}" Padding="12,8" Margin="0,0,0,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CATEGORÍAS" Style="{StaticResource EyebrowLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Button Style="{StaticResource CategoryPillButtonStyle}" Focusable="False" Command="{Binding OpenGenesGroupCommand}" CommandParameter="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#2F8F6B" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="[A] Verdulería"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CategoryPillButtonStyle}" Focusable="False" Command="{Binding OpenGenesGroupCommand}" CommandParameter="2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#B7505B" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="[S] Carnicería"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CategoryPillButtonStyle}" Focusable="False" Command="{Binding OpenGenesGroupCommand}" CommandParameter="3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#C4833D" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="[D] Panadería"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CategoryPillButtonStyle}" Focusable="False" Command="{Binding OpenGenesGroupCommand}" CommandParameter="4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#347F8F" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="[F] Almacén"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CategoryPillButtonStyle}" Focusable="False" Content="🔍 [F6] Catálogo" Command="{Binding SearchCatalogCommand}"/>

                    <Button Style="{StaticResource CategoryPillButtonStyle}" Focusable="False" Content="⚡ [F9] Carga Rápida" Command="{Binding OpenCargaRapidaCommand}"
                            ToolTip="Abrir Carga Rápida de Productos con IA [F9]"/>

                    <Button Content="🗑 [DEL] Borrar Ítem" Focusable="False" Click="BtnModoBorrado_Click" Margin="0" Padding="9,5" FontSize="11.5"
                            Style="{StaticResource SoftDangerButtonStyle}"/>
                </WrapPanel>

                <!-- Toggle Movimiento Rápido [F10] -->
                <Border Grid.Column="1" CornerRadius="10" Padding="12,6" BorderThickness="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMovimientoRapido}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <CheckBox IsChecked="{Binding IsMovimientoRapido, Mode=TwoWay}"
                              Focusable="False"
                              Content="⚡ Mov. Rápido [F10]"
                              FontWeight="Bold" FontSize="12"
                              ToolTip="Atajo F10: Activa o desactiva el modo rápido (pasa 1 unidad directo al escanear verificando el costo).">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMovimientoRapido}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </Border>
            </Grid>
        </Border>

        <!-- Row 2: Formulario Principal de Producto (Código, Lista/Stock, Descripción, Importe, Cantidad, Precio/Costo, Subtotal, Garantía) -->
        <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Background="{DynamicResource PosCardBgBrush}" BorderBrush="{DynamicResource PosPanelBorderBrush}" Padding="14,9">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 0 Izquierda: Código / Barras + Buscador -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                    <TextBlock Text="CÓDIGO DE PRODUCTO / LECTURA DE BARRAS" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCodProducto"
                                 Text="{Binding CodProducto, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15" FontWeight="Bold" Padding="10,6"
                                 BorderBrush="{DynamicResource PrimaryBrush}"
                                 BorderThickness="1.5"
                                 KeyDown="TxtCodProducto_KeyDown"/>
                        <Button x:Name="BtnBuscarProducto" Grid.Column="1" Content="🔍 Buscar [F3]" Command="{Binding SearchCatalogCommand}"
                                Focusable="False"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Buscar producto en el catálogo (F3 / F6)" Padding="12,6" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Fila 0 Derecha: Lista de Precios & Stock Disponible -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                    <TextBlock Text="LISTA DE PRECIOS Y STOCK DISPONIBLE" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" SelectedValue="{Binding SelectedPriceList}" SelectedValuePath="Tag"
                                  FontWeight="Bold" FontSize="13" Height="34" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Lista 1" Tag="1"/>
                            <ComboBoxItem Content="Lista 2" Tag="2"/>
                            <ComboBoxItem Content="Lista 3" Tag="3"/>
                            <ComboBoxItem Content="Lista 4" Tag="4"/>
                            <ComboBoxItem Content="Lista 5" Tag="5"/>
                            <ComboBoxItem Content="Lista 6" Tag="6"/>
                            <ComboBoxItem Content="Lista 7" Tag="7"/>
                        </ComboBox>
                        <Border x:Name="BorderStockActualSelector" Grid.Column="2" CornerRadius="10" BorderThickness="1" Padding="10,4" Height="34"
                                ToolTip="Stock actual disponible en el depósito seleccionado">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PosPanelBorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLoadedProduct}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStockLowOrZero}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBlock Text="Stock actual:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLoadedProduct}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStockLowOrZero}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding StockDisponible, StringFormat=N2}"
                                           FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLoadedProduct}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStockLowOrZero}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Fila 1 Completa: Descripción del Producto -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                    <TextBlock Text="DESCRIPCIÓN DEL ARTÍCULO" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DesProducto, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True"
                             FontSize="14.5" FontWeight="SemiBold" Padding="10,6"/>
                </StackPanel>

                <!-- Fila 2 Izquierda: Importe en Gs. (Peso / Balanza) -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,6">
                    <TextBlock Text="IMPORTE EN GUARANÍES (PESO / FRACCIONABLE)" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtKilogramo"
                             Text="{Binding Kilogramo, UpdateSourceTrigger=LostFocus, StringFormat=N0}"
                             IsEnabled="{Binding IsFraccionable}"
                             FontSize="14.5" FontWeight="Bold" Padding="10,6" TextAlignment="Right"
                             TextChanged="TxtKilogramo_TextChanged"
                             KeyDown="TxtKilogramo_KeyDown"/>
                </StackPanel>

                <!-- Fila 2 Derecha: Cantidad -->
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,6">
                    <TextBlock Text="CANTIDAD" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCantidad"
                             Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15" FontWeight="Bold" Padding="10,6" TextAlignment="Right"
                             KeyDown="TxtCantidad_KeyDown"/>
                </StackPanel>

                <!-- Fila 3 Izquierda: Precio Unitario y Costo -->
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,2">
                    <TextBlock Text="PRECIO UNITARIO (Gs.) Y COSTO DE REFERENCIA" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPrecioVenta" Grid.Column="0"
                                 Text="{Binding PrecioVenta, UpdateSourceTrigger=LostFocus, StringFormat=N0}"
                                 FontSize="15" FontWeight="Bold" Padding="10,6"
                                 TextAlignment="Right"
                                 TextChanged="TxtPrecioVenta_TextChanged"
                                 KeyDown="TxtPrecioVenta_KeyDown"/>
                        <Border Grid.Column="1" Style="{StaticResource SoftPanelStyle}" Padding="10,4" Margin="8,0,0,0"
                                ToolTip="Precio de Costo del Producto (para verificar utilidad)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Costo: " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CostoUnitario, StringFormat=N0}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Fila 3 Derecha: Subtotal de Línea -->
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,2">
                    <TextBlock Text="SUBTOTAL DEL ÍTEM (Gs.)" Style="{StaticResource EyebrowLabelStyle}" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5">
                        <TextBlock Text="{Binding LineSubtotal, StringFormat=N0}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}" TextAlignment="Right"/>
                    </Border>
                </StackPanel>

                <!-- Fila 4: Container Garantía (visible cuando ControlaGarantia == 1) -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarrantyVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡 GARANTÍA:" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Inicio:" Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker SelectedDate="{Binding FechaInicioGarantia}" Width="120" Margin="0,0,12,0"/>
                        <TextBlock Text="Días:" Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding DiasGarantias, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4" Margin="0,0,12,0"/>
                        <TextBlock Text="Vence:" Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding FechaFinGarantia, StringFormat=dd/MM/yyyy}" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center"/>
                    </WrapPanel>
                </Border>

                <!-- Botones contextuales discretos: Compuesto / Lotes -->
                <WrapPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="🧩 Ver Receta Compuesta" Command="{Binding OpenCompuestoCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11.5" Margin="0,0,8,0">
                        <Button.Visibility>
                            <Binding Path="IsCompuestoVisible">
                                <Binding.Converter>
                                    <BooleanToVisibilityConverter/>
                                </Binding.Converter>
                            </Binding>
                        </Button.Visibility>
                    </Button>
                    <Button Content="📅 Ver Lotes y Vencimientos" Command="{Binding OpenLotesCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11.5">
                        <Button.Visibility>
                            <Binding Path="IsLotesVisible">
                                <Binding.Converter>
                                    <BooleanToVisibilityConverter/>
                                </Binding.Converter>
                            </Binding>
                        </Button.Visibility>
                    </Button>
                </WrapPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Row 3: Total Factura Actual (Grande y centrado, sin textos adicionales) -->
        <Border Grid.Row="3" Background="{DynamicResource PosKpiTotalBgBrush}" BorderBrush="{DynamicResource PosBigTotalBorderBrush}" BorderThickness="1"
                CornerRadius="12" MinHeight="86" Padding="18,6" Margin="0,7,0,7">
            <TextBlock Text="{Binding TotalVentaEspejo, StringFormat=N0}"
                       Foreground="{DynamicResource PosKpiTotalFgBrush}"
                       FontSize="60" FontWeight="ExtraBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Row 4: Botones de Acción (Agregar, Limpiar, Cobrar + Ticket, Cobrar S/Impr) -->
        <Grid Grid.Row="4" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnGrabar" Grid.Column="0"
                    Content="✔ Agregar / Actualizar Ítem [ENTER]"
                    Command="{Binding GrabarItemCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Background="{DynamicResource PosButtonPrimaryBgBrush}"
                    Foreground="{DynamicResource PosButtonPrimaryFgBrush}"
                    BorderBrush="{DynamicResource PosButtonActiveBorderBrush}"
                    FontSize="13.5" FontWeight="Bold"
                    Padding="16,10" Margin="0,0,8,0"/>
            <Button Grid.Column="1"
                    Content="Limpiar [ESC]"
                    Focusable="False"
                    Command="{Binding LimpiarCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="14,10" Margin="0,0,8,0"/>
            <Button Grid.Column="2"
                    Content="🖨 Cobrar + Ticket [Z]"
                    Focusable="False"
                    Click="BtnCobrarTicket_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    FontWeight="Bold"
                    Padding="15,10" Margin="0,0,8,0"/>
            <Button Grid.Column="3"
                    Content="Cobrar S/Impr [X]"
                    Focusable="False"
                    Click="BtnCobrarSinTicket_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    FontWeight="SemiBold"
                    Padding="14,10"/>
        </Grid>

        <!-- Row 5: Barra de Estado y Validaciones -->
        <Border Grid.Row="5" CornerRadius="9" Padding="12,8" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PosFooterBarBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PosFooterBorderBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ValidationMessage}" FontWeight="SemiBold" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
        </Grid>
    </Border>
</Window>
