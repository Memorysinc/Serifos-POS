<Window x:Class="FirewallControl.App.Views.ReeditarReimprimirDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reeditar / Reimprimir Venta"
        Width="780" Height="510"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <TextBlock Text="HISTORIAL RÁPIDO DE VENTAS" Style="{StaticResource EyebrowLabelStyle}"/>
                <TextBlock x:Name="LblHeader" Text="🔄 Reeditar / Reimprimir Venta" Style="{StaticResource PageTitleStyle}" FontSize="20" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- NRO VENTA + ACCESOS -->
        <Border Grid.Row="1" Style="{StaticResource SoftPanelStyle}" Margin="16,12,16,8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Nro. de Venta:" Style="{StaticResource FieldLabelStyle}"
                           FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtNroVenta" Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="✔ Seleccionar [ENTER]" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnAceptar_Click" Padding="14,7" Margin="10,0,0,0"/>
                <TextBlock x:Name="LblSaleSummary" Grid.Column="3" Text="Última venta seleccionada" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- HISTORIAL RECIENTE DE VENTAS PARA SELECCIÓN RÁPIDA -->
        <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Margin="16,4,16,8" Padding="6">
            <DataGrid x:Name="GridRecentSales"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      BorderThickness="0"
                      SelectionChanged="GridRecentSales_SelectionChanged"
                      MouseDoubleClick="GridRecentSales_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NRO. VENTA" Binding="{Binding NroVenta}" Width="105" FontWeight="Bold"/>
                    <DataGridTextColumn Header="FACTURA" Binding="{Binding NroFactura}" Width="135"/>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding FechaVenta, StringFormat=dd/MM/yyyy}" Width="95"/>
                    <DataGridTextColumn Header="HORA" Binding="{Binding HoraVenta}" Width="85"/>
                    <DataGridTextColumn Header="CLIENTE" Binding="{Binding NombreCliente}" Width="*"/>
                    <DataGridTextColumn Header="TOTAL (Gs.)" Binding="{Binding TotalVenta, StringFormat=N0}" Width="125" FontWeight="Bold"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="3" Style="{StaticResource StatusBarStyle}" Padding="18,10">
            <Grid>
                <TextBlock Text="Tip: Haga doble clic en una venta de la tabla o escriba el número y presione ENTER."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="✔ Confirmar [ENTER]" Style="{StaticResource SuccessButtonStyle}"
                            Click="BtnAceptar_Click" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="✕ Cancelar [ESC]" Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCancelar_Click" Padding="14,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
