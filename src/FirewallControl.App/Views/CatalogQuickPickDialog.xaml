<Window x:Class="FirewallControl.App.Views.CatalogQuickPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Búsqueda Rápida [F3]"
        Width="620" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TxtTitle" Text="SELECCIONAR REGISTRO" Style="{StaticResource SectionTitleStyle}" FontSize="17"/>
            <TextBlock Text="Escriba parte del nombre o código y presione ENTER o doble clic para seleccionar" Style="{StaticResource SubtitleTextStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtFilter" Grid.Column="0" FontSize="14" FontWeight="SemiBold"
                     TextChanged="TxtFilter_TextChanged" KeyDown="TxtFilter_KeyDown"/>
            <Button Grid.Column="1" Content="Limpiar" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6" Margin="8,0,0,0" Click="BtnClear_Click"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Padding="4">
            <DataGrid x:Name="GridItems"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      BorderThickness="0"
                      MouseDoubleClick="GridItems_MouseDoubleClick"
                      KeyDown="GridItems_KeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID / CÓD." Binding="{Binding Id}" Width="90" FontWeight="Bold"/>
                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Nombre}" Width="*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="DETALLE" Binding="{Binding Extra}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="✔ Seleccionar [ENTER]" Style="{StaticResource SuccessButtonStyle}"
                    Padding="14,7" Margin="0,0,8,0" Click="BtnSelect_Click"/>
            <Button Content="Cancelar [ESC]" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="14,7" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
