<Window x:Class="FirewallControl.App.Views.CombinarCompuestoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Productos Compuestos / Receta (combinar)"
        Width="740" Height="480"
        MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AtelierCardStyle}" Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="RECETA DE PRODUCTO COMPUESTO (compuesto / vw_compuesto)" Style="{StaticResource EyebrowLabelStyle}"/>
                <TextBlock x:Name="LblProductoPrincipal" Text="Producto Principal" Style="{StaticResource SectionTitleStyle}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="CÓDIGO INSUMO" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtCompCodigo" KeyDown="TxtCompCodigo_KeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="DESCRIPCIÓN INSUMO" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtCompDesc" IsReadOnly="True"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="CANTIDAD" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtCompCantidad" Text="1" TextAlignment="Right" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="🔍" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnBuscarComp_Click"/>
                    <Button Content="➕ Agregar Insumo" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAddComp_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Padding="6" Margin="0,0,0,10">
            <DataGrid x:Name="GridCompuestos" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdCompuesto}" Width="60"/>
                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="120" FontWeight="Bold"/>
                    <DataGridTextColumn Header="DESCRIPCIÓN DEL COMPONENTE" Binding="{Binding DesProducto}" Width="*"/>
                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad, StringFormat=N3}" Width="105" FontWeight="Bold"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3">
            <TextBlock x:Name="LblInfo" Text="Los componentes se descuentan automáticamente al facturar el producto compuesto." Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🗑 Quitar Componente" Style="{StaticResource SoftDangerButtonStyle}" Margin="0,0,8,0" Click="BtnDeleteComp_Click"/>
                <Button Content="Cerrar [ESC]" IsCancel="True" Style="{StaticResource GhostButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
