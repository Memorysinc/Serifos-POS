                        <DataGridTextColumn Header="Función / Acción de Caja" Binding="{Binding ActionName}" Width="290"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Original" Binding="{Binding DefaultKey}" Width="115"/>
                        <DataGridTextColumn Header="Tecla Asignada" Binding="{Binding CurrentKey}" Width="140" FontWeight="Bold"/>
                    </DataGrid.Columns>
