                        <RadioButton x:Name="RbWinItemsFactura" Content="1. Selector (ITEMSFACTURAVENTAS)" IsChecked="True"
                                     FontWeight="SemiBold" Margin="0,0,18,0" Checked="RbWindowFilter_Checked"/>
