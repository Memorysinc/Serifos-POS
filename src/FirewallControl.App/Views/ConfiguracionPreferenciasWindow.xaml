                            <Button x:Name="BtnActivateSefirosTheme" Grid.Column="3" Content="✨ Activar Tema Sefiros"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="14,8" VerticalAlignment="Center"
                                    Click="BtnActivateSefirosTheme_Click"/>
                        </Grid>

                        <Separator Margin="4,2,4,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                <TextBlock Text="🌙" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Tema oscuro en todo el sistema" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtTemaOscuroAparienciaSub" Text="Desactivado" Style="{StaticResource SubtitleTextStyle}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkTemaOscuroApariencia" Grid.Column="2" Style="{StaticResource PillToggleStyle}"
                                      VerticalAlignment="Center" Checked="OnThemeDarkModeChanged" Unchecked="OnThemeDarkModeChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="2. Diseño del Punto de Venta (ABMVENTAS e ITEMSFACTURAVENTAS)" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Elige cómo se organizan las 5 cajas y el selector de ítems. El cambio es inmediato conservando los productos cargados."
                           Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="4,0,0,12"/>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="16,14" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SoftPanelStyle}" Padding="14,12">
                            <RadioButton x:Name="RbEstiloRenovado" GroupName="PosStyleGroup" Checked="OnPosStyleChanged">
                                <StackPanel Margin="6,-2,0,0">
                                    <TextBlock Text="✨ Renovado (C# Atelier)" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Ventanas en cascada visibles una detrás de otra, cuadro de Stock Actual en vivo, cabecera compacta y selector ampliado."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SoftPanelStyle}" Padding="14,12">
                            <RadioButton x:Name="RbEstiloClasico" GroupName="PosStyleGroup" Checked="OnPosStyleChanged">
                                <StackPanel Margin="6,-2,0,0">
                                    <TextBlock Text="🖥 Clásico (Visual FoxPro / Sufer POS)" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Ventanas superpuestas centradas (solo la caja activa delante), distribución Sufer POS, píldoras P1..P7 y multimoneda."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="3. Paleta de colores del POS (Moderna vs Clásica FOX)" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Preferencia independiente del diseño elegido (Clásico o Renovado) para los 7 temas Atelier tradicionales."
                           Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="4,0,0,10"/>

                <Border x:Name="BannerSefirosOverrideInfo" Visibility="Collapsed"
                        Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,12">
                    <TextBlock Text="✨ Tema Sefiros activo: la paleta oficial de Sefiros POS se aplica actualmente a todo el sistema, incluida la versión Clásica FOX de ABMVENTAS e ITEMSFACTURAVENTAS. Tu selección aquí abajo se conserva para los demás temas."
                               Foreground="{DynamicResource InfoTextBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="16,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SoftPanelStyle}" Padding="14,12">
                            <RadioButton x:Name="RbPaletaModerna" GroupName="ColorPaletteGroup" Checked="OnColorPaletteChanged">
                                <StackPanel Margin="6,-2,0,0">
                                    <TextBlock Text="🎨 Moderna (C# Atelier)" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Utiliza los colores actuales modernos de C# (paletas Atelier, claro cálido o modo oscuro)."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SoftPanelStyle}" Padding="14,12">
                            <RadioButton x:Name="RbPaletaClasicaFox" GroupName="ColorPaletteGroup" Checked="OnColorPaletteChanged">
                                <StackPanel Margin="6,-2,0,0">
                                    <TextBlock Text="🟦 Clásica FOX (Visual FoxPro / Sufer POS)" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Reproduce los tonos originales de FOX solo en ABMVENTAS e ITEMSFACTURAVENTAS cuando no está activo el Tema Sefiros."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="{DynamicResource Str_Settings_Sec_Region}" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Elige el idioma de la interfaz (ES / PT / EN) y la moneda latinoamericana base del punto de venta."
                           Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="4,0,0,10"/>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="16,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.45*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Str_Settings_Language}" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CmbIdioma"
                                      DisplayMemberPath="DisplayLabel"
                                      SelectedValuePath="Code"
                                      Margin="0,4,0,0"
                                      SelectionChanged="OnLanguageChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Str_Settings_Currency}" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CmbMonedaBase"
                                      DisplayMemberPath="DisplayLabel"
                                      SelectedValuePath="IsoCode"
                                      Margin="0,4,0,0"
                                      SelectionChanged="OnBaseCurrencyChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================================================================ -->
        <!-- PAGE 2: OPERACIÓN POS, CONTROL DE STOCK Y LÍMITES DE VENTA       -->
        <!-- ================================================================ -->
        <ScrollViewer x:Name="ViewPreferencias" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22">
            <StackPanel MaxWidth="820">
                <TextBlock Text="1. Control de inventario y stock" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Define cómo se controla y descuenta el stock durante la facturación. Los cambios se guardan al instante."
                           Style="{StaticResource SubtitleTextStyle}" Margin="4,0,0,12"/>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="10,6" Margin="0,0,0,18">
                    <StackPanel>
                        <!-- 1. No controlar stock en todos los items -->
                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="📦" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="No controlar stock en todos los ítems (Modo Libre)" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="POR DEFECTO DESACTIVADO. Si lo activas, permite vender cualquier producto aunque tenga stock 0 o negativo."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkPrefNoControlarStockGlobal" Grid.Column="2" Style="{StaticResource PillToggleStyle}"
                                          Checked="OnPreferenceToggleChanged" Unchecked="OnPreferenceToggleChanged"/>
                            </Grid>
                        </Border>

                        <Separator Margin="12,2"/>

                        <!-- 2. Descontar stock al vender -->
                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="📉" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Descontar stock en el depósito al vender" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Actualiza las existencias reales en productos_detalle tras cada venta confirmada."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkPrefDescontarStock" Grid.Column="2" Style="{StaticResource PillToggleStyle}"
                                          Checked="OnPreferenceToggleChanged" Unchecked="OnPreferenceToggleChanged"/>
                            </Grid>
                        </Border>

                        <Separator Margin="12,2"/>

                        <!-- 3. Congelar inventario en productos sin control de stock -->
                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🧊" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Congelar inventario cuando no se controla stock (evitar negativos)" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Los productos sin control de stock (incluidos los cargados desde F9) congelan su existencia sin descontar hacia valores negativos."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkPrefCongelarStockSinControl" Grid.Column="2" Style="{StaticResource PillToggleStyle}"
                                          Checked="OnPreferenceToggleChanged" Unchecked="OnPreferenceToggleChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="2. Flujo de caja y selector de ítems (ITEMSFACTURAVENTAS)" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Comportamiento de escaneo, bloqueo modal, foco automático y botonera Genes."
                           Style="{StaticResource SubtitleTextStyle}" Margin="4,0,0,12"/>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="10,6" Margin="0,0,0,18">
                    <StackPanel>
                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🔒" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Selector de Ítems en Modo Modal 1 (bloquea ventanas de atrás)" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="POR DEFECTO DESACTIVADO. Cuando está activo, impide hacer clic en ABMVENTAS o en el menú principal mientras ITEMSFACTURAVENTAS está abierto."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkPrefItemFacturaModal" Grid.Column="2" Style="{StaticResource PillToggleStyle}"
                                          Checked="OnPreferenceToggleChanged" Unchecked="OnPreferenceToggleChanged"/>
                            </Grid>
                        </Border>

                        <Separator Margin="12,2"/>

                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="⚡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Iniciar con Movimiento Rápido activado [F10]" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Al abrir el selector de ítems, el lector de códigos agrega el producto directamente con Enter o escaneo."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkPrefMovRapido" Grid.Column="2" Style="{StaticResource PillToggleStyle}"
                                          Checked="OnPreferenceToggleChanged" Unchecked="OnPreferenceToggleChanged"/>
                            </Grid>
                        </Border>

                        <Separator Margin="12,2"/>

                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🔁" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Reiniciar campo al equivocarse y devolver el foco a Código" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Si el producto no existe, falta stock o el peso es inválido, limpia y enfoca el buscador automáticamente."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkPrefReiniciarAlEquivocarse" Grid.Column="2" Style="{StaticResource PillToggleStyle}"
                                          Checked="OnPreferenceToggleChanged" Unchecked="OnPreferenceToggleChanged"/>
                            </Grid>
                        </Border>

                        <Separator Margin="12,2"/>

                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🔔" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Emitir sonido de alerta en errores de escaneo o stock" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Avisa al cajero mediante una señal sonora cuando un código no es reconocido o supera el stock."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkPrefSonidoAlerta" Grid.Column="2" Style="{StaticResource PillToggleStyle}"
                                          Checked="OnPreferenceToggleChanged" Unchecked="OnPreferenceToggleChanged"/>
                            </Grid>
                        </Border>

                        <Separator Margin="12,2"/>

                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🥕" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Sincronizar precios Genes (Verdulería/Carnicería/Panadería) al abrir" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Actualiza automáticamente los botones de pesables desde MySQL al ingresar a la pantalla Genes."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkPrefSyncGenes" Grid.Column="2" Style="{StaticResource PillToggleStyle}"
                                          Checked="OnPreferenceToggleChanged" Unchecked="OnPreferenceToggleChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="3. Validaciones y límites de precio y cantidad" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Restricciones editables de costo mínimo, rango de precio unitario y cantidad máxima por línea."
                           Style="{StaticResource SubtitleTextStyle}" Margin="4,0,0,12"/>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="10,6" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="💲" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Permitir ventas por debajo del costo medio" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Si está desactivado, bloquea precios menores al costo de compra para evitar pérdidas."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkPrefPermitirBajoCosto" Grid.Column="2" Style="{StaticResource PillToggleStyle}"
                                          Checked="OnPreferenceToggleChanged" Unchecked="OnPreferenceToggleChanged"/>
                            </Grid>
                        </Border>

                        <Separator Margin="12,2"/>

                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🛡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Validar precio mínimo y máximo en Ítem Factura" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Desactívalo si deseas permitir cualquier precio positivo (por ejemplo 3 Gs.) sin restricciones de rango."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkPrefValidarLimitesPrecio" Grid.Column="2" Style="{StaticResource PillToggleStyle}"
                                          Checked="OnPreferenceToggleChanged" Unchecked="OnPreferenceToggleChanged"/>
                            </Grid>
                        </Border>

                        <Separator Margin="12,2"/>

                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🔢" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Límite máximo de cantidad por ítem (0 = sin límite)" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Evita cargar un código de barras completo como cantidad. Coloque 0 para desactivar el tope."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBox x:Name="TxtPrefLimiteCantidad" Grid.Column="2" Text="120" FontWeight="Bold" FontSize="14"
                                         HorizontalContentAlignment="Center" VerticalAlignment="Center" LostFocus="TxtPrefLimiteCantidad_LostFocus"/>
                            </Grid>
                        </Border>

                        <Separator Margin="12,2"/>

                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="⬇" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Precio unitario mínimo permitido en Ítem Factura (Gs.)" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Valor por defecto: 99. Cámbialo a 0 (sin mínimo) o a 1 para poder ingresar precios bajos como 3."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBox x:Name="TxtPrefPrecioMinimo" Grid.Column="2" Text="99" FontWeight="Bold" FontSize="14"
                                         HorizontalContentAlignment="Center" VerticalAlignment="Center" LostFocus="TxtPrefLimiteCantidad_LostFocus"/>
                            </Grid>
                        </Border>

                        <Separator Margin="12,2"/>

                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="⬆" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
