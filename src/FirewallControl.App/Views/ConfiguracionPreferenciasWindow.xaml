                                <TextBlock x:Name="TxtAparienciaThemeName" Text="Neutro Carbón" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtAparienciaThemeDesc" Text="Paleta estándar del sistema" Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="🎨 Cambiar tema" Style="{StaticResource SecondaryButtonStyle}"
