                <TextBlock Text="1. Identidad fiscal y timbrado" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Información fiscal impresa en los tickets, comprobantes legales y encabezado comercial."
                           Style="{StaticResource SubtitleTextStyle}" Margin="4,0,0,12"/>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="22,18" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Razón social / nombre del negocio" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCfgEmpNombre" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RUC" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCfgEmpRuc" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dirección" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCfgEmpDir"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Teléfono" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCfgEmpTel"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Timbrado vigente" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCfgTimbrado" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Lista de precios activa (1..7)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCfgListaPrecios" Text="1" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="2. Operación comercial, modos y crédito" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Módulos habilitados en el tablero principal y parámetros por defecto para cuentas a plazo."
                           Style="{StaticResource SubtitleTextStyle}" Margin="4,0,0,12"/>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="22,18" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Cobro integrado en caja" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Permite procesar el cobro directamente desde la ventana de facturación sin paso externo."
                                           Style="{StaticResource SubtitleTextStyle}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkCfgCobroCaja" Grid.Column="1" Style="{StaticResource PillToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Style="{StaticResource SoftPanelStyle}" Padding="12,10" Margin="0,0,0,14">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Modos del sistema:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <CheckBox x:Name="ChkCfgComercial" Content="Comercial" IsChecked="True" Margin="0,0,16,0"/>
                                <CheckBox x:Name="ChkCfgVeterinaria" Content="Veterinaria (habilita menú y accesos)" Margin="0,0,16,0"/>
                                <CheckBox x:Name="ChkCfgRestaurant" Content="Restaurant (habilita comandas y mesas)" Margin="0"/>
                            </WrapPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="Interés Cuota (%)" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="TxtCfgInteresCuota" Text="3"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Interés Punitorio (%)" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="TxtCfgInteresPunitorio" Text="6"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Gastos Reclamos (Gs.)" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="TxtCfgReclamos" Text="25000"/></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="Hon. Judicial (%)" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="TxtCfgHonorarioJud" Text="10"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="3. Márgenes de utilidad por defecto (Utilidad 1 al 7)" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Porcentajes aplicados por defecto al calcular precios de venta sobre el costo."
                           Style="{StaticResource SubtitleTextStyle}" Margin="4,0,0,12"/>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="22,18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Util 1 (%)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCfgU1" Text="35" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Util 2 (%)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCfgU2" Text="45" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Util 3 (%)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCfgU3" Text="60" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Util 4 (%)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCfgU4" Text="80"/>
                        </StackPanel>
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Util 5 (%)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCfgU5" Text="100"/>
                        </StackPanel>
                        <StackPanel Grid.Column="10">
                            <TextBlock Text="Util 6 (%)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCfgU6" Text="120"/>
                        </StackPanel>
                        <StackPanel Grid.Column="12">
                            <TextBlock Text="Util 7 (%)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCfgU7" Text="0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <WrapPanel>
                    <Button Content="💾 Guardar Datos de Empresa y Utilidades en MySQL" Style="{StaticResource SuccessButtonStyle}"
                            Padding="18,9" Margin="0,0,10,6" Click="BtnSaveCompanyConfig_Click"/>
                    <Button Content="🏢 Gestionar Sucursales" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,9" Margin="0,0,10,6" Click="BtnOpenSucursalesCatalog_Click"/>
                    <Button Content="🧾 Gestionar Timbrados Locales" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,9" Margin="0,0,0,6" Click="BtnOpenTimbradosCatalog_Click"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ================================================================ -->
        <!-- PAGE 8: SISTEMA, LICENCIA Y RESPALDO                             -->
        <!-- ================================================================ -->
        <ScrollViewer x:Name="ViewSistemaRespaldo" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22">
            <StackPanel MaxWidth="780">
                <TextBlock Text="1. Información del sistema y licencia" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,8"/>
                <Border Style="{StaticResource AtelierCardStyle}" Padding="22,18" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="• Motor: Sefiros POS .NET 10 WPF + MVVM" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                        <TextBlock Text="• Licencia: Activación Perpetua Completa (Zero restricciones de registros)" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="SemiBold" Margin="0,2"/>
                        <TextBlock Text="• Base de Datos: MySQL Transaccional + Botonera Genes DBF" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                        <TextBlock Text="• Impresión: Motor RAW ESC/POS Compacto (1 copia por defecto)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="2. Copias de seguridad de configuración (.json)" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Respalda o restaura todas las preferencias del POS, tema, diseño y atajos personalizados."
                           Style="{StaticResource SubtitleTextStyle}" Margin="4,0,0,12"/>
                <Border Style="{StaticResource AtelierCardStyle}" Padding="22,18">
                    <WrapPanel>
                        <Button Content="⬇ Exportar Respaldo (.json)" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="16,9" Margin="0,0,10,6" Click="BtnExportBackup_Click"/>
                        <Button Content="⬆ Restaurar Respaldo (.json)" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,9" Margin="0,0,10,6" Click="BtnImportBackup_Click"/>
                        <Button x:Name="BtnFactoryReset" Content="{DynamicResource Str_Settings_FactoryReset}" Style="{StaticResource SoftDangerButtonStyle}"
                                Padding="16,9" Margin="0,0,0,6" Click="BtnFactoryReset_Click"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER BAR -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarStyle}" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblFooterStatus" Grid.Column="0"
                           Text="✓ Configuración sincronizada con preferencias locales y MySQL."
                           Foreground="{DynamicResource SuccessTextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✔ Listo y Cerrar [ESC]" Style="{StaticResource PrimaryButtonStyle}"
                        Padding="18,8" Click="BtnSaveAndClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
