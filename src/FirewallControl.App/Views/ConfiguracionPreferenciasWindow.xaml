        <!-- ================================================================ -->
        <!-- PAGE 4: IMPRESIÓN Y PERIFÉRICOS                                  -->
        <!-- ================================================================ -->
        <ScrollViewer x:Name="ViewImpresion" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22">
            <StackPanel MaxWidth="820">
                <TextBlock Text="1. Impresoras asignadas y formato" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Configura tu impresora POS (80mm / 58mm) para emitir 1 sola nota de venta compacta, con avance mínimo y corte automático."
                           Style="{StaticResource SubtitleTextStyle}" Margin="4,0,0,12"/>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="20,18" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Impresora de tickets / nota interna" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CmbPrinterTicket" IsEditable="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Impresora de factura legal" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CmbPrinterLegal" IsEditable="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Cantidad de copias por venta (Por defecto: 1)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtPrintCopias" Text="1" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="1 = Emite una única nota de venta sin duplicados innecesarios."
                                       Style="{StaticResource SubtitleTextStyle}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Líneas de avance antes del corte (0 a 8)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtPrintLineasAvance" Text="2" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Valor 2 evita desperdiciar papel dejando un margen mínimo tras el total."
                                       Style="{StaticResource SubtitleTextStyle}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="2. Comportamiento ESC/POS y periféricos" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Opciones de impresión continua directa, guillotina automática y apertura de gaveta."
                           Style="{StaticResource SubtitleTextStyle}" Margin="4,0,0,12"/>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="10,6" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Impresión directa RAW ESC/POS (Modo Rápido sin hoja A4)" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Envía comandos directos de ticket continuo para que la impresora imprima solo el largo exacto del comprobante."
                                               Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkPrintRawDirecto" Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="True"/>
                            </Grid>
                        </Border>

                        <Separator Margin="12,2"/>

                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Corte automático de papel al finalizar ticket" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Envía el comando ESC/POS de corte inmediato al concluir la impresión."
                                               Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkPrintAutoCut" Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="True"/>
                            </Grid>
                        </Border>

                        <Separator Margin="12,2"/>

                        <Border Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Abrir cajón de dinero al imprimir cobro" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Envía pulso RJ11 a la gaveta de efectivo al confirmar venta contado."
                                               Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkPrintOpenDrawer" Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="True"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button Content="💾 Guardar Configuración de Impresión" Style="{StaticResource SuccessButtonStyle}"
                            Padding="16,9" Margin="0,0,10,0" Click="BtnSavePrintSettings_Click"/>
                    <Button Content="🧾 Imprimir Ticket de Prueba Corto" Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,9" Click="BtnTestShortTicket_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ================================================================ -->
        <!-- PAGE 5: MULTICONEXIÓN ENTRE PCs Y RED LAN (Firewall.sql + Ini)   -->
        <!-- ================================================================ -->
        <ScrollViewer x:Name="ViewMulticonexion" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22">
            <StackPanel MaxWidth="820">
                <TextBlock Text="Multiconexión en Red Local (Servidor y Cajas Clientes)" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Conecta múltiples computadoras a una misma base MySQL. Todos los cambios de stock, ventas y caja se sincronizan automáticamente."
                           Style="{StaticResource SubtitleTextStyle}" Margin="4,0,0,16"/>

                <Border Style="{StaticResource SoftPanelStyle}" Padding="16,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TxtNetLocalIps" Text="📡 Dirección IP de esta PC en la red local: Detectando..."
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="En las demás PCs de tu negocio, escribe esta IP como Servidor MySQL (en lugar de localhost)."
                                       Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Soy Servidor (localhost)" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,7" VerticalAlignment="Center"
                                Click="BtnSetLocalhostServer_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="20,18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="IP o Host del servidor MySQL" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtNetHost" Text="localhost" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Puerto" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtNetPort" Text="3306" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="Base de datos" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtNetDatabase" Text="firewallcontrol" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Usuario MySQL" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtNetUser" Text="root" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Contraseña" Style="{StaticResource FieldLabelStyle}"/>
                            <PasswordBox x:Name="PwdNetPassword"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="4">
                            <TextBlock Text="N° Caja de esta PC" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtNetIdCajaLocal" Text="1" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="16,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Sincronización automática en tiempo real (Multi-PC LAN)" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Actualiza cotizaciones, stock, productos, cajas abiertas y movimientos cada 8 segundos entre terminales."
                                       Style="{StaticResource SubtitleTextStyle}"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkNetSyncRealTime" Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="True"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button Content="🔌 Probar Conexión Ahora" Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,9" Margin="0,0,10,0" Click="BtnTestNetworkConnection_Click"/>
                    <Button Content="💾 Guardar Red en FireWall.Ini y Sincronizar" Style="{StaticResource SuccessButtonStyle}"
                            Padding="16,9" Click="BtnSaveNetworkConnection_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ================================================================ -->
        <!-- PAGE 6: USUARIOS, CONTRASEÑAS Y RANGOS                           -->
        <!-- ================================================================ -->
        <Grid x:Name="ViewUsuarios" Grid.Row="1" Visibility="Collapsed" Margin="24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de Usuarios -->
            <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Usuarios registrados" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Haz clic en un usuario para editar su rango o contraseña" Style="{StaticResource SubtitleTextStyle}"/>
                        </StackPanel>
                        <Button Content="+ Nuevo Usuario" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,7" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnNewUser_Click"/>
                    </Grid>

                    <DataGrid x:Name="GridConfigUsers" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              BorderThickness="0"
                              SelectionChanged="GridConfigUsers_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Cidusuario}" Width="110" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Nombre Completo" Binding="{Binding Cdescribe}" Width="*"/>
                            <DataGridTextColumn Header="Rango" Binding="{Binding Cidgrupo}" Width="90"/>
                            <DataGridTextColumn Header="Caja" Binding="{Binding IdCaja}" Width="55"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoDisplay}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource SoftPanelStyle}" Padding="12,10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Solicitar inicio de sesión (usuario y clave) al abrir el POS:" VerticalAlignment="Center"
                                       Style="{StaticResource SubtitleTextStyle}" FontWeight="SemiBold"/>
                            <CheckBox x:Name="ChkSolicitarLoginInicio" Grid.Column="1" Style="{StaticResource PillToggleStyle}"
                                      Checked="OnPreferenceToggleChanged" Unchecked="OnPreferenceToggleChanged"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Editor de Usuario y Rango -->
            <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="20,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtUserFormTitle" Text="Ficha de usuario y permisos de rango"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Código login (ej: CAJA1)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCfgUsrLogin" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Rango / grupo" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbCfgUsrGrupo" SelectionChanged="CmbCfgUsrGrupo_SelectionChanged">
                                    <ComboBoxItem Content="ADMIN" Tag="ADMIN"/>
                                    <ComboBoxItem Content="CAJERO" Tag="CAJERO"/>
                                    <ComboBoxItem Content="VENDEDOR" Tag="VENDEDOR"/>
                                    <ComboBoxItem Content="SUPERVISOR" Tag="SUPERVISOR"/>
                                    <ComboBoxItem Content="DEPOSITO" Tag="DEPOSITO"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Nombre completo del usuario" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtCfgUsrNombre" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="85"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Contraseña (dejar vacío para mantener)" Style="{StaticResource FieldLabelStyle}"/>
                                <PasswordBox x:Name="PwdCfgUsrPass"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Caja #" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCfgUsrCaja" Text="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Depósito" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCfgUsrDeposito" Text="1"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Permisos habilitados para este rango (12 botones _FONDO)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SoftPanelStyle}" Padding="12,8" Margin="0,0,0,12">
                            <WrapPanel>
                                <CheckBox x:Name="ChkPermVenta" Content="Punto de Venta" IsChecked="True" Width="155" Margin="0,3"/>
                                <CheckBox x:Name="ChkPermCompra" Content="Compras" IsChecked="True" Width="155" Margin="0,3"/>
                                <CheckBox x:Name="ChkPermProducto" Content="Productos" IsChecked="True" Width="155" Margin="0,3"/>
                                <CheckBox x:Name="ChkPermCliente" Content="Clientes" IsChecked="True" Width="155" Margin="0,3"/>
                                <CheckBox x:Name="ChkPermProveedor" Content="Proveedores" IsChecked="True" Width="155" Margin="0,3"/>
                                <CheckBox x:Name="ChkPermCaja" Content="Mov. de Caja" IsChecked="True" Width="155" Margin="0,3"/>
                                <CheckBox x:Name="ChkPermPedido" Content="Pedidos" IsChecked="True" Width="155" Margin="0,3"/>
                                <CheckBox x:Name="ChkPermPresu" Content="Presupuestos" IsChecked="True" Width="155" Margin="0,3"/>
                                <CheckBox x:Name="ChkPermVenci" Content="Vencimientos" IsChecked="True" Width="155" Margin="0,3"/>
                                <CheckBox x:Name="ChkPermVendedor" Content="Vendedores" IsChecked="True" Width="155" Margin="0,3"/>
                                <CheckBox x:Name="ChkPermPago" Content="Pagos Prov." IsChecked="True" Width="155" Margin="0,3"/>
                                <CheckBox x:Name="ChkPermCobro" Content="Cobros Cli." IsChecked="True" Width="155" Margin="0,3"/>
                            </WrapPanel>
                        </Border>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Matriz de accesos de menú (grupos.caccesos · líneas L1–L8)" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <Button Content="Generar desde checks" Style="{StaticResource SecondaryButtonStyle}" FontSize="11"
                                    Padding="8,3" HorizontalAlignment="Right" Click="BtnBuildCaccesosFromChecks_Click"/>
                        </Grid>
                        <TextBox x:Name="TxtCfgCaccesos" Height="74" AcceptsReturn="True" FontFamily="Consolas" FontSize="11.5"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                        <WrapPanel>
                            <Button Content="💾 Guardar Usuario y Rango" Style="{StaticResource SuccessButtonStyle}"
                                    Padding="14,8" Margin="0,0,8,8" Click="BtnSaveConfigUser_Click"/>
                            <Button Content="🔓 Activar" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,8" Margin="0,0,8,8" Click="BtnActivateSelectedUser_Click"/>
                            <Button Content="🗑 Desactivar" Style="{StaticResource SoftDangerButtonStyle}"
                                    Padding="12,8" Margin="0,0,0,8" Click="BtnDeleteConfigUser_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================================================================ -->
        <!-- PAGE 7: DATOS DE EMPRESA, TIMBRADO Y UTILIDADES                  -->
        <!-- ================================================================ -->
        <ScrollViewer x:Name="ViewEmpresa" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22">
