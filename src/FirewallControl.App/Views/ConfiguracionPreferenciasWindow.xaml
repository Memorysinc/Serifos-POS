                        <RadioButton x:Name="RbWinFondo" Content="4. Menú Principal (_FONDO)"
                                     FontWeight="SemiBold" Checked="RbWindowFilter_Checked"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource SoftPanelStyle}" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblCaptureStatus" Grid.Column="0"
                               Text="Haga doble clic en cualquier fila o presione 'Capturar Nueva Tecla' para reasignar su función."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="BtnStartCapture" Grid.Column="1" Content="⌨ Capturar Nueva Tecla"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" Margin="8,0,0,0" Click="BtnStartCapture_Click"/>
                    <Button Grid.Column="2" Content="Restaurar Fila"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="8,0,0,0" Click="BtnResetSingleKey_Click"/>
                    <Button Grid.Column="3" Content="Restaurar Todas"
                            Style="{StaticResource SoftDangerButtonStyle}" Padding="12,7" Margin="8,0,0,0" Click="BtnResetAllKeys_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Padding="6">
                <DataGrid x:Name="GridShortcuts"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          BorderThickness="0"
                          MouseDoubleClick="GridShortcuts_MouseDoubleClick">
