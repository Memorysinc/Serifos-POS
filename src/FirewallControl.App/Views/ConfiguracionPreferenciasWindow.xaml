<Window x:Class="FirewallControl.App.Views.ConfiguracionPreferenciasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes y Configuración del Sistema"
        Icon="pack://application:,,,/Sefiros.App;component/Assets/sefiros_pos.ico"
        Width="1040" Height="760"
        MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR (Matches Gissel Modas Settings Header) -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnHeaderBack" Grid.Column="0" HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,7" Click="BtnHeaderBack_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="‹" FontSize="18" FontWeight="SemiBold" Margin="0,-2,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHeaderBackLabel" Text="Cerrar" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock x:Name="TxtHeaderTitle" Grid.Column="1" Text="Ajustes"
                           Style="{StaticResource PageTitleStyle}" FontSize="22"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button Grid.Column="2" HorizontalAlignment="Right" Content="👤 Cambiar Usuario"
                        Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                        Padding="12,7" Click="BtnSwitchUserQuick_Click" ToolTip="Iniciar sesión con otro usuario o rango"/>
            </Grid>
        </Border>

        <!-- ================================================================ -->
        <!-- PAGE 0: HUB PRINCIPAL DE AJUSTES (6 CATEGORÍAS EN ORDEN LÓGICO)  -->
        <!-- ================================================================ -->
        <ScrollViewer x:Name="ViewHub" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,22">
            <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">

                <!-- SESIÓN Y PERFIL ACTIVO -->
                <Border Style="{StaticResource AtelierCardStyle}" Padding="20,16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sesión activa" Style="{StaticResource EyebrowLabelStyle}"/>
                            <TextBlock x:Name="TxtHubAccountSubtitle" Text="ADMINISTRA · ADMINISTRADOR DEL SISTEMA (Rango: ADMIN)"
                                       FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource BadgePillStyle}"
                                Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                                Padding="12,5" VerticalAlignment="Center" Margin="10,0,10,0">
                            <TextBlock x:Name="TxtHubAccountBadge" Text="● Cuenta activa · ADMIN"
                                       Foreground="{DynamicResource SuccessTextBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                        </Border>
                        <Button Grid.Column="2" Content="Mi perfil ›" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6" VerticalAlignment="Center" Click="NavMiPerfil_Click"/>
                    </Grid>
                </Border>

                <!-- 1. EMPRESA Y CONFIGURACIÓN COMERCIAL -->
                <TextBlock Text="1. Empresa y operación comercial" Style="{StaticResource SectionTitleStyle}" FontSize="17" Margin="4,0,0,8"/>
                <Border Style="{StaticResource AtelierCardStyle}" Padding="8,6" Margin="0,0,0,18">
                    <StackPanel>
                        <Button Style="{StaticResource HubRowButtonStyle}" Click="NavEmpresa_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🏢" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Datos de empresa, timbrado y utilidades" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtHubEmpresaSummary" Text="Nombre comercial, RUC, timbrado vigente, lista activa y 7 niveles de utilidad" Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 2. APARIENCIA Y DISEÑO DEL POS -->
                <TextBlock Text="2. Apariencia y diseño del POS" Style="{StaticResource SectionTitleStyle}" FontSize="17" Margin="4,0,0,8"/>
                <Border Style="{StaticResource AtelierCardStyle}" Padding="8,6" Margin="0,0,0,18">
                    <StackPanel>
                        <Button Style="{StaticResource HubRowButtonStyle}" Click="NavApariencia_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="✨" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Diseño, tema Sefiros y paleta del POS" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtHubAparienciaSummary" Text="Tema visual · Diseño Renovado / Clásico FOX · Paleta Moderna / Clásica FOX" Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            </Grid>
                        </Button>

                        <Separator Margin="12,2"/>

                        <Button Style="{StaticResource HubRowButtonStyle}" Click="BtnOpenColorAtelier_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🎨" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Tema visual del sistema (8 temas · incluye Sefiros)" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Selector rápido de tema; Tema Sefiros recolorea también la versión Clásica FOX" Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
                                    <Border x:Name="SwatchCurrentTheme" Width="22" Height="22" CornerRadius="6"
                                            Background="{DynamicResource ButtonPrimaryBgBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtCurrentThemeName" Text="Neutro Carbón"
                                               FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="›" FontSize="20" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Separator Margin="12,2"/>

                        <Border Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🌙" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Tema oscuro" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtTemaOscuroSub" Text="Desactivado" Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkTemaOscuro" Grid.Column="2" Style="{StaticResource PillToggleStyle}"
                                          VerticalAlignment="Center" Margin="8,0,4,0"
                                          Checked="OnThemeDarkModeChanged" Unchecked="OnThemeDarkModeChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. PUNTO DE VENTA, STOCK Y ATAJOS -->
                <TextBlock Text="3. Punto de venta, stock y atajos" Style="{StaticResource SectionTitleStyle}" FontSize="17" Margin="4,0,0,8"/>
                <Border Style="{StaticResource AtelierCardStyle}" Padding="8,6" Margin="0,0,0,18">
                    <StackPanel>
                        <Button Style="{StaticResource HubRowButtonStyle}" Click="NavPreferencias_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🎛" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Control de stock, caja y límites de venta" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtHubPrefSummary" Text="Reglas de inventario, movimiento rápido [F10], Modal 1 y límites de cantidad/precio" Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            </Grid>
                        </Button>

                        <Separator Margin="12,2"/>

                        <Button Style="{StaticResource HubRowButtonStyle}" Click="NavAtajos_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="⌨" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Atajos de teclado del POS y ventanas" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Asigna teclas rápidas para ABMVENTAS, selector de ítems, Genes y Menú Principal" Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 4. IMPRESIÓN Y PERIFÉRICOS -->
                <TextBlock Text="4. Impresión y periféricos" Style="{StaticResource SectionTitleStyle}" FontSize="17" Margin="4,0,0,8"/>
                <Border Style="{StaticResource AtelierCardStyle}" Padding="8,6" Margin="0,0,0,18">
                    <StackPanel>
                        <Button Style="{StaticResource HubRowButtonStyle}" Click="NavImpresion_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🖨" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Impresión de tickets, facturas y cajón" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtHubPrintSummary" Text="Impresora térmica 80mm, 1 sola nota compacta, modo RAW y corte automático" Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 5. EQUIPO, RED LAN Y SEGURIDAD -->
                <TextBlock Text="5. Equipo, red LAN y seguridad" Style="{StaticResource SectionTitleStyle}" FontSize="17" Margin="4,0,0,8"/>
                <Border Style="{StaticResource AtelierCardStyle}" Padding="8,6" Margin="0,0,0,18">
                    <StackPanel>
                        <Button Style="{StaticResource HubRowButtonStyle}" Click="NavMulticonexion_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🌐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Multiconexión entre PCs y servidor MySQL" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtHubNetworkSummary" Text="Sincronización en tiempo real entre dispositivos de la red LAN (Servidor / Cliente)" Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            </Grid>
                        </Button>

                        <Separator Margin="12,2"/>

                        <Button Style="{StaticResource HubRowButtonStyle}" Click="NavUsuarios_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🔐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Usuarios, contraseñas y rangos de acceso" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Alta/baja de cajeros, claves personales y permisos de módulos (Multiusuario)" Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            </Grid>
                        </Button>

                        <Separator Margin="12,2"/>

                        <Button Style="{StaticResource HubRowButtonStyle}" Click="NavMiPerfil_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="👤" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Mi perfil y contraseña personal" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Datos de tu cuenta activa, terminal asignado y cambio de clave personal" Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 6. SISTEMA Y COPIAS DE SEGURIDAD -->
                <TextBlock Text="6. Sistema y copias de seguridad" Style="{StaticResource SectionTitleStyle}" FontSize="17" Margin="4,0,0,8"/>
                <Border Style="{StaticResource AtelierCardStyle}" Padding="8,6" Margin="0,0,0,16">
                    <StackPanel>
                        <Button Style="{StaticResource HubRowButtonStyle}" Click="NavSistemaRespaldo_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="🛡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Sistema, licencia y copias de seguridad" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Licencia perpetua, motor .NET 10, exportar y restaurar respaldo (.json)" Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================================================================ -->
        <!-- PAGE 1: MI PERFIL                                                -->
        <!-- ================================================================ -->
        <ScrollViewer x:Name="ViewMiPerfil" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22">
            <StackPanel MaxWidth="760">
                <Border Style="{StaticResource AtelierCardStyle}" Padding="22,18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="54" Height="54" CornerRadius="14" Background="{DynamicResource SurfaceAccentBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,16,0">
                            <TextBlock Text="👤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPerfilHeaderName" Text="ADMINISTRA" Style="{StaticResource SectionTitleStyle}" FontSize="19"/>
                            <Border Style="{StaticResource BadgePillStyle}" Background="{DynamicResource SurfaceAltBrush}"
                                    HorizontalAlignment="Left" Margin="0,4,0,0" Padding="10,2">
                                <TextBlock x:Name="TxtPerfilHeaderRoleBadge" Text="ADMIN" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="2" Content="🔄 Cambiar de Usuario" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" Click="BtnSwitchUserQuick_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="22,18" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Datos de la cuenta" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                            <Button Content="Administrar usuarios" Style="{StaticResource SecondaryButtonStyle}" FontSize="11.5"
                                    Padding="12,5" HorizontalAlignment="Right" Click="NavUsuarios_Click"/>
                        </Grid>

                        <Border Style="{StaticResource SoftPanelStyle}" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,12,0">
                                    <TextBlock Text="🪪" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Código de usuario (Login)" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                                    <TextBlock x:Name="TxtPerfilUsuario" Text="ADMINISTRA" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SoftPanelStyle}" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,12,0">
                                    <TextBlock Text="📝" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Nombre completo" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                                    <TextBlock x:Name="TxtPerfilNombre" Text="ADMINISTRADOR DEL SISTEMA" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SoftPanelStyle}" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,12,0">
                                    <TextBlock Text="🖥" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Sucursal, Caja y Depósito asignados" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                                    <TextBlock x:Name="TxtPerfilTerminalInfo" Text="Sucursal #1 · Caja #1 · Depósito #1" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SoftPanelStyle}" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBoxStyle}" Margin="0,0,12,0">
                                    <TextBlock Text="🛡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Rango y permisos habilitados" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                                    <TextBlock x:Name="TxtPerfilRolPermisos" Text="ADMIN (Acceso Total a Ventas, Compras, Productos, Caja, Informes y Configuración)"
                                               FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Cambiar mi contraseña -->
                <Border Style="{StaticResource AtelierCardStyle}" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="Seguridad de la cuenta" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Cambiar tu contraseña personal en MySQL (codificada con hash FoxPro SYS(2007))"
                                   Style="{StaticResource SubtitleTextStyle}" Margin="0,3,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nueva contraseña" Style="{StaticResource FieldLabelStyle}"/>
                                <PasswordBox x:Name="PwdPerfilNueva"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Confirmar contraseña" Style="{StaticResource FieldLabelStyle}"/>
                                <PasswordBox x:Name="PwdPerfilConfirmar"/>
                            </StackPanel>
                            <Button Grid.Column="4" Content="Actualizar Clave" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="16,9" Margin="0,19,0,0" Click="BtnUpdateMyPassword_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================================================================ -->
        <!-- PAGE 9: APARIENCIA, TEMA SEFIROS Y DISEÑO DEL POS                -->
        <!-- ================================================================ -->
        <ScrollViewer x:Name="ViewApariencia" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22">
            <StackPanel MaxWidth="820">
                <TextBlock Text="1. Tema visual del sistema (8 temas · incluye Tema Sefiros)" Style="{StaticResource SectionTitleStyle}" FontSize="19" Margin="4,0,0,4"/>
                <TextBlock Text="Controla el esquema cromático global de las ventanas. El Tema Sefiros usa la paleta oficial de Sefiros POS y se aplica también a la versión Clásica FOX."
                           Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="4,0,0,12"/>

                <Border Style="{StaticResource AtelierCardStyle}" Padding="16,14" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
