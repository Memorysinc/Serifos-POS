<Window x:Class="FirewallControl.App.Views.CobroContadoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobro de Venta Contado"
        Width="500" Height="455"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="20">
        <Border Style="{StaticResource AtelierCardStyle}" Padding="22,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOTAL A COBRAR -->
                <Border Grid.Row="0" Style="{StaticResource KpiAccentCardStyle}" Padding="18,12" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FACTURACIÓN CONTADO" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource KpiAccentTextBrush}" Opacity="0.75"/>
                            <TextBlock Text="TOTAL A COBRAR (Gs.)" Foreground="{DynamicResource KpiAccentTextBrush}"
                                       FontWeight="SemiBold" FontSize="13.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="LblTotalVenta" Foreground="{DynamicResource KpiAccentValueBrush}"
                                   FontWeight="Bold" FontSize="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ENTREGAS MULTI-MONEDA -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Entrega Guaraníes:" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtEntregaGuarani" Grid.Row="0" Grid.Column="1" FontSize="18" FontWeight="Bold" TextAlignment="Right"
                             Padding="10,6" Margin="0,0,0,10" Background="{DynamicResource WarningBgBrush}"
                             BorderBrush="{DynamicResource WarningBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             TextChanged="OnAmountsChanged" KeyDown="TxtEntrega_KeyDown"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Entrega Dólares (U$S):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtEntregaDolar" Grid.Row="1" Grid.Column="1" FontSize="15" FontWeight="Bold" TextAlignment="Right"
                             Padding="10,6" Margin="0,0,0,10" Text="0" TextChanged="OnAmountsChanged" KeyDown="TxtEntrega_KeyDown"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Entrega Reales (R$):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtEntregaReal" Grid.Row="2" Grid.Column="1" FontSize="15" FontWeight="Bold" TextAlignment="Right"
                             Padding="10,6" Margin="0,0,0,10" Text="0" TextChanged="OnAmountsChanged" KeyDown="TxtEntrega_KeyDown"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Entrega Pesos ($):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtEntregaPeso" Grid.Row="3" Grid.Column="1" FontSize="15" FontWeight="Bold" TextAlignment="Right"
                             Padding="10,6" Text="0" TextChanged="OnAmountsChanged" KeyDown="TxtEntrega_KeyDown"/>
                </Grid>

                <!-- VUELTO -->
                <Border Grid.Row="2" Style="{StaticResource SoftPanelStyle}" Padding="16,12" Margin="0,14,0,14">
                    <Grid>
                        <TextBlock Text="VUELTO / CAMBIO (Gs.):" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblVueltoGuarani" Text="0" Foreground="{DynamicResource SuccessTextBrush}"
                                   FontWeight="Bold" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- BOTONES -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="✖ Cancelar [ESC]" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,9" Margin="0,0,10,0"/>
                    <Button Content="✔ Confirmar Cobro [ENTER]" Click="BtnConfirmar_Click" Style="{StaticResource SuccessButtonStyle}"
                            Padding="18,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
