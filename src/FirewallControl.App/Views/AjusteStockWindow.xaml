<Window x:Class="FirewallControl.App.Views.AjusteStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajuste de Stock en Depósito (abm_ajustes)"
        Width="940" Height="640"
        MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera Ajuste -->
        <Border Grid.Row="0" Style="{StaticResource AtelierCardStyle}" Padding="16,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="NRO. AJUSTE" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtNroAjuste" IsReadOnly="True" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                    <TextBlock Text="FECHA" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker x:Name="DpFecha"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,8">
                    <TextBlock Text="DEPÓSITO" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CmbDeposito" DisplayMemberPath="Descripcion" SelectedValuePath="IdDeposito"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,8">
                    <TextBlock Text="AUTORIZADO POR" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtAutorizado" Text="ADMINISTRA"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,0">
                    <TextBlock Text="MOTIVO" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CmbMotivo">
                        <ComboBoxItem Content="CONTEO FÍSICO DE INVENTARIO" IsSelected="True"/>
                        <ComboBoxItem Content="MERMA / ROTURA / VENCIMIENTO"/>
                        <ComboBoxItem Content="SOBRANTE DE MERCADERÍA"/>
                        <ComboBoxItem Content="OTRO MOTIVO"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2">
                    <TextBlock Text="ESPECIFICAR / OBSERVACIÓN" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtEspecificar"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Entrada de producto a ajustar -->
        <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="CÓDIGO [Enter]" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtProdCodigo" FontWeight="Bold" KeyDown="TxtProdCodigo_KeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="DESCRIPCIÓN" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtProdDesc" IsReadOnly="True"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="STOCK ACTUAL" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtStockActual" IsReadOnly="True" TextAlignment="Right" FontWeight="Bold" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="STOCK CONTADO" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtStockContado" TextAlignment="Right" FontWeight="Bold" Text="0" KeyDown="TxtStockContado_KeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="🔍 [F3]" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnLookupProd_Click"/>
                    <Button Content="➕ Agregar" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAddItem_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grilla de ítems del ajuste -->
        <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Padding="6" Margin="0,0,0,10">
            <DataGrid x:Name="GridAjustes" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="115" FontWeight="Bold"/>
                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                    <DataGridTextColumn Header="STOCK ANT." Binding="{Binding StockAnterior, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="CONTADO" Binding="{Binding CantidadContada, StringFormat=N2}" Width="90" FontWeight="Bold"/>
                    <DataGridTextColumn Header="ENTRADA" Binding="{Binding Entrada, StringFormat=N2}" Width="85" Foreground="#059669" FontWeight="Bold"/>
                    <DataGridTextColumn Header="SALIDA" Binding="{Binding Salida, StringFormat=N2}" Width="85" Foreground="#B91C1C" FontWeight="Bold"/>
                    <DataGridTextColumn Header="VALOR DIF." Binding="{Binding Total, StringFormat=N0}" Width="105"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Totales -->
        <Border Grid.Row="3" Style="{StaticResource SoftPanelStyle}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sobrante (+): " FontWeight="SemiBold"/>
                    <TextBlock x:Name="LblSobrante" Text="0 Gs." Foreground="#059669" FontWeight="Bold" Margin="0,0,18,0"/>
                    <TextBlock Text="Faltante (-): " FontWeight="SemiBold"/>
                    <TextBlock x:Name="LblFaltante" Text="0 Gs." Foreground="#B91C1C" FontWeight="Bold" Margin="0,0,18,0"/>
                    <TextBlock Text="Diferencia Neta: " FontWeight="SemiBold"/>
                    <TextBlock x:Name="LblTotalDif" Text="0 Gs." FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Quitar Fila" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnRemoveItem_Click" Margin="0,0,8,0"/>
                    <Button Content="✔ F9 · Grabar Ajuste" Style="{StaticResource SuccessButtonStyle}" Click="BtnSaveAjuste_Click" Margin="0,0,8,0"/>
                    <Button Content="Salir [ESC]" IsCancel="True" Style="{StaticResource GhostButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="LblStatus" Grid.Row="4" Text="Escanee o busque un producto e ingrese el stock contado real." Style="{StaticResource SubtitleTextStyle}"/>
    </Grid>
</Window>
