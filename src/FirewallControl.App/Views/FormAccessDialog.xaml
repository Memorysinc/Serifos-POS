<Window x:Class="FirewallControl.App.Views.FormAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control de Accesos por Formulario (accesoforms)"
        Width="780" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="PERMISOS POR FORMULARIO (ADMIN)" Style="{StaticResource EyebrowLabelStyle}"/>
            <TextBlock x:Name="TxtFormTitle" Text="CREAR_PRODUCTOS" Style="{StaticResource PageTitleStyle}" FontSize="20"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SoftPanelStyle}" Padding="12,8" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Agregar / editar usuario:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbUsers" Width="210" DisplayMemberPath="Cidusuario" SelectedValuePath="Cidusuario" Margin="0,0,8,0"/>
                <Button Content="+ Agregar fila" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Click="BtnAddUserRow_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Padding="6">
            <DataGrid x:Name="GridAccess"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="USUARIO" Binding="{Binding CidUsuario}" IsReadOnly="True" Width="*" FontWeight="Bold"/>
                    <DataGridCheckBoxColumn Header="Buscar" Binding="{Binding Buscar, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                    <DataGridCheckBoxColumn Header="Nuevo" Binding="{Binding Nuevo, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                    <DataGridCheckBoxColumn Header="Editar" Binding="{Binding Editar, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                    <DataGridCheckBoxColumn Header="Eliminar" Binding="{Binding Eliminar, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                    <DataGridCheckBoxColumn Header="Imprimir" Binding="{Binding Imprimir, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" Text="Edite los permisos y presione Guardar." Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 Guardar Cambios" Style="{StaticResource SuccessButtonStyle}"
                        Padding="16,8" Margin="0,0,8,0" Click="BtnSave_Click"/>
                <Button Content="Cerrar [ESC]" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,8" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
