<Window x:Class="FirewallControl.App.Views.ItemsFacturaComprasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carga de Ítem en Factura de Compra"
        Width="880" Height="660"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FACTURA DE COMPRA" Style="{StaticResource EyebrowLabelStyle}"/>
                    <TextBlock x:Name="TxtWindowTitle" Text="📦 Carga de Ítem en Factura de Compra" Style="{StaticResource SectionTitleStyle}" FontSize="17" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource BadgePillStyle}"
                        Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                        Padding="14,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Subtotal línea: " Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSubtotalPreview" Text="0 Gs." Foreground="{DynamicResource SuccessTextBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- FORM BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
            <StackPanel>
                <!-- PRODUCTO Y DATOS DE COMPRA -->
                <Border Style="{StaticResource AtelierCardStyle}" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="125"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Código [ENTER]" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCodigo" FontSize="14" FontWeight="Bold" KeyDown="TxtCodigo_KeyDown"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="🔍 [F3]" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,6" Margin="0,19,8,0" Click="BtnSearchCatalog_Click"/>

                            <Button Grid.Column="2" Content="+ Nuevo [F5]" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="10,6" Margin="0,19,12,0" Click="BtnNewProduct_Click"/>

                            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                <TextBlock Text="Descripción del producto" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtDescripcion" IsReadOnly="True"
                                         Background="{DynamicResource InputReadOnlyBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Impuesto IVA" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbIva" SelectionChanged="CmbIva_SelectionChanged">
                                    <ComboBoxItem Content="IVA 10%" Tag="1" IsSelected="True"/>
                                    <ComboBoxItem Content="IVA 5%" Tag="2"/>
                                    <ComboBoxItem Content="EXENTA" Tag="3"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Stock actual" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtStockAnterior" IsReadOnly="True"
                                         Background="{DynamicResource InputReadOnlyBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Text="0.00" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Costo anterior" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCostoAnterior" IsReadOnly="True"
                                         Background="{DynamicResource InputReadOnlyBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Text="0" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Cantidad a ingresar (*)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCantidad" Text="1" FontSize="14" FontWeight="Bold"
                                         TextChanged="TxtCantidadOrCosto_TextChanged" KeyDown="TxtCantidad_KeyDown"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                <TextBlock Text="Costo compra unit. (*)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCostoCompra" Text="0" FontSize="14" FontWeight="Bold"
                                         TextChanged="TxtCantidadOrCosto_TextChanged" KeyDown="TxtCostoCompra_KeyDown"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Nuevo costo promedio" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCostoPromedio" IsReadOnly="True"
                                         Background="{DynamicResource InputReadOnlyBgBrush}" Foreground="{DynamicResource PrimaryBrush}" Text="0" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 7 PRECIOS + LOTE/VENCIMIENTO + GARANTIA -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.65*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- PANEL PRECIOS -->
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Precios de Venta y Márgenes" Style="{StaticResource SectionTitleStyle}" FontSize="15" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkActualizarPrecios" Content="Actualizar precios al grabar" IsChecked="True"
                                          FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Style="{StaticResource SoftPanelStyle}" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LISTA" Style="{StaticResource EyebrowLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="UTILIDAD %" Style="{StaticResource EyebrowLabelStyle}"/>
                                    <TextBlock Grid.Column="2" Text="PRECIO VENTA" Style="{StaticResource EyebrowLabelStyle}"/>
                                    <TextBlock Grid.Column="3" Text="UTIL. %" Style="{StaticResource EyebrowLabelStyle}"/>
                                    <TextBlock Grid.Column="4" Text="PRECIO" Style="{StaticResource EyebrowLabelStyle}"/>
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: P1 & P5 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Precio 1 (*):" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtP1" Grid.Row="0" Grid.Column="1" Text="35" Margin="0,3,6,3" LostFocus="TxtUtility_LostFocus" Tag="1"/>
                                <TextBox x:Name="TxtPrecio1" Grid.Row="0" Grid.Column="2" Text="0" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,3,0,3" LostFocus="TxtPrice_LostFocus" KeyDown="TxtPrecio1_KeyDown" Tag="1"/>

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Precio 5:" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtP5" Grid.Row="0" Grid.Column="5" Text="100" Margin="0,3,6,3" LostFocus="TxtUtility_LostFocus" Tag="5"/>
                                <TextBox x:Name="TxtPrecio5" Grid.Row="0" Grid.Column="6" Text="0" Margin="0,3,0,3" LostFocus="TxtPrice_LostFocus" Tag="5"/>

                                <!-- Row 1: P2 & P6 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Precio 2:" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtP2" Grid.Row="1" Grid.Column="1" Text="45" Margin="0,3,6,3" LostFocus="TxtUtility_LostFocus" Tag="2"/>
                                <TextBox x:Name="TxtPrecio2" Grid.Row="1" Grid.Column="2" Text="0" FontWeight="Bold" Margin="0,3,0,3" LostFocus="TxtPrice_LostFocus" Tag="2"/>

                                <TextBlock Grid.Row="1" Grid.Column="4" Text="Precio 6:" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtP6" Grid.Row="1" Grid.Column="5" Text="120" Margin="0,3,6,3" LostFocus="TxtUtility_LostFocus" Tag="6"/>
                                <TextBox x:Name="TxtPrecio6" Grid.Row="1" Grid.Column="6" Text="0" Margin="0,3,0,3" LostFocus="TxtPrice_LostFocus" Tag="6"/>

                                <!-- Row 2: P3 & P7 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Precio 3:" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtP3" Grid.Row="2" Grid.Column="1" Text="60" Margin="0,3,6,3" LostFocus="TxtUtility_LostFocus" Tag="3"/>
                                <TextBox x:Name="TxtPrecio3" Grid.Row="2" Grid.Column="2" Text="0" FontWeight="Bold" Margin="0,3,0,3" LostFocus="TxtPrice_LostFocus" Tag="3"/>

                                <TextBlock Grid.Row="2" Grid.Column="4" Text="Precio 7:" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtP7" Grid.Row="2" Grid.Column="5" Text="0" Margin="0,3,6,3" LostFocus="TxtUtility_LostFocus" Tag="7"/>
                                <TextBox x:Name="TxtPrecio7" Grid.Row="2" Grid.Column="6" Text="0" Margin="0,3,0,3" LostFocus="TxtPrice_LostFocus" Tag="7"/>

                                <!-- Row 3: P4 & Recalc Button -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Precio 4:" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtP4" Grid.Row="3" Grid.Column="1" Text="80" Margin="0,3,6,3" LostFocus="TxtUtility_LostFocus" Tag="4"/>
                                <TextBox x:Name="TxtPrecio4" Grid.Row="3" Grid.Column="2" Text="0" Margin="0,3,0,3" LostFocus="TxtPrice_LostFocus" Tag="4"/>

                                <Button Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="3" Content="⟳ Recalcular Precios"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" Margin="0,4,0,0" Click="BtnRecalcPrices_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PANEL VENCIMIENTO Y GARANTIA -->
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Lote, Vencimiento y Garantía" Style="{StaticResource SectionTitleStyle}" FontSize="15" Margin="0,0,0,10"/>

                            <CheckBox x:Name="ChkUsaVencimiento" Content="Registrar Lote / Fecha de Vencimiento" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Lote / serie" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtLote"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Vencimiento" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker x:Name="DpVencimiento"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,2,0,10"/>

                            <CheckBox x:Name="ChkControlaGarantia" Content="Controlar Garantía de Compra" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Días gar." Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtDiasGarantia" Text="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Inicio garantía" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker x:Name="DpInicioGarantia"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ACTION FOOTER -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarStyle}" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Listo. Escanee el producto o presione [F3] para buscar."
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="✔ Aceptar y Agregar [F4]" Style="{StaticResource SuccessButtonStyle}"
                        Padding="16,8" Margin="0,0,8,0" Click="BtnAccept_Click"/>
                <Button Grid.Column="2" Content="✕ Cancelar [ESC]" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,8" Click="BtnCancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
