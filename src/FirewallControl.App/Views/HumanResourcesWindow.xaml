<Window x:Class="FirewallControl.App.Views.HumanResourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recursos Humanos, Legajos, Salarios y Liquidaciones"
        Width="1220" Height="750"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <StackPanel>
                <TextBlock Text="PERSONALES Y RECURSOS HUMANOS" Style="{StaticResource EyebrowLabelStyle}"/>
                <TextBlock Text="Legajos, Descuentos, Salarios, Aguinaldo/Vacaciones, Parámetros y Fichas" Style="{StaticResource PageTitleStyle}" FontSize="21" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="18,12,18,10">
            <!-- TAB 0: LEGAJOS -->
            <TabItem Header="👤  Legajos de Personal">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="8">
                        <DataGrid x:Name="GridLegajos" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="GridLegajos_SelectionChanged" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdLegajo}" Width="48"/>
                                <DataGridTextColumn Header="APELLIDOS Y NOMBRES" Binding="{Binding NombreCompleto}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="DOC." Binding="{Binding Documento}" Width="90"/>
                                <DataGridTextColumn Header="CARGO" Binding="{Binding DesCargo}" Width="110"/>
                                <DataGridTextColumn Header="SALARIO" Binding="{Binding Salario, StringFormat=N0}" Width="95" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Ficha del Colaborador" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Apellidos *" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtLegApellidos"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nombres *" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtLegNombres"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.7*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tipo" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtLegTipoDoc" Text="CI"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Documento *" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtLegDoc"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Nro. IPS" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtLegIps" Text="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cargo" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CmbLegCargo" DisplayMemberPath="Descripcion" SelectedValuePath="Codigo"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Departamento" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CmbLegDepto" DisplayMemberPath="Descripcion" SelectedValuePath="Codigo"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Área" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CmbLegArea" DisplayMemberPath="Descripcion" SelectedValuePath="Codigo"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nacionalidad" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CmbLegNac" DisplayMemberPath="Descripcion" SelectedValuePath="Codigo"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Salario Gs." Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtLegSalario" Text="0" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Fecha Ingreso" Style="{StaticResource FieldLabelStyle}"/>
                                        <DatePicker x:Name="DpLegIngreso"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Nacimiento" Style="{StaticResource FieldLabelStyle}"/>
                                        <DatePicker x:Name="DpLegNac"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Teléfono" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtLegTel"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Correo" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtLegCorreo"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Dirección" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtLegDir" Margin="0,2,0,12"/>
                                <WrapPanel>
                                    <Button Content="Nuevo" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoLeg_Click" Margin="0,0,8,0"/>
                                    <Button Content="Guardar Legajo" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarLeg_Click" Margin="0,0,8,0"/>
                                    <Button Content="Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnEliminarLeg_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 1: DESCUENTOS PERSONAL -->
            <TabItem Header="➖  Descuentos al Personal">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="8">
                        <DataGrid x:Name="GridDescuentosPers" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding FechaDescuento, StringFormat=dd/MM/yyyy}" Width="88"/>
                                <DataGridTextColumn Header="COLABORADOR" Binding="{Binding Nombres}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="CONCEPTO" Binding="{Binding DesDescuento}" Width="140"/>
                                <DataGridTextColumn Header="MONTO" Binding="{Binding Monto, StringFormat=N0}" Width="95" FontWeight="Bold"/>
                                <DataGridTextColumn Header="CUOTA" Binding="{Binding Cuota}" Width="55"/>
                                <DataGridTextColumn Header="SALDO" Binding="{Binding Saldo, StringFormat=N0}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Registrar Descuento / Vale" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <TextBlock Text="Colaborador *" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CmbDpEmpleado" DisplayMemberPath="NombreCompleto" SelectedValuePath="IdLegajo" Margin="0,3,0,8"/>
                            <TextBlock Text="Tipo de Descuento *" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CmbDpTipo" DisplayMemberPath="Descripcion" SelectedValuePath="Id" Margin="0,3,0,8"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Monto Gs." Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtDpMonto" Text="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cuotas" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtDpCuota" Text="1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Fecha" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker x:Name="DpDpFecha"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="💾 Guardar Descuento Personal" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarDp_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: SALARIOS, HISTORIAL Y CALCULADORAS LABORALES -->
            <TabItem Header="💰  Salarios, Aguinaldo y Vacaciones">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.1*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="0.9*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource AtelierCardStyle}" Padding="12">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" VerticalAlignment="Center">
                                <TextBlock Text="Historial de Salarios Procesados" Style="{StaticResource SectionTitleStyle}" Margin="0,0,14,0"/>
                                <TextBlock Text="Mes:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtSalMesFilter" Width="50" Margin="0,0,8,0"/>
                                <TextBlock Text="Año:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtSalAnioFilter" Width="65" Margin="0,0,8,0"/>
                                <Button Content="🔍 Filtrar" Style="{StaticResource SecondaryButtonStyle}" Click="BtnFiltrarSalarios_Click" Padding="10,4"/>
                            </WrapPanel>
                            <DataGrid x:Name="GridSalarios" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MES/AÑO" Binding="{Binding Mes}" Width="65"/>
                                    <DataGridTextColumn Header="AÑO" Binding="{Binding Anio}" Width="55"/>
                                    <DataGridTextColumn Header="EMPLEADO" Binding="{Binding DesNombres}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="DÍAS" Binding="{Binding DiasTrabajados}" Width="50"/>
                                    <DataGridTextColumn Header="TOTAL ING." Binding="{Binding TotalIngreso, StringFormat=N0}" Width="105"/>
                                    <DataGridTextColumn Header="IPS (9%)" Binding="{Binding MontoIps, StringFormat=N0}" Width="90"/>
                                    <DataGridTextColumn Header="TOTAL EGR." Binding="{Binding TotalEgresos, StringFormat=N0}" Width="95"/>
                                    <DataGridTextColumn Header="NETO PERCIBIR" Binding="{Binding NetoPercibir, StringFormat=N0}" Width="115" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Procesar Liquidación Mensual de Salario" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Colaborador" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CmbSalEmpleado" DisplayMemberPath="NombreCompleto" SelectedValuePath="IdLegajo" SelectionChanged="CmbSalEmpleado_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Mes" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtSalMes"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Año" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtSalAnio"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Días Trab." Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtSalDias" Text="30"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Hs. Extra" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtSalHorasExtra" Text="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Bonificación" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtSalBonif" Text="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Otros Desc." Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtSalDesc" Text="0"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="Calcular / Procesar y Guardar Salario" Style="{StaticResource SuccessButtonStyle}" Click="BtnProcesarSalario_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Calculadoras Laborales (Aguinaldo / Vacaciones / Liquidación)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbCalcPreset" Grid.Column="0" SelectedIndex="0" SelectionChanged="CmbCalcPreset_SelectionChanged">
                                        <ComboBoxItem Content="Aguinaldo (Total / 12)"/>
                                        <ComboBoxItem Content="Vacaciones Causadas"/>
                                        <ComboBoxItem Content="Liquidación Final"/>
                                        <ComboBoxItem Content="Bonificación Familiar"/>
                                    </ComboBox>
                                    <TextBox x:Name="TxtCalcMesesAnio" Grid.Column="2" Text="12" ToolTip="Meses trabajados"/>
                                    <Button Grid.Column="4" Content="Calcular" Style="{StaticResource PrimaryButtonStyle}" Click="BtnCalcularLaboral_Click" Padding="12,5"/>
                                </Grid>
                                <TextBox x:Name="TxtCalcResultado" IsReadOnly="True" AcceptsReturn="True" Height="85" TextWrapping="Wrap"
                                         Background="{DynamicResource InputReadOnlyBgBrush}" FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: PARÁMETROS SALARIALES -->
            <TabItem Header="⚙  Parámetros Salariales">
                <Border Style="{StaticResource AtelierCardStyle}" Margin="16" Padding="20" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Parámetros Globales de Sueldos e IPS (abm_salariosparametros)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Salario Mínimo Legal (Gs.)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtParSalMin"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nro. Patronal IPS" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtParNroIps"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="IPS Aporte Patronal (%)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtParIpsPat"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="IPS Aporte Obrero (%)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtParIpsEmp"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bonif. Familiar (%)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtParBonif"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Límite Edad Hijos" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtParEdad"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Precio Hora Extra" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtParHoraExtra"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="💾 Guardar Parámetros Salariales" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarParametros_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB 4: FICHAS AUXILIARES RRHH -->
            <TabItem Header="🗂  Fichas Auxiliares RRHH">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tabla Auxiliar:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbHrLookupTable" Width="260" SelectedIndex="0" SelectionChanged="CmbHrLookupTable_SelectionChanged">
                                <ComboBoxItem Content="Nacionalidades" Tag="nacionalidades"/>
                                <ComboBoxItem Content="Cargos" Tag="cargos"/>
                                <ComboBoxItem Content="Departamentos" Tag="departamentos"/>
                                <ComboBoxItem Content="Áreas" Tag="areas"/>
                                <ComboBoxItem Content="Tipos de Documentos" Tag="tipodocumentos"/>
                                <ComboBoxItem Content="Tipos de Descuentos" Tag="descuentos"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="8">
                            <DataGrid x:Name="GridHrLookup" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      SelectionChanged="GridHrLookup_SelectionChanged" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="110"/>
                                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" FontWeight="SemiBold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Registro Auxiliar" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                                <TextBlock Text="Código" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtHlCodigo" Margin="0,3,0,8"/>
                                <TextBlock Text="Descripción *" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtHlDesc" Margin="0,3,0,14"/>
                                <WrapPanel>
                                    <Button Content="Nuevo" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoHl_Click" Margin="0,0,8,0"/>
                                    <Button Content="Guardar" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarHl_Click" Margin="0,0,8,0"/>
                                    <Button Content="Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnEliminarHl_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource StatusBarStyle}">
            <TextBlock x:Name="LblStatus" Text="Listo." Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
