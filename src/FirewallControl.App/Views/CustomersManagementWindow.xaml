<Window x:Class="FirewallControl.App.Views.CustomersManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Clientes y Cobros"
        Width="1160" Height="740"
        MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,14">
            <StackPanel>
                <TextBlock Text="CARTERA Y CUENTAS POR COBRAR" Style="{StaticResource EyebrowLabelStyle}"/>
                <TextBlock Text="Clientes y Cobros de Crédito" Style="{StaticResource PageTitleStyle}" FontSize="22" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="18,14,18,10">
            <!-- TAB 1: CLIENTES -->
            <TabItem Header="👤  Directorio y Ficha de Clientes">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lista -->
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearchCustomer" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,0"
                                         ToolTip="Buscar por RUC o Nombre"
                                         KeyDown="TxtSearchCustomer_KeyDown"/>
                                <Button Grid.Column="1" Content="🔍 Buscar" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnSearchCustomer_Click" Padding="14,7" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="+ Nuevo" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnNewCustomer_Click" Padding="14,7" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Content="✔ Seleccionar [ENTER]" Style="{StaticResource SuccessButtonStyle}"
                                        Click="BtnSelectCustomer_Click" Padding="14,7"/>
                            </Grid>

                            <DataGrid x:Name="GridCustomers" Grid.Row="1"
                                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="0"
                                      SelectionChanged="GridCustomers_SelectionChanged"
                                      MouseDoubleClick="GridCustomers_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding IdCliente}" Width="60"/>
                                    <DataGridTextColumn Header="RUC / C.I." Binding="{Binding Ruc}" Width="115" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="DV" Binding="{Binding Dv}" Width="45"/>
                                    <DataGridTextColumn Header="NOMBRES / RAZÓN SOCIAL" Binding="{Binding Nombres}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="115"/>
                                    <DataGridTextColumn Header="LÍNEA CRÉD. (Gs.)" Binding="{Binding LineaCredito, StringFormat=N0}" Width="125"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Ficha -->
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="Ficha de Cliente" Style="{StaticResource SectionTitleStyle}" FontSize="17" Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtRuc" Grid.Column="0" FontWeight="Bold" Margin="0,0,8,0" ToolTip="RUC o C.I."/>
                                <TextBox x:Name="TxtDv" Grid.Column="1" FontWeight="Bold" ToolTip="Dígito Verificador"/>
                            </Grid>

                            <TextBlock Text="Nombres / razón social (*)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtNombres" FontWeight="Bold" Margin="0,0,0,10"/>

                            <TextBlock Text="Dirección" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtDireccion" Margin="0,0,0,10"/>

                            <TextBlock Text="Teléfono" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtTelefono" Margin="0,0,0,10"/>

                            <TextBlock Text="Correo electrónico" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtEmail" Margin="0,0,0,10"/>

                            <TextBlock Text="Línea de crédito (Gs.)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtLineaCredito" Text="0" FontWeight="Bold" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="💾 Guardar Cliente" Style="{StaticResource SuccessButtonStyle}"
                                        Click="BtnSaveCustomer_Click" Padding="16,8" Margin="0,0,8,0"/>
                                <Button Content="🗑 Eliminar" Style="{StaticResource SoftDangerButtonStyle}"
                                        Click="BtnDeleteCustomer_Click" Padding="14,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: COBROS DE CRÉDITOS -->
            <TabItem Header="💵  Cuentas por Cobrar y Recibos">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🔄 Actualizar Pendientes" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnRefreshCollections_Click" Padding="14,7" Margin="0,0,16,0"/>
                            <TextBlock Text="Monto a abonar (Gs.):" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtMontoCobro" Width="155" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,0,10,0"/>
                            <Button Content="✔ Registrar Cobro / Abono" Style="{StaticResource SuccessButtonStyle}"
                                    Click="BtnRegisterPayment_Click" Padding="16,7"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="6">
                        <DataGrid x:Name="GridCollections"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="0"
                                  SelectionChanged="GridCollections_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID COBRO" Binding="{Binding IdCobro}" Width="80"/>
                                <DataGridTextColumn Header="VENTA #" Binding="{Binding NroVenta}" Width="85" FontWeight="Bold"/>
                                <DataGridTextColumn Header="FACTURA" Binding="{Binding NroFactura}" Width="130"/>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="95"/>
                                <DataGridTextColumn Header="CLIENTE" Binding="{Binding NombreCliente}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="MONTO (Gs.)" Binding="{Binding Cobro, StringFormat=N0}" Width="115" FontWeight="Bold"/>
                                <DataGridTextColumn Header="PAGADO (Gs.)" Binding="{Binding Entrega, StringFormat=N0}" Width="115"/>
                                <DataGridTextColumn Header="SALDO (Gs.)" Binding="{Binding Saldo, StringFormat=N0}" Width="115" FontWeight="Bold"/>
                                <DataGridTextColumn Header="FORMA" Binding="{Binding FormaCobro}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource StatusBarStyle}" Padding="20,9">
            <TextBlock x:Name="LblStatus" Text="Listo." FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
