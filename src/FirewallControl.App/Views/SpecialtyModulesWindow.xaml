<Window x:Class="FirewallControl.App.Views.SpecialtyModulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Módulos Especiales: Restaurant, Veterinaria y Entrega de Mercaderías"
        Width="1160" Height="710"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <StackPanel>
                <TextBlock Text="MÓDULOS SECTORIALES Y LOGÍSTICA" Style="{StaticResource EyebrowLabelStyle}"/>
                <TextBlock Text="Restaurant (Comandas/Mesas), Veterinaria Condicional y Entrega de Mercaderías" Style="{StaticResource PageTitleStyle}" FontSize="21" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="18,12,18,10">
            <!-- TAB 0: RESTAURANT -->
            <TabItem Header="🍽  Restaurant (Comandas / Mesas / Mozos)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="10" Margin="0,0,0,10">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LblRestMode" Text="Modo Restaurant: Verificando..." FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Text="Sector:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbRestSector" Width="170" SelectedIndex="0" Margin="0,0,10,0">
                                <ComboBoxItem Content="TODOS" Tag=""/>
                                <ComboBoxItem Content="COCINA" Tag="COCINA"/>
                                <ComboBoxItem Content="OTROS" Tag="OTROS"/>
                                <ComboBoxItem Content="CHURRASQUERIA" Tag="CHURRASQUERIA"/>
                                <ComboBoxItem Content="BARRA" Tag="BARRA"/>
                            </ComboBox>
                            <Button Content="🔄 Actualizar Comandas" Style="{StaticResource PrimaryButtonStyle}" Click="BtnRefreshRest_Click" Padding="12,5"/>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" x:Name="LblRestSub" Text="Monitor de Comandas Activas" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                                <DataGrid x:Name="GridComandas" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="VENTA" Binding="{Binding NroVenta}" Width="65"/>
                                        <DataGridTextColumn Header="MESA" Binding="{Binding Mesa}" Width="55" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="HORA" Binding="{Binding HoraVenta}" Width="75"/>
                                        <DataGridTextColumn Header="SECTOR" Binding="{Binding Sector}" Width="105"/>
                                        <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="CANT" Binding="{Binding Cantidad, StringFormat=N2}" Width="65"/>
                                        <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=N0}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Mozos / Personal de Atención (vendedor)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                                <DataGrid x:Name="GridMozos" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding IdVendedor}" Width="48"/>
                                        <DataGridTextColumn Header="NOMBRE MOZO / VENDEDOR" Binding="{Binding Nombres}" Width="*" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="CELULAR" Binding="{Binding Celular}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 1: VETERINARIA CONDICIONAL -->
            <TabItem Header="🐾  Veterinaria (Condicional)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="14" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock x:Name="LblVetHeader" Text="Módulo Veterinaria (Pacientes, Peluquería, Vacunas, Guardería, Alimentos)" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock x:Name="LblVetStatus" Text="Verificando configuración de empresa y tablas en MySQL..." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="📅 Abrir Recordatorios / Vacunas en Agenda" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnAbrirAgendaVet_Click"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="LblVetSection" Text="Sección Activa: General" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkBrush}" Margin="0,0,0,10"/>
                            <DataGrid x:Name="GridVetTables" AutoGenerateColumns="False" IsReadOnly="True" Height="220" Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÓDULO VFP" Binding="{Binding Modulo}" Width="180" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="TABLA MYSQL" Binding="{Binding Tabla}" Width="150"/>
                                    <DataGridTextColumn Header="ESTADO EN BASE DE DATOS" Binding="{Binding Estado}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="LblVetAdvice" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Nota: En esta base de datos, Veterinaria se mantiene condicionada al flag Empresa.Veterinaria para no perder compatibilidad futura. Los avisos de vacunas y peluquería pueden gestionarse inmediatamente desde Agenda."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: ENTREGA DE MERCADERÍAS -->
            <TabItem Header="🚚  Entrega de Mercaderías (abm_entrega_mercaderia)">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="10">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Ventas Recientes Pendientes de Entrega" Style="{StaticResource SectionTitleStyle}"/>
                                <Button Content="🔄" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,3" Click="BtnRefreshEntrega_Click"/>
                            </DockPanel>
                            <DataGrid x:Name="GridEntVentas" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      SelectionChanged="GridEntVentas_SelectionChanged" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NRO" Binding="{Binding NroVenta}" Width="65" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding FechaVenta, StringFormat=dd/MM/yyyy}" Width="88"/>
                                    <DataGridTextColumn Header="CLIENTE" Binding="{Binding NombreCliente}" Width="*"/>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalVenta, StringFormat=N0}" Width="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="LblEntVentaInfo" Text="Seleccione una venta para verificar la entrega" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="GridEntItems" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="105"/>
                                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad, StringFormat=N2}" Width="90" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="2">
                                <Button Content="🖨 Imprimir Comprobante de Entrega" Style="{StaticResource SecondaryButtonStyle}" Click="BtnImprimirEntrega_Click" Margin="0,0,10,0"/>
                                <Button Content="✔ Confirmar Entrega de Mercadería" Style="{StaticResource SuccessButtonStyle}" Click="BtnConfirmarEntrega_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource StatusBarStyle}">
            <TextBlock x:Name="LblStatus" Text="Listo." Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
