<Window x:Class="FirewallControl.App.Views.TrasladoDepositosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traslado entre Depósitos (crear_trasladodepositos.scx)"
        Width="1040" Height="680"
        MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AtelierCardStyle}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="MOVIMIENTO ENTRE DEPÓSITOS" Style="{StaticResource EyebrowLabelStyle}"/>
                    <TextBlock Text="Traslados de Mercaderías entre Depósitos" Style="{StaticResource PageTitleStyle}" FontSize="20"/>
                </StackPanel>
                <Button Content="✕ Cerrar [ESC]" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- NUEVO TRASLADO -->
        <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Depósito Origen (*)" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbOrigen" DisplayMemberPath="Descripcion" SelectedValuePath="IdDeposito" SelectionChanged="SelectionChanged_UpdateStock"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Depósito Destino (*)" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbDestino" DisplayMemberPath="Descripcion" SelectedValuePath="IdDeposito"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Producto (*)" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtProductoDisplay" IsReadOnly="True" Background="{DynamicResource InputReadOnlyBgBrush}" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="🔍 [F3]" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="6,0,0,0" Click="BtnPickProduct_Click"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Stock Origen" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtStockOrigen" Text="0" IsReadOnly="True" Background="{DynamicResource InputReadOnlyBgBrush}" FontWeight="Bold" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Cantidad (*)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtCantidad" Text="1" FontSize="14" FontWeight="Bold" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Autorizado por" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtAutorizado"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Observaciones" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtObservaciones"/>
                    </StackPanel>
                    <Button Grid.Column="6" Content="✔ Registrar Traslado" Style="{StaticResource SuccessButtonStyle}"
                            Padding="16,9" VerticalAlignment="Bottom" Click="BtnSaveTransfer_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- HISTORIAL DE TRASLADOS -->
        <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Historial de Traslados:" Style="{StaticResource SectionTitleStyle}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Desde:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpDesde" Width="130" Margin="0,0,10,0"/>
                    <TextBlock Text="Hasta:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpHasta" Width="130" Margin="0,0,10,0"/>
                    <Button Content="🔄 Consultar" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" Click="BtnRefresh_Click"/>
                </WrapPanel>

                <DataGrid x:Name="GridTransfers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdTrasladoDeposito}" Width="60"/>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="90"/>
                        <DataGridTextColumn Header="HORA" Binding="{Binding Hora}" Width="75"/>
                        <DataGridTextColumn Header="ORIGEN" Binding="{Binding DesDepositoOrigen}" Width="140"/>
                        <DataGridTextColumn Header="DESTINO" Binding="{Binding DesDepositoDestino}" Width="140"/>
                        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="95" FontWeight="Bold"/>
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding DesProducto}" Width="*"/>
                        <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad, StringFormat=N2}" Width="80" FontWeight="Bold"/>
                        <DataGridTextColumn Header="AUTORIZADO" Binding="{Binding Autorizado}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource StatusBarStyle}" Padding="14,8" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Text="Seleccione depósitos, producto y cantidad para trasladar." FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
