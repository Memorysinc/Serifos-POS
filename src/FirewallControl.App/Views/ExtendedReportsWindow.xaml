<Window x:Class="FirewallControl.App.Views.ExtendedReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informes Gerenciales Extendidos y Auditoría"
        Width="1180" Height="730"
        MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <StackPanel>
                <TextBlock Text="INFORMES GERENCIALES Y AUDITORÍA" Style="{StaticResource EyebrowLabelStyle}"/>
                <TextBlock Text="Rankings de Ventas, Compras, Depósitos y Log de Transacciones" Style="{StaticResource PageTitleStyle}" FontSize="21" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SoftPanelStyle}" Margin="18,12,18,8" Padding="14,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Desde:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="DpDesde" Width="130" Margin="0,0,12,0"/>
                <TextBlock Text="Hasta:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="DpHasta" Width="130" Margin="0,0,12,0"/>
                <TextBlock Text="Filtro Texto / Usuario:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtFilter" Width="180" Margin="0,0,12,0"/>
                <Button Content="🔍 Consultar Informe" Style="{StaticResource PrimaryButtonStyle}" Click="BtnConsultar_Click" Padding="14,7" Margin="0,0,10,0"/>
                <Button Content="📄 Exportar CSV" Style="{StaticResource SecondaryButtonStyle}" Click="BtnExportCsv_Click" Padding="14,7"/>
            </WrapPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="2" Margin="18,4,18,10" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="🧑‍💼  Ventas x Vendedor">
                <DataGrid x:Name="GridVendedor" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Clave}" Width="75"/>
                        <DataGridTextColumn Header="VENDEDOR" Binding="{Binding Descripcion}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="OPERACIONES" Binding="{Binding Cantidad, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="TOTAL VENDIDO" Binding="{Binding Monto1, StringFormat=N0}" Width="140" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="👥  Ventas x Cliente">
                <DataGrid x:Name="GridCliente" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RUC" Binding="{Binding Extra1}" Width="110"/>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding Descripcion}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="VENTAS" Binding="{Binding Cantidad, StringFormat=N0}" Width="90"/>
                        <DataGridTextColumn Header="TOTAL VENDIDO" Binding="{Binding Monto1, StringFormat=N0}" Width="140" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="🏬  Ventas x Depósito">
                <DataGrid x:Name="GridDeposito" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID DEP" Binding="{Binding Clave}" Width="80"/>
                        <DataGridTextColumn Header="DEPÓSITO" Binding="{Binding Descripcion}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="UNIDADES" Binding="{Binding Cantidad, StringFormat=N2}" Width="115"/>
                        <DataGridTextColumn Header="TOTAL VENDIDO" Binding="{Binding Monto1, StringFormat=N0}" Width="145" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="📦  Productos Vendidos">
                <DataGrid x:Name="GridProdVendidos" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Clave}" Width="120"/>
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Descripcion}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad, StringFormat=N2}" Width="105"/>
                        <DataGridTextColumn Header="TOTAL VENTA" Binding="{Binding Monto1, StringFormat=N0}" Width="135" FontWeight="Bold"/>
                        <DataGridTextColumn Header="COSTO ESTIM." Binding="{Binding Monto2, StringFormat=N0}" Width="125"/>
                        <DataGridTextColumn Header="UTILIDAD" Binding="{Binding Monto3, StringFormat=N0}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="🛡  Ventas x Supervisor">
                <DataGrid x:Name="GridSupervisor" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Clave}" Width="75"/>
                        <DataGridTextColumn Header="SUPERVISOR" Binding="{Binding Descripcion}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="VENTAS" Binding="{Binding Cantidad, StringFormat=N0}" Width="105"/>
                        <DataGridTextColumn Header="TOTAL VENDIDO" Binding="{Binding Monto1, StringFormat=N0}" Width="145" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="🚚  Compras x Proveedor y Productos Comprados">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Compras Agrupadas por Proveedor" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                            <DataGrid x:Name="GridComprasProv" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding Descripcion}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="FACTURAS" Binding="{Binding Cantidad, StringFormat=N0}" Width="80"/>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding Monto1, StringFormat=N0}" Width="115" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Productos Comprados en el Período" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                            <DataGrid x:Name="GridProdComprados" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Clave}" Width="105"/>
                                    <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Descripcion}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad, StringFormat=N2}" Width="85"/>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding Monto1, StringFormat=N0}" Width="115" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="🔍  Auditoría (tbl_tranusu)">
                <DataGrid x:Name="GridAudit" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdTranUsu}" Width="65"/>
                        <DataGridTextColumn Header="FECHA/HORA" Binding="{Binding FechaTran, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="USUARIO" Binding="{Binding UserIdTran}" Width="110" FontWeight="Bold"/>
                        <DataGridTextColumn Header="FORMULARIO" Binding="{Binding FormTran}" Width="140"/>
                        <DataGridTextColumn Header="TABLA" Binding="{Binding TablaTran}" Width="120"/>
                        <DataGridTextColumn Header="TIPO" Binding="{Binding TipoTran}" Width="85"/>
                        <DataGridTextColumn Header="DETALLE / SQL" Binding="{Binding SqlTran}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Style="{StaticResource StatusBarStyle}">
            <Grid>
                <TextBlock x:Name="LblStatus" Text="Seleccione un período y presione Consultar." Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="LblTotalFooter" Text="Total período: 0 Gs." HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
