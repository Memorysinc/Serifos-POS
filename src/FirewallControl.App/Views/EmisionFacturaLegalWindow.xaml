<Window x:Class="FirewallControl.App.Views.EmisionFacturaLegalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emisión de Factura Legal (Timbrado)"
        Width="860" Height="640"
        MinWidth="740" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AtelierCardStyle}" Padding="16,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="FACTURACIÓN LEGAL · TIMBRADO" Style="{StaticResource EyebrowLabelStyle}"/>
                <TextBlock Text="Emisión de Factura Legal y Registro en factura_legal" Style="{StaticResource PageTitleStyle}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="16,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Establ. (N1)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtN1" Text="1" FontWeight="Bold" TextAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Punto (N2)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtN2" Text="1" FontWeight="Bold" TextAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Número (N3)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtN3" Text="1" FontWeight="Bold" TextAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Timbrado" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtTimbrado" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Cliente / RUC" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtClienteInfo" IsReadOnly="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="VISTA PREVIA DEL COMPROBANTE LEGAL" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtPreview" Grid.Row="1" FontFamily="Consolas" FontSize="12.5"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                         TextWrapping="NoWrap" VerticalContentAlignment="Top"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <CheckBox x:Name="ChkAvanzarNumeracion" Content="Avanzar numeración correlativa en TimbradoLocal" IsChecked="True" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🔄 Actualizar Vista" Style="{StaticResource SecondaryButtonStyle}" Click="BtnRefreshPreview_Click" Margin="0,0,8,0"/>
                <Button Content="🖨 Registrar e Imprimir Factura Legal" Style="{StaticResource SuccessButtonStyle}" Click="BtnPrintLegal_Click" Margin="0,0,8,0"/>
                <Button Content="Cerrar [ESC]" IsCancel="True" Style="{StaticResource GhostButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
