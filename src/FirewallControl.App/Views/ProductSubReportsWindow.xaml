<Window x:Class="FirewallControl.App.Views.ProductSubReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informes y Consultas de Productos (Info. Precios / Stock x Depósito / Vencimientos)"
        Width="1240" Height="780"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="SUB-INFORMES Y CONSULTAS DE INVENTARIO" Style="{StaticResource EyebrowLabelStyle}"/>
                    <TextBlock Text="Listas de Precios, Stock por Depósitos, Vencimientos y Visor Solo-Lectura" Style="{StaticResource PageTitleStyle}" FontSize="20"/>
                </StackPanel>
                <Button Content="✕ Cerrar [ESC]" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <TabControl x:Name="SubReportTabs" Grid.Row="1" Margin="16,12,16,8">

            <!-- TAB 0: INFORME LISTA DE PRECIOS -->
            <TabItem Header="💲  Info. Precios (informe_listaprecios)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="12" Margin="0,0,0,8">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Grupo:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                            <ComboBox x:Name="CmbLpGrupo" Width="175" DisplayMemberPath="Descripcion" SelectedValuePath="IdGrupoProducto" Margin="0,0,12,4"/>
                            <TextBlock Text="Subgrupo:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                            <ComboBox x:Name="CmbLpSubGrupo" Width="165" DisplayMemberPath="Descripcion" SelectedValuePath="IdSubGrupoProducto" Margin="0,0,12,4"/>
                            <TextBlock Text="Marca:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                            <ComboBox x:Name="CmbLpMarca" Width="165" DisplayMemberPath="Descripcion" SelectedValuePath="IdMarcaProducto" Margin="0,0,12,4"/>
                            <TextBlock Text="Modelo:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                            <ComboBox x:Name="CmbLpModelo" Width="165" DisplayMemberPath="Descripcion" SelectedValuePath="IdModeloProducto" Margin="0,0,12,4"/>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Orden:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <RadioButton x:Name="RbLpOrdDesc" Content="Descripción" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton x:Name="RbLpOrdCod" Content="Código" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <CheckBox x:Name="ChkLpCosto" Content="Incluir Costo" VerticalAlignment="Center" Margin="0,0,10,0" Checked="LpColumns_Changed" Unchecked="LpColumns_Changed"/>
                                <CheckBox x:Name="ChkLpP1" Content="P1" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Checked="LpColumns_Changed" Unchecked="LpColumns_Changed"/>
                                <CheckBox x:Name="ChkLpP2" Content="P2" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Checked="LpColumns_Changed" Unchecked="LpColumns_Changed"/>
                                <CheckBox x:Name="ChkLpP3" Content="P3" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Checked="LpColumns_Changed" Unchecked="LpColumns_Changed"/>
                                <CheckBox x:Name="ChkLpP4" Content="P4" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Checked="LpColumns_Changed" Unchecked="LpColumns_Changed"/>
                                <CheckBox x:Name="ChkLpP5" Content="P5" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Checked="LpColumns_Changed" Unchecked="LpColumns_Changed"/>
                                <CheckBox x:Name="ChkLpP6" Content="P6" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Checked="LpColumns_Changed" Unchecked="LpColumns_Changed"/>
                                <CheckBox x:Name="ChkLpP7" Content="P7" VerticalAlignment="Center" Margin="0,0,12,0" Checked="LpColumns_Changed" Unchecked="LpColumns_Changed"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🔍 Consultar" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" Margin="0,0,8,0" Click="BtnConsultarListaPrecios_Click"/>
                                <Button Content="📄 Exportar CSV" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="0,0,8,0" Click="BtnExportListaPrecios_Click"/>
                                <Button Content="🖨 Vista Impresión" Style="{StaticResource SuccessButtonStyle}" Padding="12,6" Click="BtnPrintListaPrecios_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Padding="6">
                        <DataGrid x:Name="GridListaPrecios" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="105" FontWeight="Bold"/>
                                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                                <DataGridTextColumn Header="GRUPO" Binding="{Binding GrupoDescripcion}" Width="120"/>
                                <DataGridTextColumn x:Name="ColLpCosto" Header="COSTO 1" Binding="{Binding Costo1, StringFormat=N0}" Width="90" Visibility="Collapsed"/>
                                <DataGridTextColumn x:Name="ColLpP1" Header="PRECIO 1" Binding="{Binding Precio1, StringFormat=N0}" Width="95" FontWeight="Bold"/>
                                <DataGridTextColumn x:Name="ColLpP2" Header="PRECIO 2" Binding="{Binding Precio2, StringFormat=N0}" Width="90"/>
                                <DataGridTextColumn x:Name="ColLpP3" Header="PRECIO 3" Binding="{Binding Precio3, StringFormat=N0}" Width="90"/>
                                <DataGridTextColumn x:Name="ColLpP4" Header="PRECIO 4" Binding="{Binding Precio4, StringFormat=N0}" Width="90"/>
                                <DataGridTextColumn x:Name="ColLpP5" Header="PRECIO 5" Binding="{Binding Precio5, StringFormat=N0}" Width="90"/>
                                <DataGridTextColumn x:Name="ColLpP6" Header="PRECIO 6" Binding="{Binding Precio6, StringFormat=N0}" Width="90"/>
                                <DataGridTextColumn x:Name="ColLpP7" Header="PRECIO 7" Binding="{Binding Precio7, StringFormat=N0}" Width="90" Visibility="Collapsed"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 1: STOCK POR DEPÓSITOS -->
            <TabItem Header="🏭  Stock X Depósito (informe_productosxdepositos)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <WrapPanel VerticalAlignment="Center">
                                <CheckBox x:Name="ChkTodosDepositos" Content="Todos los Depósitos" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                                          Checked="ChkTodosDepositos_Changed" Unchecked="ChkTodosDepositos_Changed"/>
                                <ComboBox x:Name="CmbStockDeposito" Width="210" DisplayMemberPath="Descripcion" SelectedValuePath="IdDeposito" IsEnabled="False" Margin="0,0,14,0"/>
                                <CheckBox x:Name="ChkSoloStockPositivo" Content="Solo Stock > 0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <RadioButton x:Name="RbSdOrdDesc" Content="Orden Descripción" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton x:Name="RbSdOrdCod" Content="Orden Código" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🔍 Consultar" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" Margin="0,0,8,0" Click="BtnConsultarStockDeposito_Click"/>
                                <Button Content="📄 Exportar CSV" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="0,0,8,0" Click="BtnExportStockDeposito_Click"/>
                                <Button Content="🖨 Vista Impresión" Style="{StaticResource SuccessButtonStyle}" Padding="12,6" Click="BtnPrintStockDeposito_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="6">
                        <DataGrid x:Name="GridStockDeposito" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DEPÓSITO" Binding="{Binding DesDeposito}" Width="145" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="105" FontWeight="Bold"/>
                                <DataGridTextColumn Header="PRODUCTO" Binding="{Binding DesProducto}" Width="*"/>
                                <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad, StringFormat=N2}" Width="95" FontWeight="Bold"/>
                                <DataGridTextColumn Header="COSTO MEDIO" Binding="{Binding CostoMedio, StringFormat=N0}" Width="105"/>
                                <DataGridTextColumn Header="PRECIO 1" Binding="{Binding Precio1, StringFormat=N0}" Width="100"/>
                                <DataGridTextColumn Header="VALOR COSTO" Binding="{Binding ValorCosto, StringFormat=N0}" Width="115"/>
                                <DataGridTextColumn Header="VALOR VENTA" Binding="{Binding ValorVenta, StringFormat=N0}" Width="115" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SoftPanelStyle}" Padding="14,8" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtStockTotals" Text="Totales: 0 unidades" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: VENCIMIENTO DE PRODUCTOS -->
            <TabItem Header="📅  Vencimientos / Lotes (vencimiento_productos)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Vencimiento Desde:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DpVencDesde" Width="135" Margin="0,0,12,0"/>
                                <TextBlock Text="Hasta:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DpVencHasta" Width="135" Margin="0,0,14,0"/>
                                <Button Content="🔍 Consultar [F5]" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" Click="BtnConsultarVencimientos_Click"/>
                            </WrapPanel>
                            <Button Content="📄 Exportar CSV" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="12,6" Click="BtnExportVencimientos_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="6">
                        <DataGrid x:Name="GridVencimientos" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="115" FontWeight="Bold"/>
                                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                                <DataGridTextColumn Header="LOTE" Binding="{Binding Lote}" Width="130" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="VENCIMIENTO" Binding="{Binding Vencimiento, StringFormat=dd/MM/yyyy}" Width="120" FontWeight="Bold"/>
                                <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad, StringFormat=N2}" Width="105"/>
                                <DataGridTextColumn Header="DEPÓSITO" Binding="{Binding IdDeposito}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: CONSULTA DE PRECIOS + FICHA SOLO LECTURA (crear_preciosproductos + abm_consultaproductos) -->
            <TabItem Header="🏷  Consulta P1–P7 (crear_preciosproductos)">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel x:Name="PanelConsultAz" Grid.Row="0" Margin="0,0,0,8">
                            <RadioButton Content="Todo" GroupName="ConsultAz" IsChecked="True" Margin="0,0,8,4" Checked="ConsultAz_Checked" Tag="Todo"/>
                            <RadioButton Content="A-C" GroupName="ConsultAz" Margin="0,0,8,4" Checked="ConsultAz_Checked" Tag="A-C"/>
                            <RadioButton Content="D-F" GroupName="ConsultAz" Margin="0,0,8,4" Checked="ConsultAz_Checked" Tag="D-F"/>
                            <RadioButton Content="G-I" GroupName="ConsultAz" Margin="0,0,8,4" Checked="ConsultAz_Checked" Tag="G-I"/>
                            <RadioButton Content="J-L" GroupName="ConsultAz" Margin="0,0,8,4" Checked="ConsultAz_Checked" Tag="J-L"/>
                            <RadioButton Content="M-O" GroupName="ConsultAz" Margin="0,0,8,4" Checked="ConsultAz_Checked" Tag="M-O"/>
                            <RadioButton Content="P-R" GroupName="ConsultAz" Margin="0,0,8,4" Checked="ConsultAz_Checked" Tag="P-R"/>
                            <RadioButton Content="S-U" GroupName="ConsultAz" Margin="0,0,8,4" Checked="ConsultAz_Checked" Tag="S-U"/>
                            <RadioButton Content="V-X" GroupName="ConsultAz" Margin="0,0,8,4" Checked="ConsultAz_Checked" Tag="V-X"/>
                            <RadioButton Content="Y-Z" GroupName="ConsultAz" Margin="0,0,8,4" Checked="ConsultAz_Checked" Tag="Y-Z"/>
                        </WrapPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtConsultSearch" Grid.Column="0" KeyDown="TxtConsultSearch_KeyDown"/>
                            <Button Grid.Column="1" Content="🔍 Buscar" Style="{StaticResource PrimaryButtonStyle}" Padding="12,5" Margin="8,0,0,0" Click="BtnConsultSearch_Click"/>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Padding="4">
                            <DataGrid x:Name="GridConsultaPrecios" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="0"
                                      SelectionChanged="GridConsultaPrecios_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CÓD." Binding="{Binding Codigo}" Width="90" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                                    <DataGridTextColumn Header="P1" Binding="{Binding Precio1, StringFormat=N0}" Width="82" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="P2" Binding="{Binding Precio2, StringFormat=N0}" Width="78"/>
                                    <DataGridTextColumn Header="P3" Binding="{Binding Precio3, StringFormat=N0}" Width="78"/>
                                    <DataGridTextColumn Header="P4" Binding="{Binding Precio4, StringFormat=N0}" Width="75"/>
                                    <DataGridTextColumn Header="P5" Binding="{Binding Precio5, StringFormat=N0}" Width="75"/>
                                    <DataGridTextColumn Header="P6" Binding="{Binding Precio6, StringFormat=N0}" Width="75"/>
                                    <DataGridTextColumn Header="P7" Binding="{Binding Precio7, StringFormat=N0}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- FICHA DETALLE SOLO LECTURA (abm_consultaproductos.scx) -->
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="FICHA DE CONSULTA (SOLO LECTURA)" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="TxtDetTitulo" Text="Seleccione un artículo" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" Margin="0,4,0,8"/>

                                <Border Style="{StaticResource SoftPanelStyle}" Padding="8" Height="165" Margin="0,0,0,10">
                                    <Image x:Name="ImgDetFoto" Stretch="Uniform"/>
                                </Border>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtDetPreciosCol1" Grid.Column="0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtDetPreciosCol2" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Grid>

                                <TextBlock Text="Aplicación:" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtDetAplicacion" Height="55" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource InputReadOnlyBgBrush}" Margin="0,0,0,8"/>

                                <TextBlock Text="Observación:" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtDetObservacion" Height="55" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource InputReadOnlyBgBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource StatusBarStyle}" Padding="18,8">
            <TextBlock x:Name="TxtStatus" Text="Listo." FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
