<Window x:Class="FirewallControl.App.Views.PurchasesManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Compras, Stock y Proveedores"
        Width="1260" Height="790"
        MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ABASTECIMIENTO Y PROVEEDORES" Style="{StaticResource EyebrowLabelStyle}"/>
                    <TextBlock Text="Compras de Mercaderías y Stock" Style="{StaticResource PageTitleStyle}" FontSize="22" Margin="0,2,0,0"/>
                    <TextBlock Text="Facturas de compra, recálculo automático de costo promedio ponderado y actualización de precios"
                               Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕ Cerrar [ESC]" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnClose_Click" VerticalAlignment="Center" Padding="14,7"/>
            </Grid>
        </Border>

        <!-- MAIN TABS -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="18,14,18,10">

            <!-- ================================================================ -->
            <!-- TAB 1: FACTURA DE COMPRA                                         -->
            <!-- ================================================================ -->
            <TabItem Header="🛒  Factura de Compra">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera Factura de Compra -->
                    <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Nro. Compra" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtPurNroCompra" IsReadOnly="True"
                                         Background="{DynamicResource InputReadOnlyBgBrush}"
                                         Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Nro. Factura Proveedor" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtPurFactura" Text="001-001-0000001" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Timbrado" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtPurTimbrado" Text="12345678"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                <TextBlock Text="Fecha Compra" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker x:Name="DpPurFecha"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="0,0,10,0">
                                <TextBlock Text="Condición" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbPurCondicion">
                                    <ComboBoxItem Content="1 - Contado (Caja)" Tag="1" IsSelected="True"/>
                                    <ComboBoxItem Content="2 - Crédito" Tag="2"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="5" Margin="0,0,10,0">
                                <TextBlock Text="Depósito" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbPurDeposito" DisplayMemberPath="Descripcion" SelectedValuePath="IdDeposito"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6" Margin="0,0,10,0">
                                <TextBlock Text="Proveedor (*)" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbPurSupplier" DisplayMemberPath="Descripcion" SelectedValuePath="IdProveedor"
                                          SelectionChanged="CmbPurSupplier_SelectionChanged"/>
                            </StackPanel>

                            <Button Grid.Column="7" Content="🏢 Proveedor" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,6" Margin="0,18,0,0" Click="BtnGoToSuppliers_Click"/>
                        </Grid>
                    </Border>

                    <!-- Toolbar de Ítems -->
                    <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="+ Agregar Producto [F2]" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="14,7" Margin="0,0,8,0" Click="BtnAddItemModal_Click"/>
                            <Button Grid.Column="1" Content="✏ Modificar Ítem" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,7" Margin="0,0,8,0" Click="BtnEditItemModal_Click"/>
                            <Button Grid.Column="2" Content="🗑 Quitar [DEL]" Style="{StaticResource SoftDangerButtonStyle}"
                                    Padding="12,7" Margin="0,0,14,0" Click="BtnDeleteItem_Click"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Código:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtQuickScanCode" Width="175" ToolTip="Escanee código y presione ENTER para abrir itemsfacturacompras"
                                         KeyDown="TxtQuickScanCode_KeyDown"/>
                            </StackPanel>

                            <TextBlock Grid.Column="4" Text="Doble clic en una fila para ajustar costo o precios de venta"
                                       Style="{StaticResource SubtitleTextStyle}" FontSize="11.5"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0"/>

                            <Button Grid.Column="5" Content="🧹 Limpiar Factura" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,7" Click="BtnResetPurchase_Click"/>
                        </Grid>
                    </Border>

                    <!-- Grilla de Ítems -->
                    <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Padding="6">
                        <DataGrid x:Name="GridCurrentPurchaseItems" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                  MouseDoubleClick="GridCurrentPurchaseItems_MouseDoubleClick" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding RecNo}" Width="45"/>
                                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="115" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Descripción del Producto" Binding="{Binding Descripcion}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat=N2}" Width="90" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Costo Compra" Binding="{Binding PreUnitario, StringFormat=N0}" Width="110"/>
                                <DataGridTextColumn Header="Costo Prom." Binding="{Binding CostoMedio, StringFormat=N0}" Width="105"/>
                                <DataGridTextColumn Header="Nuevo Precio 1" Binding="{Binding Precio1, StringFormat=N0}" Width="115" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Exentas" Binding="{Binding PreExenta, StringFormat=N0}" Width="100"/>
                                <DataGridTextColumn Header="Grav. 5%" Binding="{Binding PreIva5, StringFormat=N0}" Width="100"/>
                                <DataGridTextColumn Header="Grav. 10%" Binding="{Binding PreIva10, StringFormat=N0}" Width="110"/>
                                <DataGridTextColumn Header="Total Línea" Binding="{Binding PrecioTotal, StringFormat=N0}" Width="120" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Footer Totales & Grabar Compra -->
                    <Border Grid.Row="3" Style="{StaticResource SoftPanelStyle}" Padding="16,12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,22,0">
                                    <TextBlock Text="EXENTAS" Style="{StaticResource EyebrowLabelStyle}"/>
                                    <TextBlock x:Name="TxtTotExenta" Text="0 Gs." Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,22,0">
                                    <TextBlock Text="GRAVADA 5%" Style="{StaticResource EyebrowLabelStyle}"/>
                                    <TextBlock x:Name="TxtTotIva5" Text="0 Gs." Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,22,0">
                                    <TextBlock Text="GRAVADA 10%" Style="{StaticResource EyebrowLabelStyle}"/>
                                    <TextBlock x:Name="TxtTotIva10" Text="0 Gs." Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,22,0">
                                    <TextBlock Text="LIQ. IVA TOTAL" Style="{StaticResource EyebrowLabelStyle}"/>
                                    <TextBlock x:Name="TxtTotImpuesto" Text="0 Gs." Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Width="115" Margin="0,0,18,0">
                                    <TextBlock Text="DESCUENTO (Gs.)" Style="{StaticResource EyebrowLabelStyle}"/>
                                    <TextBox x:Name="TxtPurDescuento" Text="0" Padding="6,3" TextChanged="TxtPurDescuento_TextChanged"/>
                                </StackPanel>
                            </WrapPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock Text="TOTAL FACTURA COMPRA" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="TxtPurTotalGeneral" Text="0 Gs." Foreground="{DynamicResource SuccessTextBrush}" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="💾 GRABAR COMPRA [F4]" Style="{StaticResource SuccessButtonStyle}"
                                    Padding="20,10" FontSize="13.5" Click="BtnSavePurchase_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================================================ -->
            <!-- TAB 2: HISTORIAL DE COMPRAS                                      -->
            <!-- ================================================================ -->
            <TabItem Header="📋  Historial de Compras">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Desde:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DpHistDesde" Width="130" Margin="0,0,12,0"/>
                                <TextBlock Text="Hasta:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DpHistHasta" Width="130" Margin="0,0,12,0"/>
                                <Button Content="🔍 Filtrar Compras" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" Click="BtnFilterPurchases_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="👁 Ver Detalle" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,8,0" Click="BtnViewPurchaseDetail_Click"/>
                                <Button Content="🗑 Eliminar Compra (Revertir Stock)" Style="{StaticResource SoftDangerButtonStyle}" Padding="12,7" Click="BtnDeletePurchase_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="6">
                        <DataGrid x:Name="GridPurchases" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                  MouseDoubleClick="BtnViewPurchaseDetail_Click">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdCompra}" Width="65"/>
                                <DataGridTextColumn Header="Nro. Compra" Binding="{Binding NroCompra}" Width="95" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Factura" Binding="{Binding NroFactura}" Width="145"/>
                                <DataGridTextColumn Header="Timbrado" Binding="{Binding Timbrado}" Width="105"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaCompra, StringFormat=dd/MM/yyyy}" Width="105"/>
                                <DataGridTextColumn Header="Proveedor" Binding="{Binding NombreProveedor}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Exentas" Binding="{Binding TotalExenta, StringFormat=N0}" Width="105"/>
                                <DataGridTextColumn Header="Grav. 5%" Binding="{Binding TotalIva5, StringFormat=N0}" Width="105"/>
                                <DataGridTextColumn Header="Grav. 10%" Binding="{Binding TotalIva10, StringFormat=N0}" Width="115"/>
                                <DataGridTextColumn Header="Total Compra (Gs.)" Binding="{Binding TotalCompra, StringFormat=N0}" Width="140" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Usuario" Binding="{Binding CidUsuario}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================================================ -->
            <!-- TAB 3: PROVEEDORES                                               -->
            <!-- ================================================================ -->
            <TabItem Header="🏢  Directorio de Proveedores">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lista de Proveedores -->
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearchSupplier" Grid.Column="0" Margin="0,0,8,0"
                                         KeyDown="TxtSearchSupplier_KeyDown"/>
                                <Button Grid.Column="1" Content="🔍 Buscar" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7"
                                        Margin="0,0,8,0" Click="BtnSearchSupplier_Click"/>
                                <Button Grid.Column="2" Content="+ Nuevo" Style="{StaticResource SuccessButtonStyle}" Padding="14,7"
                                        Click="BtnNewSupplier_Click"/>
                            </Grid>

                            <DataGrid x:Name="GridSuppliers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                      SelectionChanged="GridSuppliers_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding IdProveedor}" Width="60"/>
                                    <DataGridTextColumn Header="RUC" Binding="{Binding Ruc}" Width="110" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Razón Social / Proveedor" Binding="{Binding Descripcion}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="110"/>
                                    <DataGridTextColumn Header="Contacto" Binding="{Binding Contacto}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Ficha Proveedor -->
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="20,18">
                        <StackPanel>
                            <TextBlock x:Name="TxtSupFormTitle" Text="NUEVO PROVEEDOR" Style="{StaticResource SectionTitleStyle}" FontSize="17" Margin="0,0,0,14"/>

                            <TextBlock Text="RUC (*)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSupRuc" Margin="0,0,0,10"/>

                            <TextBlock Text="Razón social / nombre (*)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSupNombre" Margin="0,0,0,10"/>

                            <TextBlock Text="Persona de contacto / vendedor" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSupContacto" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Teléfono" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtSupTel"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Timbrado habitual" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtSupTimbrado"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Dirección" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSupDir" Margin="0,0,0,16"/>

                            <WrapPanel>
                                <Button Content="💾 Guardar Proveedor" Style="{StaticResource SuccessButtonStyle}" Padding="16,8"
                                        Margin="0,0,8,0" Click="BtnSaveSupplier_Click"/>
                                <Button Content="🗑 Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Padding="14,8"
                                        Click="BtnDeleteSupplier_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- FOOTER BAR -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarStyle}" Padding="20,9">
            <TextBlock x:Name="TxtStatus" Text="Listo. Presione [F2] para cargar ítems o [F4] para grabar la factura."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
