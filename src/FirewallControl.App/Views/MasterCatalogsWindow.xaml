<Window x:Class="FirewallControl.App.Views.MasterCatalogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catálogos Maestros y Timbrados Locales"
        Width="1120" Height="710"
        MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <StackPanel>
                <TextBlock Text="CATÁLOGOS MAESTROS Y CONFIGURACIÓN FISCAL" Style="{StaticResource EyebrowLabelStyle}"/>
                <TextBlock Text="Monedas, Ciudades, Barrios, Sucursales y Timbrados Locales" Style="{StaticResource PageTitleStyle}" FontSize="21" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="18,12,18,10">
            <!-- TAB 0: MONEDAS (abm_monedas) -->
            <TabItem Header="💱  Monedas">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="8">
                        <DataGrid x:Name="GridMonedas" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="GridMonedas_SelectionChanged" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdMoneda}" Width="55"/>
                                <DataGridTextColumn Header="MONEDA" Binding="{Binding Descripcion}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="COMPRA" Binding="{Binding Compra, StringFormat=N2}" Width="95"/>
                                <DataGridTextColumn Header="VENTA" Binding="{Binding Venta, StringFormat=N2}" Width="95"/>
                                <DataGridTextColumn Header="DEC" Binding="{Binding Decimales}" Width="50"/>
                                <DataGridTextColumn Header="OP" Binding="{Binding Operacion}" Width="45"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Ficha de Moneda" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Descripción *" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtMonedaDesc" Margin="0,4,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cotización Compra" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtMonedaCompra" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cotización Venta" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtMonedaVenta" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Decimales" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtMonedaDecimales" Text="2" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Operación" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="CmbMonedaOp" SelectedIndex="0" Margin="0,4,0,0">
                                        <ComboBoxItem Content="*"/>
                                        <ComboBoxItem Content="/"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Tipo / Tronco" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtMonedaTipo" Text="0" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel>
                                <Button Content="Nuevo" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoMoneda_Click" Margin="0,0,8,6"/>
                                <Button Content="Guardar" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarMoneda_Click" Margin="0,0,8,6"/>
                                <Button Content="Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnEliminarMoneda_Click" Margin="0,0,8,6"/>
                                <Button x:Name="BtnSeedLatamCurrencies" Content="🌎 Cargar Monedas LATAM" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSeedLatamCurrencies_Click" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 1: CIUDADES Y BARRIOS (abm_ciudades / abm_barrios) -->
            <TabItem Header="🗺  Ciudades y Barrios">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CIUDADES -->
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Ciudades" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="GridCiudades" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      SelectionChanged="GridCiudades_SelectionChanged" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding IdCiudad}" Width="55"/>
                                    <DataGridTextColumn Header="CIUDAD" Binding="{Binding Ciudad}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="DEPARTAMENTO" Binding="{Binding Departamento}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nombre Ciudad *" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtCiudadNombre" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Departamento" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtCiudadDepto" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="Nueva" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoCiudad_Click" Margin="0,0,8,0"/>
                                    <Button Content="Guardar Ciudad" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarCiudad_Click" Margin="0,0,8,0"/>
                                    <Button Content="Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnEliminarCiudad_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- BARRIOS -->
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Barrios por Ciudad" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="GridBarrios" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      SelectionChanged="GridBarrios_SelectionChanged" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding IdBarrio}" Width="55"/>
                                    <DataGridTextColumn Header="BARRIO" Binding="{Binding Barrio}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="CIUDAD" Binding="{Binding CiudadNombre}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nombre Barrio *" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtBarrioNombre" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ciudad" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CmbBarrioCiudad" DisplayMemberPath="Ciudad" SelectedValuePath="IdCiudad" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="Nuevo" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoBarrio_Click" Margin="0,0,8,0"/>
                                    <Button Content="Guardar Barrio" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarBarrio_Click" Margin="0,0,8,0"/>
                                    <Button Content="Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnEliminarBarrio_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: SUCURSALES (abm_sucursal) -->
            <TabItem Header="🏢  Sucursales">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="8">
                        <DataGrid x:Name="GridSucursales" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="GridSucursales_SelectionChanged" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdSucursal}" Width="50"/>
                                <DataGridTextColumn Header="SUCURSAL" Binding="{Binding Nombre}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="ENCARGADO" Binding="{Binding Enc}" Width="140"/>
                                <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Tel}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Datos de Sucursal" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <TextBlock Text="Nombre Sucursal *" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSucNombre" Margin="0,3,0,8"/>
                            <TextBlock Text="Dirección" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSucDir" Margin="0,3,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Teléfono" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtSucTel" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Celular" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtSucCel" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Encargado" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSucEnc" Margin="0,3,0,8"/>
                            <TextBlock Text="Correo Electrónico" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSucEmail" Margin="0,3,0,14"/>
                            <WrapPanel>
                                <Button Content="Nueva" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoSucursal_Click" Margin="0,0,8,0"/>
                                <Button Content="Guardar Sucursal" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarSucursal_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: TIMBRADOS LOCALES (timbrado_local) -->
            <TabItem Header="🧾  Timbrados Locales">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="8">
                        <DataGrid x:Name="GridTimbrados" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="GridTimbrados_SelectionChanged" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdTimbradoLocal}" Width="48"/>
                                <DataGridTextColumn Header="SUC" Binding="{Binding IdSucursal}" Width="48"/>
                                <DataGridTextColumn Header="CAJA" Binding="{Binding IdCaja}" Width="52"/>
                                <DataGridTextColumn Header="TIMBRADO" Binding="{Binding Timbrado}" Width="105" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="PRÓX. FACTURA" Binding="{Binding Factura}" Width="140" FontWeight="Bold"/>
                                <DataGridTextColumn Header="VENCIMIENTO" Binding="{Binding Vencimiento, StringFormat=dd/MM/yyyy}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Talonario / Timbrado Local" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sucursal" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="CmbTimSucursal" DisplayMemberPath="Nombre" SelectedValuePath="IdSucursal" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Caja" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="CmbTimCaja" DisplayMemberPath="Descripcion" SelectedValuePath="IdCaja" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Número de Timbrado *" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtTimNro" Margin="0,3,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Estab (N1)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtTimN1" Text="1" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Exped (N2)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtTimN2" Text="1" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Número Actual (N3)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtTimN3" Text="1" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Fecha Inicio" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker x:Name="DpTimInicio" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Vencimiento" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker x:Name="DpTimVenc" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Cantidad Límite" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtTimCantidad" Text="9999999" Margin="0,3,0,12"/>
                            <WrapPanel>
                                <Button Content="Nuevo" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoTimbrado_Click" Margin="0,0,8,0"/>
                                <Button Content="Guardar Timbrado" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarTimbrado_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource StatusBarStyle}">
            <Grid>
                <TextBlock x:Name="LblStatus" Text="Listo." Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Content="🔄 Recargar Todo" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right"
                        Padding="12,4" Click="BtnReloadAll_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
