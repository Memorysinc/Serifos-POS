<Window x:Class="FirewallControl.App.Views.ReportsAndConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informes de Ventas, Ganancias y Lucro"
        Width="1300" Height="820"
        MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="INTELIGENCIA COMERCIAL" Style="{StaticResource EyebrowLabelStyle}"/>
                    <TextBlock Text="Informes de Ventas y Lucro" Style="{StaticResource PageTitleStyle}" FontSize="22" Margin="0,2,0,0"/>
                    <TextBlock Text="Auditoría detallada de ventas por horario, reimpresión, anulación y rentabilidad por cliente o producto"
                               Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource BadgePillStyle}"
                        Background="{DynamicResource SurfaceAltBrush}" VerticalAlignment="Center">
                    <TextBlock Text="[ESC] Cerrar Ventana" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN TABS -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="18,14,18,10">
            <!-- ============================================================ -->
            <!-- TAB 1: INFORME DE VENTAS + DETALLE DE QUÉ SE VENDIÓ + BORRAR -->
            <!-- ============================================================ -->
            <TabItem Header="📈  Informe de Ventas">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de Filtros y Acciones -->
                    <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="14,10" Margin="0,0,0,12">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Desde:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpVentasDesde" Width="122" Margin="0,0,10,0"/>
                            <TextBlock Text="Hasta:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpVentasHasta" Width="122" Margin="0,0,8,0"/>

                            <Button x:Name="BtnVentasHoy" Content="📅 Hoy" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BtnFiltroHoy_Click" Padding="11,6" Margin="0,0,10,0" ToolTip="Ver solo las ventas de hoy"/>

                            <TextBlock Text="Buscar:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtBuscarVenta" Width="165" Padding="8,6" Margin="0,0,10,0"
                                     ToolTip="Filtra en vivo por Nro. Venta, Cliente o Usuario"
                                     TextChanged="TxtBuscarVenta_TextChanged"/>

                            <Button Content="🔍 Consultar" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnRunSalesReport_Click" Padding="14,7" Margin="0,0,8,0"/>
                            <Button Content="🖨 Reimprimir" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BtnReprintSelectedSale_Click" Padding="13,7" Margin="0,0,8,0"/>
                            <Button Content="🗑 Anular Venta" Style="{StaticResource SoftDangerButtonStyle}"
                                    Click="BtnDeleteSelectedSale_Click" Padding="13,7" Margin="0,0,8,0"/>
                            <Button Content="⬇ Exportar CSV" Style="{StaticResource SuccessButtonStyle}"
                                    Click="BtnExportSalesReport_Click" Padding="13,7"/>
                        </WrapPanel>
                    </Border>

                    <!-- SPLIT: LISTA DE VENTAS (IZQ) + QUÉ SE VENDIÓ Y HORA (DER) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Grilla Maestra de Ventas -->
                        <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="6">
                            <DataGrid x:Name="GridSalesReport"
                                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      BorderThickness="0"
                                      SelectionChanged="GridSalesReport_SelectionChanged"
                                      PreviewKeyDown="GridSalesReport_PreviewKeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding FechaVenta, StringFormat=dd/MM/yyyy}" Width="88"/>
                                    <DataGridTextColumn Header="HORA EXACTA" Binding="{Binding HoraVenta}" Width="92" FontWeight="Bold">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="NRO. VENTA" Binding="{Binding NroVenta}" Width="88" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="CAJA" Binding="{Binding IdCaja}" Width="50"/>
                                    <DataGridTextColumn Header="PAGO" Binding="{Binding FormaPagoNombre}" Width="78"/>
                                    <DataGridTextColumn Header="CLIENTE" Binding="{Binding NombreCliente}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="USUARIO" Binding="{Binding CidUsuario}" Width="90"/>
                                    <DataGridTextColumn Header="TOTAL (Gs.)" Binding="{Binding TotalVenta, StringFormat=N0}" Width="110" FontWeight="Bold">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="ACCIÓN" Width="82">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑 Borrar" Click="BtnDeleteSaleRow_Click"
                                                        Style="{StaticResource SoftDangerButtonStyle}"
                                                        Padding="6,2" FontSize="11" Height="24"
                                                        ToolTip="Anular esta venta y devolver su stock"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Panel Derecho: Qué se vendió en la venta seleccionada -->
                        <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock x:Name="LblDetalleVentaHeader" Text="QUÉ SE VENDIÓ EN LA VENTA SELECCIONADA"
                                               Style="{StaticResource EyebrowLabelStyle}"/>
                                    <TextBlock x:Name="LblDetalleVentaSub" Text="Seleccione una venta a la izquierda para ver sus artículos y hora."
                                               Style="{StaticResource SubtitleTextStyle}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <DataGrid x:Name="GridSaleDetails" Grid.Row="1"
                                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                          BorderThickness="0"
                                          PreviewKeyDown="GridSalesReport_PreviewKeyDown">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="86" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad, StringFormat=N2}" Width="62" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="PRODUCTO VENDIDO" Binding="{Binding Descripcion}" Width="*" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="P. UNIT." Binding="{Binding PreUnitario, StringFormat=N0}" Width="84"/>
                                        <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding PrecioTotal, StringFormat=N0}" Width="98" FontWeight="Bold">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="2" Style="{StaticResource SoftPanelStyle}" Padding="12,8" Margin="0,10,0,0">
                                    <Grid>
                                        <TextBlock x:Name="LblDetalleFooterLeft" Text="Entrega: 0 Gs.  ·  Vuelto: 0 Gs."
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblDetalleFooterRight" Text="Total Venta: 0 Gs."
                                                   Foreground="{DynamicResource SuccessTextBrush}" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Barra Resumen Total del Período -->
                    <Border Grid.Row="2" Style="{StaticResource SoftPanelStyle}" Padding="16,10" Margin="0,12,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Cantidad de Ventas:" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblCountSales" Text="0" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="15" Margin="0,0,28,0" VerticalAlignment="Center"/>
                                <TextBlock Text="TOTAL FACTURADO:" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblTotalSalesAmount" Text="0 Gs." Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Tip: Presiona [Supr/Del] sobre una venta para anularla · [F3] Buscar Cliente en Lucro"
                                       Style="{StaticResource SubtitleTextStyle}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- TAB 2: INFORME DE LUCRO Y EGRESOS (informe_lucro.scx)        -->
            <!-- ============================================================ -->
            <TabItem Header="💎  Costo / Beneficio y Egresos">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                                <TextBlock Text="Desde:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DpLucroDesde" Width="125" Margin="0,0,12,0"/>
                                <TextBlock Text="Hasta:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DpLucroHasta" Width="125" Margin="0,0,8,0"/>
                                <Button x:Name="BtnLucroHoy" Content="📅 Hoy" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnLucroHoy_Click" Padding="11,6" Margin="0,0,14,0" ToolTip="Filtrar rentabilidad de hoy"/>

                                <RadioButton x:Name="RbLucroSimple" Content="Simple" IsChecked="True" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <RadioButton x:Name="RbLucroExpandido" Content="Expandido (con Egresos)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>

                                <Button Content="💎 Procesar Lucro" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnRunLucroReport_Click" Padding="14,7" Margin="0,0,8,0"/>
                                <Button Content="⬇ Exportar Excel/CSV" Style="{StaticResource SuccessButtonStyle}"
                                        Click="BtnExportLucroReport_Click" Padding="14,7"/>
                            </WrapPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <CheckBox x:Name="ChkLucroTodosClientes" Content="Todos los Clientes" IsChecked="True"
                                          FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"
                                          Checked="ChkLucroTodosClientes_Changed" Unchecked="ChkLucroTodosClientes_Changed"/>
                                <TextBlock Text="RUC Cliente:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtLucroRuc" Width="130" FontWeight="Bold" IsEnabled="False" Margin="0,0,6,0"
                                         ToolTip="RUC o código de cliente para filtrar rentabilidad"/>
                                <Button x:Name="BtnBuscarClienteLucro" Content="🔍 [F3]" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnBuscarClienteLucro_Click" IsEnabled="False" Padding="10,5" Margin="0,0,10,0"/>
                                <TextBlock x:Name="LblLucroClienteNombre" Text="(TODOS LOS CLIENTES)" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" FontSize="12.5"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="6">
                        <DataGrid x:Name="GridLucroReport"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="90"/>
                                <DataGridTextColumn Header="MOVIMIENTO" Binding="{Binding TipoMovimiento}" Width="115" FontWeight="Bold"/>
                                <DataGridTextColumn Header="COMPROBANTE" Binding="{Binding NroFactura}" Width="120"/>
                                <DataGridTextColumn Header="RUC" Binding="{Binding Ruc}" Width="95"/>
                                <DataGridTextColumn Header="CLIENTE / RUBRO DE CAJA" Binding="{Binding Nombre}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="TOTAL VENTA Gs." Binding="{Binding TotalVenta, StringFormat=N0}" Width="125" FontWeight="Bold"/>
                                <DataGridTextColumn Header="COSTO MERC. Gs." Binding="{Binding TotalCosto, StringFormat=N0}" Width="125"/>
                                <DataGridTextColumn Header="EGRESO CAJA Gs." Binding="{Binding Egresos, StringFormat=N0}" Width="120"/>
                                <DataGridTextColumn Header="BENEFICIO Gs." Binding="{Binding Beneficio, StringFormat=N0}" Width="125" FontWeight="Bold"/>
                                <DataGridTextColumn Header="% MARGEN" Binding="{Binding PorcentajeLucro, StringFormat=N2}" Width="85" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SoftPanelStyle}" Padding="16,12" Margin="0,12,0,0">
                        <WrapPanel>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="TOTAL VENTAS" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="LblLucroTotalVentas" Text="0 Gs." Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="COSTO MERCADERÍA" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="LblLucroTotalCosto" Text="0 Gs." Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="BENEFICIO BRUTO" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="LblLucroBeneficioBruto" Text="0 Gs." Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="TOTAL EGRESOS CAJA" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="LblLucroTotalEgresos" Text="0 Gs." Foreground="{DynamicResource DangerTextBrush}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="UTILIDAD NETA REAL" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="LblLucroNetoReal" Text="0 Gs." Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold" FontSize="17"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="% RENTABILIDAD" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="LblLucroPorcentaje" Text="0.00 %" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- TAB 3: LUCRO POR PRODUCTOS                                   -->
            <!-- ============================================================ -->
            <TabItem Header="📦  Lucro por Productos">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                                <TextBlock Text="Desde:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DpLucroProdDesde" Width="125" Margin="0,0,12,0"/>
                                <TextBlock Text="Hasta:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DpLucroProdHasta" Width="125" Margin="0,0,8,0"/>
                                <Button x:Name="BtnLucroProdHoy" Content="📅 Hoy" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnLucroProdHoy_Click" Padding="11,6" Margin="0,0,14,0" ToolTip="Filtrar lucro por productos de hoy"/>

                                <Button Content="📦 Calcular Lucro por Producto" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnRunLucroProductos_Click" Padding="14,7" Margin="0,0,8,0"/>
                                <Button Content="⬇ Exportar Excel/CSV" Style="{StaticResource SuccessButtonStyle}"
                                        Click="BtnExportLucroProductos_Click" Padding="14,7"/>
                            </WrapPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <CheckBox x:Name="ChkLucroTodosProductos" Content="Todos los Productos" IsChecked="True"
                                          FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"
                                          Checked="ChkLucroTodosProductos_Changed" Unchecked="ChkLucroTodosProductos_Changed"/>
                                <TextBlock Text="Código:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtLucroCodProd" Width="140" FontWeight="Bold" IsEnabled="False" Margin="0,0,6,0"
                                         ToolTip="Código de producto específico"/>
                                <Button x:Name="BtnBuscarProdLucro" Content="🔍 [F3]" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnBuscarProdLucro_Click" IsEnabled="False" Padding="10,5" Margin="0,0,10,0"/>
                                <TextBlock x:Name="LblLucroProdNombre" Text="(TODOS LOS PRODUCTOS)" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" FontSize="12.5"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="6">
                        <DataGrid x:Name="GridLucroProductosReport"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoProducto}" Width="125" FontWeight="Bold"/>
                                <DataGridTextColumn Header="DESCRIPCIÓN DEL PRODUCTO" Binding="{Binding DescripcionProducto}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="CANT. VENDIDA" Binding="{Binding Cantidad, StringFormat=N2}" Width="110" FontWeight="Bold"/>
                                <DataGridTextColumn Header="PRECIO PROM. Gs." Binding="{Binding PrecioUnitarioPromedio, StringFormat=N0}" Width="120"/>
                                <DataGridTextColumn Header="TOTAL VENTA Gs." Binding="{Binding TotalVenta, StringFormat=N0}" Width="130" FontWeight="Bold"/>
                                <DataGridTextColumn Header="TOTAL COSTO Gs." Binding="{Binding TotalCosto, StringFormat=N0}" Width="130"/>
                                <DataGridTextColumn Header="BENEFICIO Gs." Binding="{Binding Beneficio, StringFormat=N0}" Width="130" FontWeight="Bold"/>
                                <DataGridTextColumn Header="% MARGEN" Binding="{Binding PorcentajeLucro, StringFormat=N2}" Width="90" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SoftPanelStyle}" Padding="16,12" Margin="0,12,0,0">
                        <WrapPanel>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="PRODUCTOS VENDIDOS" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="LblProdCount" Text="0" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="CANTIDAD TOTAL" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="LblProdTotalCant" Text="0.00" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="TOTAL VENTAS" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="LblProdTotalVentas" Text="0 Gs." Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="COSTO MERCADERÍA" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="LblProdTotalCosto" Text="0 Gs." Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="BENEFICIO TOTAL" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="LblProdTotalBeneficio" Text="0 Gs." Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold" FontSize="17"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="% MARGEN GLOBAL" Style="{StaticResource EyebrowLabelStyle}"/>
                                <TextBlock x:Name="LblProdPorcentaje" Text="0.00 %" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tabs de compatibilidad ocultos (Empresa y Usuarios viven ahora en ConfiguracionPreferenciasWindow) -->
            <TabItem Header="🏢 Configuración de Empresa" Visibility="Collapsed">
                <StackPanel>
                    <TextBox x:Name="TxtEmpDescripcion"/>
                    <TextBox x:Name="TxtEmpRuc"/>
                    <TextBox x:Name="TxtEmpDireccion"/>
                    <TextBox x:Name="TxtEmpTelefonos"/>
                    <TextBox x:Name="TxtEmpImpreNormal"/>
                    <TextBox x:Name="TxtEmpImpreLegal"/>
                    <CheckBox x:Name="ChkCobroCaja"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="🔐 Usuarios" Visibility="Collapsed">
                <Grid>
                    <DataGrid x:Name="GridUsers" SelectionChanged="GridUsers_SelectionChanged"/>
                    <StackPanel>
                        <TextBox x:Name="TxtUsrCodigo"/>
                        <TextBox x:Name="TxtUsrNombre"/>
                        <TextBox x:Name="TxtUsrGrupo"/>
                        <PasswordBox x:Name="TxtUsrNewPass"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- FOOTER BAR -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarStyle}" Padding="20,9">
            <TextBlock x:Name="LblStatus" Text="Listo." FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
