<Window x:Class="FirewallControl.App.Views.CashManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimientos de Caja y Cotizaciones"
        Width="1120" Height="700"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,14">
            <StackPanel>
                <TextBlock Text="TESORERÍA Y ARQUEO" Style="{StaticResource EyebrowLabelStyle}"/>
                <TextBlock Text="Caja y Cotizaciones del Día" Style="{StaticResource PageTitleStyle}" FontSize="22" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="18,14,18,10">
            <!-- TAB 1: MOVIMIENTOS Y ARQUEO -->
            <TabItem Header="💵  Movimientos y Arqueo de Caja">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filtros -->
                    <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Desde:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpDesde" Width="130" Margin="0,0,14,0"/>
                            <TextBlock Text="Hasta:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpHasta" Width="130" Margin="0,0,14,0"/>
                            <TextBlock Text="Caja:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbCajaFilter" Width="135" SelectedIndex="0" Margin="0,0,14,0">
                                <ComboBoxItem Content="Todas las Cajas" Tag="0"/>
                                <ComboBoxItem Content="Caja 1" Tag="1"/>
                                <ComboBoxItem Content="Caja 2" Tag="2"/>
                                <ComboBoxItem Content="Caja 3" Tag="3"/>
                                <ComboBoxItem Content="Caja 4" Tag="4"/>
                                <ComboBoxItem Content="Caja 5" Tag="5"/>
                            </ComboBox>
                            <Button Content="🔍 Filtrar / Consultar" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnFilterMovements_Click" Padding="14,7"/>
                        </StackPanel>
                    </Border>

                    <!-- Registrar Nuevo Movimiento Manual -->
                    <Border Grid.Row="1" Style="{StaticResource AtelierCardStyle}" Padding="14,12" Margin="0,0,0,12">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Tipo:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbTipoMov" Width="110" SelectedIndex="0" FontWeight="Bold" Margin="0,0,10,0">
                                <ComboBoxItem Content="ENTRADA"/>
                                <ComboBoxItem Content="SALIDA"/>
                            </ComboBox>
                            <TextBlock Text="Rubro:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbRubroMov" Width="165" DisplayMemberPath="NombreRubro" SelectedValuePath="NroRubro" Margin="0,0,10,0"/>
                            <TextBlock Text="Caja:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbCajaMov" Width="115" DisplayMemberPath="Descripcion" SelectedValuePath="IdCaja" Margin="0,0,10,0"/>
                            <TextBlock Text="Monto (Gs.):" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtMontoMov" Width="115" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Detalle / Motivo:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtDetalleMov" Width="210" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <Button Content="+ Registrar Movimiento" Style="{StaticResource SuccessButtonStyle}"
                                    Click="BtnRegisterMovement_Click" Padding="14,7"/>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Padding="6">
                        <DataGrid x:Name="GridMovements"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdMovimientoCaja}" Width="65"/>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding FechaAlta, StringFormat=dd/MM/yyyy}" Width="95"/>
                                <DataGridTextColumn Header="HORA" Binding="{Binding Hora}" Width="80"/>
                                <DataGridTextColumn Header="CAJA" Binding="{Binding IdCaja}" Width="60" FontWeight="Bold"/>
                                <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="90" FontWeight="Bold"/>
                                <DataGridTextColumn Header="DETALLE / CONCEPTO" Binding="{Binding Detalle}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="INGRESOS (Gs.)" Binding="{Binding Ingresos, StringFormat=N0}" Width="125" FontWeight="Bold"/>
                                <DataGridTextColumn Header="EGRESOS (Gs.)" Binding="{Binding Egresos, StringFormat=N0}" Width="125"/>
                                <DataGridTextColumn Header="USUARIO" Binding="{Binding CidUsuario}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource SoftPanelStyle}" Padding="16,12" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total Entradas:" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblTotalIngresos" Text="0" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold" FontSize="15" Margin="0,0,28,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Total Salidas:" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblTotalEgresos" Text="0" Foreground="{DynamicResource DangerTextBrush}" FontWeight="Bold" FontSize="15" Margin="0,0,28,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SALDO NETO EN CAJA (Gs.):" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblSaldoNeto" Text="0" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: COTIZACIONES DEL DÍA -->
            <TabItem Header="💱  Cotizaciones de Monedas">
                <Border Style="{StaticResource AtelierCardStyle}" Width="560" VerticalAlignment="Top" Margin="24" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="MONEDA" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="COMPRA (Gs.)" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,10,12"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="VENTA (Gs.)" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="🇺🇸 Dólar (U$S)" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtCompraDolar" Grid.Row="1" Grid.Column="1" Margin="0,0,10,10" FontWeight="Bold"/>
                        <TextBox x:Name="TxtVentaDolar" Grid.Row="1" Grid.Column="2" Margin="0,0,0,10" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="🇧🇷 Real (R$)" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtCompraReal" Grid.Row="2" Grid.Column="1" Margin="0,0,10,10" FontWeight="Bold"/>
                        <TextBox x:Name="TxtVentaReal" Grid.Row="2" Grid.Column="2" Margin="0,0,0,10" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="🇦🇷 Peso ($)" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtCompraPeso" Grid.Row="3" Grid.Column="1" Margin="0,0,10,10" FontWeight="Bold"/>
                        <TextBox x:Name="TxtVentaPeso" Grid.Row="3" Grid.Column="2" Margin="0,0,0,10" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="🇪🇺 Euro (€)" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,18"/>
                        <TextBox x:Name="TxtCompraEuro" Grid.Row="4" Grid.Column="1" Margin="0,0,10,18" FontWeight="Bold"/>
                        <TextBox x:Name="TxtVentaEuro" Grid.Row="4" Grid.Column="2" Margin="0,0,0,18" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}"/>

                        <Button Grid.Row="5" Grid.ColumnSpan="3"
                                Content="💾 Guardar Cotización del Día"
                                Style="{StaticResource SuccessButtonStyle}"
                                Click="BtnSaveExchangeRate_Click"
                                Padding="16,10" FontSize="14"/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: CAJAS (Crear_cajas.scx) -->
            <TabItem Header="🏧  Cajas (cajas)">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="6">
                        <DataGrid x:Name="GridCajas" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="0"
                                  SelectionChanged="GridCajas_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdCaja}" Width="60"/>
                                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="SALDO (Gs.)" Binding="{Binding Saldo, StringFormat=N0}" Width="115"/>
                                <DataGridTextColumn Header="SUCURSAL" Binding="{Binding DesSucursal}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="ABM DE CAJAS" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Descripción de Caja (*)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCajaDesc" MaxLength="60" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Saldo Inicial" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="TxtCajaSaldo" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Sucursal (ID)" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="TxtCajaSucId" Text="1"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Nombre Sucursal" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCajaDesSuc" Text="CASA CENTRAL" MaxLength="50" Margin="0,0,0,10"/>
                            <TextBlock Text="Observación" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCajaObs" Height="64" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <WrapPanel>
                                <Button Content="+ Nueva" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,6,0" Click="BtnCajaNew_Click"/>
                                <Button Content="💾 Guardar" Style="{StaticResource SuccessButtonStyle}" Padding="14,7" Margin="0,0,6,0" Click="BtnCajaSave_Click"/>
                                <Button Content="🗑 Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Padding="12,7" Click="BtnCajaDelete_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: RUBROS DE CAJA (Crear_rubros.scx) -->
            <TabItem Header="🗂  Rubros de Caja (rubros)">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="6">
                        <DataGrid x:Name="GridRubros" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="0"
                                  SelectionChanged="GridRubros_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NRO." Binding="{Binding NroRubro}" Width="75" FontWeight="Bold"/>
                                <DataGridTextColumn Header="NOMBRE DEL RUBRO" Binding="{Binding NombreRubro}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="TIPO CTA." Binding="{Binding TipoCuenta}" Width="85"/>
                                <DataGridTextColumn Header="PROCESO" Binding="{Binding Proceso}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="ABM DE RUBROS DE CAJA" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Nro. Rubro" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtRubroNro" Text="1" Margin="0,0,0,10"/>
                            <TextBlock Text="Nombre del Rubro (*)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtRubroNombre" MaxLength="35" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Tipo Cuenta (1=Ing/2=Egr)" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="TxtRubroTipoCta" Text="1"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Proceso" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="TxtRubroProceso" Text="1"/></StackPanel>
                            </Grid>
                            <WrapPanel>
                                <Button Content="+ Nuevo" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,6,0" Click="BtnRubroNew_Click"/>
                                <Button Content="💾 Guardar" Style="{StaticResource SuccessButtonStyle}" Padding="14,7" Margin="0,0,6,0" Click="BtnRubroSave_Click"/>
                                <Button Content="🗑 Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Padding="12,7" Click="BtnRubroDelete_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource StatusBarStyle}" Padding="20,9">
            <TextBlock x:Name="LblStatus" Text="Listo." FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
