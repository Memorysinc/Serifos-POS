<Window x:Class="FirewallControl.App.Views.ColorAtelierDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color del Atelier"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Border Background="{DynamicResource CardBgBrush}"
                CornerRadius="18"
                IsHitTestVisible="False"
                Effect="{StaticResource ModalCardShadow}"/>
        <Border Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="24,22"
                RenderOptions.ClearTypeHint="Enabled"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <StackPanel>
                <TextBlock Text="Color del Atelier"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="27" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Elige el tema visual del sistema (Tema Sefiros aplica también a FOX) y presiona Aceptar."
                           FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,18"/>

                <UniformGrid x:Name="PalettesGrid" Columns="2" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,9" Margin="0,0,8,0"
                            Click="BtnCancelar_Click"/>
                    <Button Content="Aceptar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="20,9"
                            Click="BtnAceptar_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
