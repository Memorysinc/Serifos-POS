<Window x:Class="FirewallControl.App.Views.QuickCreateCustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Cliente Rápido"
        Width="440" Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="18">
        <Border Style="{StaticResource AtelierCardStyle}" Padding="18">
            <StackPanel>
                <TextBlock Text="ALTA RÁPIDA DE CLIENTE" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="RUC / C.I." Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtRuc" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DV" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtDv" MaxLength="2"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Nombre / Razón Social *" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="TxtNombres" CharacterCasing="Upper" FontWeight="Bold" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Teléfono / Celular" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtTelefono"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dirección" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtDireccion"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar [ESC]" IsCancel="True" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="✔ Guardar Cliente" Style="{StaticResource SuccessButtonStyle}" IsDefault="True" Click="BtnSave_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
