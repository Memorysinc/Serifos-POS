<Window x:Class="FirewallControl.App.Views.GenesSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selector de Departamentos / Productos Pesables [Genes]"
        Width="1220" Height="800"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="Manual"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid x:Name="RootGrid" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE CATEGORÍAS Y ACCIONES (ESTILO GISSEL MODAS) -->
        <Border x:Name="TopBarBorder" Grid.Row="0"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Departamentos con acento discreto -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnGen1" Content="Gen 1 · Verdulería [A]" Tag="1" Click="BtnGen_Click"
                            Height="32" Padding="10,0" Margin="0,0,5,0" FontWeight="SemiBold" FontSize="12"
                            Cursor="Hand" Focusable="False"/>
                    <Button x:Name="BtnGen2" Content="Gen 2 · Carnicería [S]" Tag="2" Click="BtnGen_Click"
                            Height="32" Padding="10,0" Margin="0,0,5,0" FontWeight="SemiBold" FontSize="12"
                            Cursor="Hand" Focusable="False"/>
                    <Button x:Name="BtnGen3" Content="Gen 3 · Panadería [D]" Tag="3" Click="BtnGen_Click"
                            Height="32" Padding="10,0" Margin="0,0,5,0" FontWeight="SemiBold" FontSize="12"
                            Cursor="Hand" Focusable="False"/>
                    <Button x:Name="BtnGen4" Content="Gen 4 · Almacén [F]" Tag="4" Click="BtnGen_Click"
                            Height="32" Padding="10,0" Margin="0,0,5,0" FontWeight="SemiBold" FontSize="12"
                            Cursor="Hand" Focusable="False"/>
                </StackPanel>

                <!-- Acciones ABM y SQL -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnActualizarSql" Content="🔄 Sync SQL [F5]" Click="BtnActualizarSql_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="32" Padding="9,0" Margin="0,0,5,0" FontSize="11.5" Focusable="False"
                            ToolTip="Sincroniza inmediatamente todos los precios y costos desde la tabla productos de MySQL"/>
                    <Button x:Name="BtnNuevo" Content="+ Nuevo" Click="BtnNuevo_Click"
                            Height="32" Padding="10,0" Margin="0,0,5,0" FontWeight="SemiBold" FontSize="12"
                            Foreground="White" BorderThickness="0" Cursor="Hand" Focusable="False"/>
                    <Button x:Name="BtnEditar" Content="Editar" Click="BtnEditar_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="32" Padding="9,0" Margin="0,0,5,0" FontSize="12" Focusable="False"/>
                    <Button x:Name="BtnReordenar" Content="Reordenar" Click="BtnReordenar_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="32" Padding="9,0" Margin="0,0,5,0" FontSize="12" Focusable="False"/>
                    <Button x:Name="BtnEliminar" Content="Borrar [DEL]" Click="BtnEliminar_Click"
                            Style="{StaticResource SoftDangerButtonStyle}"
                            Height="32" Padding="9,0" Margin="0,0,5,0" FontSize="12" Focusable="False"/>
                    <Button x:Name="BtnCerrar" Content="Cerrar [ESC]" Click="BtnCerrar_Click"
                            Style="{StaticResource GhostButtonStyle}"
                            Height="32" Padding="9,0" Margin="0" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ENCABEZADO DEL DEPARTAMENTO ACTIVO -->
        <Border x:Name="SubHeaderBorder" Grid.Row="1"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="4,0,0,1"
                Margin="14,8,14,4"
                CornerRadius="10"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="CATÁLOGO RÁPIDO POR DEPARTAMENTO" Style="{StaticResource EyebrowLabelStyle}"/>
                    <TextBlock x:Name="LblGenTitle" Text="GEN 1  —  VERDULERÍA [A]"
                               Style="{StaticResource SectionTitleStyle}" FontSize="16" Margin="0,1,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource BadgePillStyle}" Background="{DynamicResource SurfaceAltBrush}" VerticalAlignment="Center">
                    <TextBlock Text="Flechas: Mover · [Enter]: Cargar · [Ctrl+A/S/D/F]: Nuevo · [Alt+A/S/D/F]: Editar · [F5]: Sync SQL"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- GRILLA DE TARJETAS DE PRODUCTOS -->
        <ScrollViewer x:Name="CardsScrollViewer" Grid.Row="2"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="14,6" Focusable="False">
            <UniformGrid x:Name="CardsUniformGrid" Columns="5" VerticalAlignment="Top"/>
        </ScrollViewer>

        <!-- BARRA INFERIOR DE ESTADO -->
        <Border Grid.Row="3" Style="{StaticResource StatusBarStyle}" Padding="14,6">
            <TextBlock x:Name="LblStatus"
                       Text="Seleccione un producto con las flechas y presione ENTER para ingresar monto o cantidad."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
