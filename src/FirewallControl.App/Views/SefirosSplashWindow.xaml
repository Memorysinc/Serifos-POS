<Window x:Class="FirewallControl.App.Views.SefirosSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sefiros POS — Iniciando..."
        Width="540"
        Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Geometría C1 continua de la "S" fiel al emblema oficial de Sefiros POS -->
        <PathGeometry x:Key="SefirosSPathGeometry">
            M 85,32 C 75,20 34,20 34,41 C 34,58 86,60 86,78 C 86,100 45,101 34,87
        </PathGeometry>

        <!-- Silueta oficial astroide cóncava de 4 puntas del ícono de Gemini -->
        <PathGeometry x:Key="GeminiSparkleGeometry">
            M 12,0 C 12.6,6.8 17.2,11.4 24,12 C 17.2,12.6 12.6,17.2 12,24 C 11.4,17.2 6.8,12.6 0,12 C 6.8,11.4 11.4,6.8 12,0 Z
        </PathGeometry>

        <!-- Gradiente base esmeralda -> cian -> azul Tema Sefiros -->
        <LinearGradientBrush x:Key="SefirosSLogoGradient" StartPoint="0.22,0.22" EndPoint="0.72,0.92">
            <GradientStop Color="#22C55E" Offset="0.00"/>
            <GradientStop Color="#0EA5E9" Offset="0.34"/>
            <GradientStop Color="#2563EB" Offset="0.68"/>
            <GradientStop Color="#1D4ED8" Offset="1.00"/>
        </LinearGradientBrush>

        <!-- Realce cálido coral -> ámbar en la curva superior de la S -->
        <RadialGradientBrush x:Key="SefirosSWarmBloom" Center="0.76,0.24" GradientOrigin="0.76,0.24" RadiusX="0.54" RadiusY="0.44">
            <GradientStop Color="#FFF43F5E" Offset="0.00"/>
            <GradientStop Color="#E8F97316" Offset="0.36"/>
            <GradientStop Color="#BBF59E0B" Offset="0.66"/>
            <GradientStop Color="#00F59E0B" Offset="1.00"/>
        </RadialGradientBrush>

        <!-- Cometa luminoso de alto contraste sobre la S -->
        <RadialGradientBrush x:Key="CometHaloBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#FFFFFFFF" Offset="0.00"/>
            <GradientStop Color="#EEBAE6FD" Offset="0.28"/>
            <GradientStop Color="#CC0EA5E9" Offset="0.58"/>
            <GradientStop Color="#66FBBF24" Offset="0.78"/>
            <GradientStop Color="#0038BDF8" Offset="1.00"/>
        </RadialGradientBrush>

        <!-- Halo y relleno cristalino nítido para la estrella al final de la S -->
        <RadialGradientBrush x:Key="EndStarHaloBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#FFFFFFFF" Offset="0.00"/>
            <GradientStop Color="#DD38BDF8" Offset="0.34"/>
            <GradientStop Color="#99F59E0B" Offset="0.66"/>
            <GradientStop Color="#002563EB" Offset="1.00"/>
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="EndStarCoreBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0.00"/>
            <GradientStop Color="#BAE6FD" Offset="0.48"/>
            <GradientStop Color="#FBBF24" Offset="1.00"/>
        </LinearGradientBrush>

        <!-- Barra superior e indicador de progreso Tema Sefiros -->
        <LinearGradientBrush x:Key="SefirosFourColorBar" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#2563EB" Offset="0.00"/>
            <GradientStop Color="#0E9F6E" Offset="0.34"/>
            <GradientStop Color="#D97706" Offset="0.68"/>
            <GradientStop Color="#E11D48" Offset="1.00"/>
        </LinearGradientBrush>

        <!-- Paletas luminosas para las estrellas astroide Gemini alrededor -->
        <LinearGradientBrush x:Key="GeminiBlueCyanBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38BDF8" Offset="0.00"/>
            <GradientStop Color="#2563EB" Offset="0.52"/>
            <GradientStop Color="#6366F1" Offset="1.00"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GeminiEmeraldCyanBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10B981" Offset="0.00"/>
            <GradientStop Color="#0EA5E9" Offset="0.55"/>
            <GradientStop Color="#2563EB" Offset="1.00"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GeminiGoldCoralBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F59E0B" Offset="0.00"/>
            <GradientStop Color="#F97316" Offset="0.52"/>
            <GradientStop Color="#E11D48" Offset="1.00"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GeminiCyanGlowBrush" StartPoint="0.1,0" EndPoint="0.9,1">
            <GradientStop Color="#0EA5E9" Offset="0.00"/>
            <GradientStop Color="#6366F1" Offset="1.00"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid x:Name="RootStage" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="RootTranslate" X="0" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Sombra aislada sin hijos para preservar texto ClearType 100% nítido -->
        <Border Margin="24"
                CornerRadius="28"
                Background="{DynamicResource CardBgBrush}"
                IsHitTestVisible="False"
                Effect="{StaticResource ModalCardShadow}"/>

        <!-- Tarjeta nítida de presentación -->
        <Border x:Name="CardRoot"
                Margin="24"
                CornerRadius="28"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                RenderOptions.ClearTypeHint="Enabled"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filete superior progresivo de 4 colores sin desbordar las esquinas redondeadas -->
                <Border x:Name="TopAccentBar"
                        Grid.Row="0"
                        Height="3.5"
                        Margin="22,0,22,0"
                        CornerRadius="2"
                        Background="{StaticResource SefirosFourColorBar}"
                        RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="TopAccentScale" ScaleX="0" ScaleY="1"/>
                    </Border.RenderTransform>
                </Border>

                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="28,18,28,22">

                    <!-- Escenario central ampliado: Aura prismática + Squircle + Cometa S + Estrella final + Estrellas Gemini -->
                    <Canvas x:Name="EmblemStage"
                            Width="340"
                            Height="214"
                            HorizontalAlignment="Center">

                        <!-- Aura prismática vectorial girando detrás del squircle -->
                        <Grid x:Name="PrismAura"
                              Width="244"
                              Height="244"
                              Canvas.Left="48"
                              Canvas.Top="-15"
                              Opacity="0"
                              IsHitTestVisible="False"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PrismScale" ScaleX="0.76" ScaleY="0.76"/>
                                    <RotateTransform x:Name="PrismRotate" Angle="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <Ellipse Width="158" Height="158" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#8822C55E" Offset="0.0"/>
                                        <GradientStop Color="#3322C55E" Offset="0.52"/>
                                        <GradientStop Color="#0022C55E" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="158" Height="158" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#8CF43F5E" Offset="0.0"/>
                                        <GradientStop Color="#36F43F5E" Offset="0.52"/>
                                        <GradientStop Color="#00F43F5E" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="158" Height="158" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#8C2563EB" Offset="0.0"/>
                                        <GradientStop Color="#362563EB" Offset="0.52"/>
                                        <GradientStop Color="#002563EB" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="158" Height="158" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#82F59E0B" Offset="0.0"/>
                                        <GradientStop Color="#33F59E0B" Offset="0.52"/>
                                        <GradientStop Color="#00F59E0B" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <!-- Insignia squircle ampliada -->
                        <Border x:Name="SquircleBadge"
                                Width="156"
                                Height="156"
                                Canvas.Left="92"
                                Canvas.Top="29"
                                CornerRadius="38"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1.5"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="SquircleScale" ScaleX="0.86" ScaleY="0.86"/>
                            </Border.RenderTransform>

                            <Viewbox Width="146" Height="146" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="120" Height="120" ClipToBounds="False">
                                    <!-- Guía tenue estructural -->
                                    <Path x:Name="PathSGuide"
                                          Data="{StaticResource SefirosSPathGeometry}"
                                          Stroke="#1664748B"
                                          StrokeThickness="20"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Opacity="0"/>

                                    <!-- Halo vectorial exterior -->
                                    <Path x:Name="PathSGlowOuter"
                                          Data="{StaticResource SefirosSPathGeometry}"
                                          Stroke="{StaticResource SefirosSLogoGradient}"
                                          StrokeThickness="28"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Opacity="0"/>

                                    <!-- Halo vectorial interior -->
                                    <Path x:Name="PathSGlowInner"
                                          Data="{StaticResource SefirosSPathGeometry}"
                                          Stroke="{StaticResource SefirosSLogoGradient}"
                                          StrokeThickness="24"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Opacity="0"/>

                                    <!-- Trazo principal S dibujado progresivamente estilo Google "G" -->
                                    <Path x:Name="PathSStroke"
                                          Data="{StaticResource SefirosSPathGeometry}"
                                          Stroke="{StaticResource SefirosSLogoGradient}"
                                          StrokeThickness="20"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Opacity="0"/>

                                    <!-- Capa cálida coral-ámbar sincronizada con el trazo principal -->
                                    <Path x:Name="PathSWarmBloom"
                                          Data="{StaticResource SefirosSPathGeometry}"
                                          Stroke="{StaticResource SefirosSWarmBloom}"
                                          StrokeThickness="20"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Opacity="0"/>

                                    <!-- Destello especular visible recorriendo la letra S completada -->
                                    <Path x:Name="PathSSheen"
                                          Data="{StaticResource SefirosSPathGeometry}"
                                          Stroke="#F2FFFFFF"
                                          StrokeThickness="8.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Opacity="0"/>

                                    <!-- Cometa luminoso recorriendo la punta de la S durante el trazo -->
                                    <Grid x:Name="CometTip"
                                          Width="38"
                                          Height="38"
                                          Margin="-19,-19,0,0"
                                          Opacity="0"
                                          IsHitTestVisible="False">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="CometTranslate" X="85" Y="32"/>
                                        </Grid.RenderTransform>
                                        <Ellipse Width="38" Height="38" Fill="{StaticResource CometHaloBrush}"/>
                                        <Ellipse Width="11" Height="11" Fill="#FFFFFFFF"/>
                                    </Grid>

                                    <!-- Estrella protagonista en la punta final (34, 87) cuando termina de cargar la S -->
                                    <Grid x:Name="EndStarGroup"
                                          Canvas.Left="34"
                                          Canvas.Top="87"
                                          Width="76"
                                          Height="76"
                                          Margin="-38,-38,0,0"
                                          Opacity="0"
                                          IsHitTestVisible="False"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Ellipse x:Name="StarRipple"
                                                 Width="36"
                                                 Height="36"
                                                 Stroke="#C838BDF8"
                                                 StrokeThickness="2"
                                                 Opacity="0"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="StarRippleScale" ScaleX="0.2" ScaleY="0.2"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>

                                        <Ellipse x:Name="StarHalo"
                                                 Width="68"
                                                 Height="68"
                                                 Fill="{StaticResource EndStarHaloBrush}"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="StarHaloScale" ScaleX="0.25" ScaleY="0.25"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>

                                        <Path x:Name="StarCross"
                                              Width="54"
                                              Height="54"
                                              Stretch="Uniform"
                                              Fill="#F4FFFFFF"
                                              Data="M 28,0 L 29.6,26.4 L 56,28 L 29.6,29.6 L 28,56 L 26.4,29.6 L 0,28 L 26.4,26.4 Z"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="0.15" ScaleY="0.15"/>
                                                    <RotateTransform Angle="0"/>
                                                </TransformGroup>
                                            </Path.RenderTransform>
                                        </Path>

                                        <Path x:Name="StarAstroid"
                                              Width="42"
                                              Height="42"
                                              Stretch="Uniform"
                                              Fill="{StaticResource EndStarCoreBrush}"
                                              Stroke="#667DD3FC"
                                              StrokeThickness="0.6"
                                              Data="M 24,0 C 25.4,15 33,22.6 48,24 C 33,25.4 25.4,33 24,48 C 22.6,33 15,25.4 0,24 C 15,22.6 22.6,15 24,0 Z"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="0.15" ScaleY="0.15"/>
                                                    <RotateTransform Angle="-24"/>
                                                </TransformGroup>
                                            </Path.RenderTransform>
                                        </Path>

                                        <Ellipse Width="9" Height="9" Fill="#FFFFFFFF"/>
                                    </Grid>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- ALA DERECHA: estrellas astroide Gemini alrededor del emblema -->
                        <Path x:Name="SparkleGemini1"
                              Data="{StaticResource GeminiSparkleGeometry}"
                              Fill="{StaticResource GeminiBlueCyanBrush}"
                              Width="38"
                              Height="38"
                              Stretch="Uniform"
                              Canvas.Left="264"
                              Canvas.Top="20"
                              Opacity="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0" ScaleY="0"/>
                                    <RotateTransform Angle="-24"/>
                                    <TranslateTransform X="-10" Y="6"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>

                        <Path x:Name="SparkleGemini2"
                              Data="{StaticResource GeminiSparkleGeometry}"
                              Fill="{StaticResource GeminiGoldCoralBrush}"
                              Width="26"
                              Height="26"
                              Stretch="Uniform"
                              Canvas.Left="280"
                              Canvas.Top="100"
                              Opacity="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0" ScaleY="0"/>
                                    <RotateTransform Angle="22"/>
                                    <TranslateTransform X="-10" Y="0"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>

                        <Path x:Name="SparkleGemini3"
                              Data="{StaticResource GeminiSparkleGeometry}"
                              Fill="{StaticResource GeminiCyanGlowBrush}"
                              Width="18"
                              Height="18"
                              Stretch="Uniform"
                              Canvas.Left="258"
                              Canvas.Top="164"
                              Opacity="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0" ScaleY="0"/>
                                    <RotateTransform Angle="-20"/>
                                    <TranslateTransform X="-8" Y="-6"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>

                        <!-- ALA IZQUIERDA: estrellas astroide Gemini alrededor del emblema -->
                        <Path x:Name="SparkleGemini4"
                              Data="{StaticResource GeminiSparkleGeometry}"
                              Fill="{StaticResource GeminiEmeraldCyanBrush}"
                              Width="34"
                              Height="34"
                              Stretch="Uniform"
                              Canvas.Left="40"
                              Canvas.Top="142"
                              Opacity="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0" ScaleY="0"/>
                                    <RotateTransform Angle="24"/>
                                    <TranslateTransform X="10" Y="-6"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>

                        <Path x:Name="SparkleGemini5"
                              Data="{StaticResource GeminiSparkleGeometry}"
                              Fill="{StaticResource GeminiGoldCoralBrush}"
                              Width="24"
                              Height="24"
                              Stretch="Uniform"
                              Canvas.Left="36"
                              Canvas.Top="62"
                              Opacity="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0" ScaleY="0"/>
                                    <RotateTransform Angle="-22"/>
                                    <TranslateTransform X="10" Y="2"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>

                        <Path x:Name="SparkleGemini6"
                              Data="{StaticResource GeminiSparkleGeometry}"
                              Fill="{StaticResource GeminiBlueCyanBrush}"
                              Width="18"
                              Height="18"
                              Stretch="Uniform"
                              Canvas.Left="62"
                              Canvas.Top="20"
                              Opacity="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0" ScaleY="0"/>
                                    <RotateTransform Angle="18"/>
                                    <TranslateTransform X="8" Y="6"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>

                    <!-- Nombre y subtítulo -->
                    <TextBlock x:Name="TxtSplashTitle"
                               Text="Sefiros POS"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TitleTranslate" X="0" Y="10"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <TextBlock x:Name="TxtSplashSubtitle"
                               Text="Sistema de Gestión Comercial · .NET 10"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"
                               Opacity="0"/>

                    <!-- Barra de progreso inferior -->
                    <Border Width="186"
                            Height="4"
                            Margin="0,20,0,0"
                            CornerRadius="2"
                            Background="{DynamicResource SurfaceAltBrush}"
                            ClipToBounds="True"
                            HorizontalAlignment="Center">
                        <Border x:Name="ProgressFill"
                                Height="4"
                                Background="{StaticResource SefirosFourColorBar}"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>

                    <TextBlock Text="{DynamicResource Str_Splash_Subtitle}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Opacity="0.72"
                               HorizontalAlignment="Center"
                               Margin="0,11,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
