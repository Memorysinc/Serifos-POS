<Window x:Class="FirewallControl.App.Views.CommercialOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operaciones Comerciales, Devoluciones, Cuentas y Créditos"
        Width="1240" Height="760"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ScreenBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <StackPanel>
                <TextBlock Text="OPERACIONES COMERCIALES Y CARTERA" Style="{StaticResource EyebrowLabelStyle}"/>
                <TextBlock Text="Pedidos, Presupuestos, Devoluciones, Cuentas, Morosos y Solicitudes de Crédito" Style="{StaticResource PageTitleStyle}" FontSize="21" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="18,12,18,10">
            <!-- TAB 0: PEDIDOS DE COMPRA -->
            <TabItem Header="📋  Pedidos de Compra">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.45*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Pedidos Registrados" Style="{StaticResource SectionTitleStyle}"/>
                                <Button Content="🔄" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,3" Click="BtnReloadAll_Click"/>
                            </DockPanel>
                            <DataGrid x:Name="GridPedidos" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NRO" Binding="{Binding NroPedido}" Width="55"/>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding FechaPedido, StringFormat=dd/MM/yyyy}" Width="88"/>
                                    <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding DesProveedor}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalPedido, StringFormat=N0}" Width="95" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Nuevo Pedido de Compra (crear_pedidos)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <Border Grid.Row="1" Style="{StaticResource SoftPanelStyle}" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Proveedor" Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox x:Name="CmbPedProveedor" DisplayMemberPath="Descripcion" SelectedValuePath="IdProveedor" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Depósito" Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox x:Name="CmbPedDeposito" DisplayMemberPath="Descripcion" SelectedValuePath="IdDeposito" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Nro. Ref / Factura" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="TxtPedRef" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="115"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtPedProdCod" Grid.Column="0" KeyDown="TxtPedProdCod_KeyDown" ToolTip="Código + Enter"/>
                                        <TextBox x:Name="TxtPedProdDesc" Grid.Column="2" IsReadOnly="True" Background="{DynamicResource InputReadOnlyBgBrush}"/>
                                        <TextBox x:Name="TxtPedProdCant" Grid.Column="4" Text="1" ToolTip="Cantidad"/>
                                        <TextBox x:Name="TxtPedProdCosto" Grid.Column="6" Text="0" ToolTip="Costo Unitario"/>
                                        <Button Grid.Column="8" Content="+ Agregar" Style="{StaticResource PrimaryButtonStyle}" Click="BtnPedAddItem_Click" Padding="12,5"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="GridPedItems" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="100"/>
                                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                                    <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad, StringFormat=N2}" Width="75"/>
                                    <DataGridTextColumn Header="UNITARIO" Binding="{Binding PreUnitario, StringFormat=N0}" Width="95"/>
                                    <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat=N0}" Width="105" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Grid.Row="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Observación:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtPedObs" Width="210" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="LblPedTotal" Text="Total: 0 Gs." FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryDarkBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Quitar Ítem" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnPedRemoveItem_Click" Margin="0,0,8,0"/>
                                    <Button Content="💾 Guardar Pedido" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarPedido_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 1: PRESUPUESTOS -->
            <TabItem Header="🧾  Presupuestos (crear_presupuestos)">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.45*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="TxtPreSearch" Width="200" Margin="0,0,8,0"/>
                                <Button Content="🔍" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSearchPre_Click" Padding="10,4"/>
                            </StackPanel>
                            <DataGrid x:Name="GridPresupuestos" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      SelectionChanged="GridPresupuestos_SelectionChanged" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NRO" Binding="{Binding NroPresupuesto}" Width="55" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding FechaPresupuesto, StringFormat=dd/MM/yyyy}" Width="88"/>
                                    <DataGridTextColumn Header="CLIENTE" Binding="{Binding NombreCliente}" Width="*"/>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalPresupuesto, StringFormat=N0}" Width="95" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock x:Name="LblPreHeader" Text="Nuevo Presupuesto" Style="{StaticResource SectionTitleStyle}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Nuevo" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoPre_Click" Padding="10,4" Margin="0,0,6,0"/>
                                    <Button Content="Eliminar" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnEliminarPre_Click" Padding="10,4"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" Style="{StaticResource SoftPanelStyle}" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Cliente" Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox x:Name="CmbPreCliente" DisplayMemberPath="Nombres" SelectedValuePath="IdCliente" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Vendedor" Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox x:Name="CmbPreVendedor" DisplayMemberPath="Nombres" SelectedValuePath="IdVendedor" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Descuento Gs." Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="TxtPreDesc" Text="0" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="115"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtPreProdCod" Grid.Column="0" KeyDown="TxtPreProdCod_KeyDown" ToolTip="Código + Enter"/>
                                        <TextBox x:Name="TxtPreProdDesc" Grid.Column="2" IsReadOnly="True" Background="{DynamicResource InputReadOnlyBgBrush}"/>
                                        <TextBox x:Name="TxtPreProdCant" Grid.Column="4" Text="1"/>
                                        <TextBox x:Name="TxtPreProdPrec" Grid.Column="6" Text="0"/>
                                        <Button Grid.Column="8" Content="+ Ítem" Style="{StaticResource PrimaryButtonStyle}" Click="BtnPreAddItem_Click" Padding="12,5"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="GridPreItems" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="100"/>
                                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                                    <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad, StringFormat=N2}" Width="75"/>
                                    <DataGridTextColumn Header="PRECIO" Binding="{Binding PreUnitario, StringFormat=N0}" Width="95"/>
                                    <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat=N0}" Width="105" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Grid.Row="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TxtPreObs" Width="180" ToolTip="Observación" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="LblPreTotal" Text="Total: 0 Gs." FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryDarkBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Quitar Ítem" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnPreRemoveItem_Click" Margin="0,0,8,0"/>
                                    <Button Content="💾 Guardar Presupuesto" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarPre_Click" Margin="0,0,8,0"/>
                                    <Button Content="🛒 Enviar a Caja 1 (POS)" Style="{StaticResource PrimaryButtonStyle}" Click="BtnEnviarPrePos_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: DEVOLUCIÓN VENTAS -->
            <TabItem Header="↩️  Devolución Ventas">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Historial Devoluciones de Venta" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="GridDevVentasHist" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding IdDevolucion}" Width="50"/>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding FechaDevolucion, StringFormat=dd/MM/yyyy}" Width="88"/>
                                    <DataGridTextColumn Header="CLIENTE" Binding="{Binding DesTercero}" Width="*"/>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=N0}" Width="95" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="10" Margin="0,0,0,10">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="Nro. Venta / Ticket:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtDvNroVenta" Width="100" Margin="0,0,8,0"/>
                                    <Button Content="🔍 Cargar Venta" Style="{StaticResource PrimaryButtonStyle}" Click="BtnDvCargarVenta_Click" Padding="12,5" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="LblDvCliente" Text="Cliente: -" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </WrapPanel>
                            </Border>

                            <DataGrid x:Name="GridDvItems" Grid.Row="1" AutoGenerateColumns="False" SelectionMode="Single" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" IsReadOnly="True" Width="100"/>
                                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" IsReadOnly="True" Width="*"/>
                                    <DataGridTextColumn Header="CANT. DEV." Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                    <DataGridTextColumn Header="PRECIO" Binding="{Binding PreUnitario, StringFormat=N0}" IsReadOnly="True" Width="95"/>
                                    <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat=N0}" IsReadOnly="True" Width="105" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Grid.Row="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Motivo:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtDvMotivo" Width="220" Text="DEVOLUCIÓN DE MERCADERÍA" Margin="0,0,10,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Quitar Línea" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnDvQuitar_Click" Margin="0,0,8,0"/>
                                    <Button Content="✔ Procesar Devolución (+Stock)" Style="{StaticResource SuccessButtonStyle}" Click="BtnDvProcesar_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: DEVOLUCIÓN COMPRAS -->
            <TabItem Header="📦  Devolución Compras">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Historial Devoluciones de Compra" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="GridDevComprasHist" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding IdDevolucion}" Width="50"/>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding FechaDevolucion, StringFormat=dd/MM/yyyy}" Width="88"/>
                                    <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding DesTercero}" Width="*"/>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=N0}" Width="95" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource SoftPanelStyle}" Padding="10" Margin="0,0,0,10">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="Compra Reciente:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbDcCompras" Width="280" Margin="0,0,8,0"/>
                                    <Button Content="🔍 Cargar Compra" Style="{StaticResource PrimaryButtonStyle}" Click="BtnDcCargar_Click" Padding="12,5"/>
                                </WrapPanel>
                            </Border>

                            <DataGrid x:Name="GridDcItems" Grid.Row="1" AutoGenerateColumns="False" SelectionMode="Single" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" IsReadOnly="True" Width="100"/>
                                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" IsReadOnly="True" Width="*"/>
                                    <DataGridTextColumn Header="CANT. DEV." Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                    <DataGridTextColumn Header="COSTO" Binding="{Binding PreUnitario, StringFormat=N0}" IsReadOnly="True" Width="95"/>
                                    <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat=N0}" IsReadOnly="True" Width="105" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Grid.Row="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Motivo:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtDcMotivo" Width="220" Text="DEVOLUCIÓN A PROVEEDOR" Margin="0,0,10,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Quitar Línea" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnDcQuitar_Click" Margin="0,0,8,0"/>
                                    <Button Content="✔ Procesar Devolución (-Stock)" Style="{StaticResource SuccessButtonStyle}" Click="BtnDcProcesar_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: PAGOS A PROVEEDORES Y CUENTAS A PAGAR -->
            <TabItem Header="💸  Pagos Proveedores / Cuentas Pagar">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1.1*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="0.9*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Deudas Pendientes con Proveedores" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                            <DataGrid x:Name="GridDeudasProv" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      SelectionChanged="GridDeudasProv_SelectionChanged" Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding DesProveedor}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="FACTURA" Binding="{Binding NroFactura}" Width="95"/>
                                    <DataGridTextColumn Header="CUOTA" Binding="{Binding Cuota}" Width="55"/>
                                    <DataGridTextColumn Header="VENC." Binding="{Binding Vencimiento, StringFormat=dd/MM/yy}" Width="75"/>
                                    <DataGridTextColumn Header="SALDO" Binding="{Binding Saldo, StringFormat=N0}" Width="95" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Style="{StaticResource SoftPanelStyle}" Padding="8" Margin="0,0,0,8">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="Monto:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="TxtPagProvMonto" Width="105" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <TextBlock Text="Caja:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="CmbPagProvCaja" Width="115" DisplayMemberPath="Descripcion" SelectedValuePath="IdCaja" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtPagProvObs" Width="130" ToolTip="Observación" Margin="0,0,8,0"/>
                                    <Button Content="✔ Registrar Pago" Style="{StaticResource SuccessButtonStyle}" Click="BtnPagarProveedor_Click" Padding="10,5"/>
                                </WrapPanel>
                            </Border>
                            <DataGrid x:Name="GridPagosProv" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding FechaPago, StringFormat=dd/MM/yyyy}" Width="85"/>
                                    <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding DesProveedor}" Width="*"/>
                                    <DataGridTextColumn Header="PAGO" Binding="{Binding Pago, StringFormat=N0}" Width="95" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="OBS" Binding="{Binding Obs}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Pagarés / Cuentas a Pagar (cuentapagar)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                            <DataGrid x:Name="GridCuentasPagar" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PAGARÉ" Binding="{Binding NroPagare}" Width="65"/>
                                    <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding DesProveedor}" Width="*"/>
                                    <DataGridTextColumn Header="VENC." Binding="{Binding Vencimiento, StringFormat=dd/MM/yy}" Width="75"/>
                                    <DataGridTextColumn Header="SALDO" Binding="{Binding Saldo, StringFormat=N0}" Width="95" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbCpProv" Grid.Column="0" DisplayMemberPath="Descripcion" SelectedValuePath="IdProveedor"/>
                                    <TextBox x:Name="TxtCpPagare" Grid.Column="2" Text="1" ToolTip="Nro Pagaré"/>
                                    <TextBox x:Name="TxtCpFactura" Grid.Column="4" ToolTip="Nro Factura"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCpTotal" Grid.Column="0" Text="0" ToolTip="Total Gs."/>
                                    <DatePicker x:Name="DpCpVenc" Grid.Column="2"/>
                                    <Button Grid.Column="4" Content="+ Cuenta Pagar" Style="{StaticResource PrimaryButtonStyle}" Click="BtnGuardarCuentaPagar_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: CUOTAS, MOROSOS Y CUENTAS A RECIBIR -->
            <TabItem Header="📅  Cuotas, Morosos y Cuentas a Recibir">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.15*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="0.85*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource AtelierCardStyle}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
                                <TextBlock Text="Cuotas Pendientes y Control de Morosos:" Style="{StaticResource SectionTitleStyle}" Margin="0,0,14,0"/>
                                <CheckBox x:Name="ChkSoloMorosos" Content="Solo Vencidas / Morosos" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtCuotaSearch" Width="180" Margin="0,0,8,0"/>
                                <Button Content="🔍 Filtrar" Style="{StaticResource PrimaryButtonStyle}" Click="BtnFiltrarCuotas_Click" Padding="10,4"/>
                            </WrapPanel>
                            <DataGrid x:Name="GridCuotas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      SelectionChanged="GridCuotas_SelectionChanged" Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="VENTA" Binding="{Binding NroVenta}" Width="65"/>
                                    <DataGridTextColumn Header="CLIENTE" Binding="{Binding DesCliente}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="105"/>
                                    <DataGridTextColumn Header="CUOTA" Binding="{Binding Cuota}" Width="55"/>
                                    <DataGridTextColumn Header="VENCIMIENTO" Binding="{Binding Vencimiento, StringFormat=dd/MM/yyyy}" Width="92"/>
                                    <DataGridTextColumn Header="MORA (d)" Binding="{Binding DiasMora}" Width="65"/>
                                    <DataGridTextColumn Header="SALDO" Binding="{Binding Saldo, StringFormat=N0}" Width="100" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="INT. EST." Binding="{Binding InteresMora, StringFormat=N0}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="2" VerticalAlignment="Center">
                                <TextBlock Text="Importe a Cobrar:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtCuotaEntrega" Width="120" FontWeight="Bold" Margin="0,0,10,0"/>
                                <TextBlock Text="Caja:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbCuotaCaja" Width="130" DisplayMemberPath="Descripcion" SelectedValuePath="IdCaja" Margin="0,0,10,0"/>
                                <Button Content="💵 Registrar Cobro de Cuota" Style="{StaticResource SuccessButtonStyle}" Click="BtnCobrarCuota_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource AtelierCardStyle}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="Pagarés / Cuentas a Recibir (cuentarecibir)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                                <DataGrid x:Name="GridCuentasRecibir" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PAGARÉ" Binding="{Binding NroPagare}" Width="65"/>
                                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding DesCliente}" Width="*"/>
                                        <DataGridTextColumn Header="VENC." Binding="{Binding Vencimiento, StringFormat=dd/MM/yy}" Width="80"/>
                                        <DataGridTextColumn Header="SALDO" Binding="{Binding Saldo, StringFormat=N0}" Width="100" FontWeight="Bold"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nueva Cuenta a Recibir" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbCrCliente" DisplayMemberPath="Nombres" SelectedValuePath="IdCliente" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCrPagare" Grid.Column="0" Text="1" ToolTip="Nro Pagaré"/>
                                    <TextBox x:Name="TxtCrTotal" Grid.Column="2" Text="0" ToolTip="Total Gs."/>
                                    <DatePicker x:Name="DpCrVenc" Grid.Column="4"/>
                                </Grid>
                                <Button Content="+ Guardar Cuenta a Recibir" Style="{StaticResource PrimaryButtonStyle}" Click="BtnGuardarCuentaRecibir_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 6: SOLICITUD DE CRÉDITO & HOJA IMPRIMIBLE -->
            <TabItem Header="📄  Solicitud de Crédito">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AtelierCardStyle}" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <ComboBox x:Name="CmbSolEstadoFilter" Width="150" SelectedIndex="0" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Todas"/>
                                    <ComboBoxItem Content="Pendientes"/>
                                    <ComboBoxItem Content="Aprobadas"/>
                                    <ComboBoxItem Content="Rechazadas"/>
                                </ComboBox>
                                <Button Content="🔍 Filtrar" Style="{StaticResource SecondaryButtonStyle}" Click="BtnFiltrarSol_Click" Margin="0,0,8,0"/>
                                <Button Content="🖨 Imprimir Hoja Solicitud" Style="{StaticResource PrimaryButtonStyle}" Click="BtnImprimirSolicitud_Click"/>
                            </StackPanel>
                            <DataGrid x:Name="GridSolicitudes" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      SelectionChanged="GridSolicitudes_SelectionChanged" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding IdSolicitud}" Width="48"/>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding FechaIngreso, StringFormat=dd/MM/yy}" Width="75"/>
                                    <DataGridTextColumn Header="CLIENTE" Binding="{Binding DesCliente}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="MONTO" Binding="{Binding Monto, StringFormat=N0}" Width="95"/>
                                    <DataGridTextColumn Header="CUOTAS" Binding="{Binding Plazo}" Width="60"/>
                                    <DataGridTextColumn Header="ESTADO" Binding="{Binding EstadoDisplay}" Width="95" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AtelierCardStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Ficha de Solicitud de Crédito" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <TextBlock Text="Cliente" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CmbSolCliente" DisplayMemberPath="Nombres" SelectedValuePath="IdCliente" Margin="0,2,0,8"/>
                            <TextBlock Text="Vendedor" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CmbSolVendedor" DisplayMemberPath="Nombres" SelectedValuePath="IdVendedor" Margin="0,2,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Monto Gs." Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtSolMonto" Text="0" TextChanged="SolCalcChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Plazo" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtSolPlazo" Text="6" TextChanged="SolCalcChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Cuota Estim." Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtSolCuota" IsReadOnly="True" Background="{DynamicResource InputReadOnlyBgBrush}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Referencia Bancaria / Entidad" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSolBanco" Margin="0,2,0,8"/>
                            <TextBlock Text="Observaciones" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtSolObs" Height="50" TextWrapping="Wrap" Margin="0,2,0,10"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="Nueva" Style="{StaticResource SecondaryButtonStyle}" Click="BtnNuevoSol_Click" Margin="0,0,8,0"/>
                                <Button Content="💾 Guardar Solicitud" Style="{StaticResource SuccessButtonStyle}" Click="BtnGuardarSol_Click"/>
                            </WrapPanel>

                            <Border x:Name="PanelSolAdmin" Style="{StaticResource SoftPanelStyle}" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Resolución Administrativa" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSolObsEstado" ToolTip="Observación de aprobación/rechazo" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="✔ Aprobar" Style="{StaticResource SuccessButtonStyle}" Click="BtnAprobarSol_Click" Margin="0,0,8,0"/>
                                        <Button Content="✕ Rechazar" Style="{StaticResource SoftDangerButtonStyle}" Click="BtnRechazarSol_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource StatusBarStyle}">
            <TextBlock x:Name="LblStatus" Text="Listo." Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
