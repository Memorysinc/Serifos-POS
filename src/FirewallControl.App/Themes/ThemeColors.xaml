<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Default Theme Tokens: Neutro Carbón (overwritten dynamically by ThemeService.ApplyTheme) -->
    <Color x:Key="PrimaryColor">#6F6A64</Color>
    <Color x:Key="PrimaryLightColor">#A7A19A</Color>
    <Color x:Key="PrimaryDarkColor">#1F1C1A</Color>
    <Color x:Key="ScreenBgColor">#F8F7F5</Color>
    <Color x:Key="CardBgColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#EFEDEA</Color>
    <Color x:Key="SurfaceAccentColor">#E3DFDA</Color>
    <Color x:Key="CardBorderColor">#DED9D3</Color>
    <Color x:Key="DividerColor">#E7E3DE</Color>
    <Color x:Key="TextPrimaryColor">#1F1C1A</Color>
    <Color x:Key="TextSecondaryColor">#5C5652</Color>
    <Color x:Key="TextMutedColor">#8A837C</Color>
    <Color x:Key="TextInverseColor">#FAF8F5</Color>

    <Color x:Key="ButtonPrimaryBgColor">#1F1C1A</Color>
    <Color x:Key="ButtonPrimaryHoverBgColor">#6F6A64</Color>
    <Color x:Key="ButtonPrimaryPressedBgColor">#141210</Color>
    <Color x:Key="ButtonSecondaryBgColor">#FFFFFF</Color>
    <Color x:Key="ButtonSecondaryHoverBgColor">#EFEDEA</Color>
    <Color x:Key="ButtonSecondaryPressedBgColor">#E3DFDA</Color>

    <Color x:Key="InputBgColor">#FCFBF9</Color>
    <Color x:Key="InputReadOnlyBgColor">#EFEDEA</Color>
    <Color x:Key="InputBorderColor">#DED9D3</Color>
    <Color x:Key="InputFocusBorderColor">#6F6A64</Color>

    <Color x:Key="KpiAccentBgColor">#1F1C1A</Color>
    <Color x:Key="KpiAccentTextColor">#F8F4EF</Color>
    <Color x:Key="KpiAccentValueColor">#EAE6E0</Color>

    <Color x:Key="DataGridAltRowColor">#F9F8F6</Color>
    <Color x:Key="DataGridSelectedBgColor">#E3DFDA</Color>
    <Color x:Key="DataGridSelectedFgColor">#1F1C1A</Color>
    <Color x:Key="DataGridHoverBgColor">#EFEDEA</Color>

    <Color x:Key="SuccessBgColor">#ECFDF5</Color>
    <Color x:Key="SuccessTextColor">#15803D</Color>
    <Color x:Key="SuccessBorderColor">#A7F3D0</Color>
    <Color x:Key="SuccessSolidBgColor">#16A34A</Color>
    <Color x:Key="SuccessSolidHoverBgColor">#15803D</Color>

    <Color x:Key="WarningBgColor">#FFFBEB</Color>
    <Color x:Key="WarningTextColor">#B45309</Color>
    <Color x:Key="WarningBorderColor">#FDE68A</Color>

    <Color x:Key="DangerBgColor">#FEF2F2</Color>
    <Color x:Key="DangerTextColor">#DC2626</Color>
    <Color x:Key="DangerBorderColor">#FECACA</Color>
    <Color x:Key="DangerSolidBgColor">#DC2626</Color>
    <Color x:Key="DangerSolidHoverBgColor">#B91C1C</Color>

    <Color x:Key="InfoBgColor">#EFF6FF</Color>
    <Color x:Key="InfoTextColor">#1D4ED8</Color>
    <Color x:Key="InfoBorderColor">#BFDBFE</Color>

    <Color x:Key="ShadowColorColor">#1F1C1A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="ScreenBgBrush" Color="{StaticResource ScreenBgColor}"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceAccentBrush" Color="{StaticResource SurfaceAccentColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverseColor}"/>

    <SolidColorBrush x:Key="ButtonPrimaryBgBrush" Color="{StaticResource ButtonPrimaryBgColor}"/>
    <SolidColorBrush x:Key="ButtonPrimaryHoverBgBrush" Color="{StaticResource ButtonPrimaryHoverBgColor}"/>
    <SolidColorBrush x:Key="ButtonPrimaryPressedBgBrush" Color="{StaticResource ButtonPrimaryPressedBgColor}"/>
    <SolidColorBrush x:Key="ButtonSecondaryBgBrush" Color="{StaticResource ButtonSecondaryBgColor}"/>
    <SolidColorBrush x:Key="ButtonSecondaryHoverBgBrush" Color="{StaticResource ButtonSecondaryHoverBgColor}"/>
    <SolidColorBrush x:Key="ButtonSecondaryPressedBgBrush" Color="{StaticResource ButtonSecondaryPressedBgColor}"/>

    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="InputReadOnlyBgBrush" Color="{StaticResource InputReadOnlyBgColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource InputFocusBorderColor}"/>

    <SolidColorBrush x:Key="KpiAccentBgBrush" Color="{StaticResource KpiAccentBgColor}"/>
    <SolidColorBrush x:Key="KpiAccentTextBrush" Color="{StaticResource KpiAccentTextColor}"/>
    <SolidColorBrush x:Key="KpiAccentValueBrush" Color="{StaticResource KpiAccentValueColor}"/>

    <SolidColorBrush x:Key="DataGridAltRowBrush" Color="{StaticResource DataGridAltRowColor}"/>
    <SolidColorBrush x:Key="DataGridSelectedBgBrush" Color="{StaticResource DataGridSelectedBgColor}"/>
    <SolidColorBrush x:Key="DataGridSelectedFgBrush" Color="{StaticResource DataGridSelectedFgColor}"/>
    <SolidColorBrush x:Key="DataGridHoverBgBrush" Color="{StaticResource DataGridHoverBgColor}"/>

    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="{StaticResource SuccessBorderColor}"/>
    <SolidColorBrush x:Key="SuccessSolidBgBrush" Color="{StaticResource SuccessSolidBgColor}"/>
    <SolidColorBrush x:Key="SuccessSolidHoverBgBrush" Color="{StaticResource SuccessSolidHoverBgColor}"/>

    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}"/>

    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}"/>
    <SolidColorBrush x:Key="DangerSolidBgBrush" Color="{StaticResource DangerSolidBgColor}"/>
    <SolidColorBrush x:Key="DangerSolidHoverBgBrush" Color="{StaticResource DangerSolidHoverBgColor}"/>

    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}"/>
    <SolidColorBrush x:Key="InfoTextBrush" Color="{StaticResource InfoTextColor}"/>
    <SolidColorBrush x:Key="InfoBorderBrush" Color="{StaticResource InfoBorderColor}"/>

    <SolidColorBrush x:Key="ShadowColorBrush" Color="{StaticResource ShadowColorColor}"/>

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#EFEDEA" Offset="0.55"/>
        <GradientStop Color="#E3DFDA" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
